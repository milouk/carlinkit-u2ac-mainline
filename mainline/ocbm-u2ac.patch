diff --git a/baseline/common/rootfs/usr/sbin/reboot-recovery b/baseline/common/rootfs/usr/sbin/reboot-recovery
index 962ecfc..1b80b74 100755
--- a/baseline/common/rootfs/usr/sbin/reboot-recovery
+++ b/baseline/common/rootfs/usr/sbin/reboot-recovery
@@ -1,9 +1,12 @@
