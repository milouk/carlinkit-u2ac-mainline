-# reboot-recovery: set the bootstate mark and reboot, so the next boot stays in the recovery
-# initramfs (UART + NCM telnet shells, flash helpers) without needing the UART Enter window.
+# reboot-recovery: ask for ONE recovery boot and reboot, so the next boot stays in the recovery
+# initramfs (UART + NCM shells, flash helpers) without needing the UART Enter window. U2AC: a boot-slot
+# request (served once by the recovery init), not the persistent bootstate mark, so a unit with no
+# computer attached is back on the rootfs after the following reboot.
 . /lib/baseline/mtd.sh
 N=$(mtd_num bootstate) || { echo "reboot-recovery: no 'bootstate' MTD" >&2; exit 1; }
-bootstate_set "$N" || { echo "reboot-recovery: could not write the mark" >&2; exit 1; }
+bootslot_request "$N" || { echo "reboot-recovery: could not write the request" >&2; exit 1; }
+[ "$(bootslot_scan "$N" | cut -d' ' -f3)" = 1 ] || { echo "reboot-recovery: the request did not read back" >&2; exit 1; }
 sync
 reboot
diff --git a/baseline/common/shared/mtd.sh b/baseline/common/shared/mtd.sh
index 6b59c05..9291e1b 100644
--- a/baseline/common/shared/mtd.sh
+++ b/baseline/common/shared/mtd.sh
@@ -43,3 +43,78 @@ bootstate_clear() {
     [ "$(bootstate_read "$1")" = "$ERASED8_HEX" ] && return 0
     flash_eraseall -q "$MTD_DEV/mtd$1"
 }
+
+# ---- U2AC boot slots (2026-11-26): a boot-loop guard that never erases on the normal path ----
+# Slot i = 2 bytes at offset BOOTSLOT_BASE + 2*i of the bootstate MTD. NOR programs 1->0 without an erase,
+# so a normal boot costs two 1-byte writes and no 64 KiB erase (an erase stalls every rootfs read on the
+# same chip); the block is erased only when the slots are used up. Slot values:
+#   ffff unused (ends the scan)     00ff a rootfs boot attempted (recovery init, right before switch_root)
+#   0000 that boot came up (rcS marks ITS OWN slot, index handed over in /run/bootslot)
+#   55ff one recovery boot requested (reboot-recovery), not served yet
+#   5555 a recovery visit (failures or a request): resets the count, serves the request
+#   0055 the first r3 layout's served failure = a reset too; anything else (garbage from a power cut during
+#        the wrap erase) counts as a failure.
+# Policy: BOOTSLOT_MAXFAIL consecutive attempts that never came up -> one recovery boot, then attempts
+# resume (a power cut while cranking the engine costs at most one boot). A visit APPENDS 5555 and, if the
+# scan is still not clean afterwards, erases the block: recovery is never sticky.
+# The 8-byte CCPABOOT mark at offset 0 (flash-rootfs: a rootfs write in progress) keeps its meaning.
+BOOTSLOT_BASE=4096
+BOOTSLOT_N=1024
+BOOTSLOT_MAXFAIL=3
+
+# bootslot_scan N: prints "<used> <consecutive failures> <request pending 0|1>"
+bootslot_scan() {
+    _used=0; _fail=0; _req=0
+    for _s in $(hexdump -v -s "$BOOTSLOT_BASE" -n $((BOOTSLOT_N * 2)) -e '2/1 "%02x" " "' "$MTD_DEV/mtd$1" 2>/dev/null); do
+        case $_s in
+            ffff) break ;;
+            0000|0055|5555) _fail=0; _req=0 ;;
+            55ff) _fail=0; _req=1 ;;
+            *) _fail=$((_fail + 1)); _req=0 ;;
+        esac
+        _used=$((_used + 1))
+    done
+    echo "$_used $_fail $_req"
+}
+
+# bootslot_put N OFFSET BYTES [COUNT]: program COUNT (default 1) bytes given as printf escapes (\000, \125)
+bootslot_put() {
+    printf "$3" | dd of="$MTD_DEV/mtd$1" bs=1 seek="$2" count="${4:-1}" 2>/dev/null
+}
+
+# bootslot_next N: the next free slot's index in BOOTSLOT_IDX (erasing the block first when all are used)
+bootslot_next() {
+    set -- "$1" $(bootslot_scan "$1")
+    BOOTSLOT_IDX=$2
+    if [ "$BOOTSLOT_IDX" -ge "$BOOTSLOT_N" ]; then
+        flash_eraseall -q "$MTD_DEV/mtd$1" || return 1
+        BOOTSLOT_IDX=0
+    fi
+}
+
+# bootslot_attempt N: record a rootfs boot attempt (00ff); its index is left in BOOTSLOT_IDX
+bootslot_attempt() {
+    bootslot_next "$1" && bootslot_put "$1" $((BOOTSLOT_BASE + 2 * BOOTSLOT_IDX)) '\000'
+}
+
+# bootslot_ok N [INDEX]: the boot of slot INDEX came up (-> 0000); no INDEX: the last used slot
+bootslot_ok() {
+    _bi=${2:-}
+    case $_bi in
+        '' | *[!0-9]*) set -- "$1" $(bootslot_scan "$1"); [ "$2" -gt 0 ] || return 0; _bi=$(($2 - 1)) ;;
+    esac
+    bootslot_put "$1" $((BOOTSLOT_BASE + 2 * _bi + 1)) '\000'
+}
+
+# bootslot_request N: ask for ONE recovery boot (55ff). Replaces the persistent CCPABOOT mark for
+# reboot-recovery, which kept a unit without a computer in recovery on every boot.
+bootslot_request() {
+    bootslot_next "$1" && bootslot_put "$1" $((BOOTSLOT_BASE + 2 * BOOTSLOT_IDX)) '\125'
+}
+
+# bootslot_visit N: this boot is the recovery visit: append 5555; still not clean -> erase the block
+bootslot_visit() {
+    bootslot_next "$1" && bootslot_put "$1" $((BOOTSLOT_BASE + 2 * BOOTSLOT_IDX)) '\125\125' 2
+    case $(bootslot_scan "$1") in *" 0 0") return 0 ;; esac
+    flash_eraseall -q "$MTD_DEV/mtd$1"
+}
