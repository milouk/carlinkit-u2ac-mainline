diff --git a/baseline/arm-imx6ul-u2ac/board.env b/baseline/arm-imx6ul-u2ac/board.env
new file mode 100644
index 0000000..0bb981f
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/board.env
@@ -0,0 +1,77 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# CPC200-CCPA (i.MX6ULL, 128 MiB, 16 MiB QSPI NOR, vendor HAB U-Boot kept). POSIX sh. Sourced by
+# baseline/build.sh on the build host and installed as /etc/baseline/board.env in the recovery
+# initramfs and the rootfs. No unit identity in here: fuse words, MACs and serials are per unit and
+# derived at runtime (common/shared/ocbm-identity) or read from the unit's backup by the host tool.
+BOARD=arm-imx6ul-u2ac
+BOARD_NAME="U2AC AutoKit mainline i.MX6ULL"
+DTS_NAME=imx6ull-ccpa-baseline
+
+# Build host side (ignored on the unit).
+: "${CROSS_COMPILE:=arm-linux-gnu-}"       # LIVI's choice (Fedora cross gcc); any armv7 hard-float gcc
+MUSL_TARGET=arm-linux-musleabihf
+KARCH=arm
+
+# Flash facts, hardware-verified 2026-10-19 (round_trip/RUNBOOK.txt, livi_9.5.0_iw416_dryrun_report.txt).
+ERASE_SIZE=65536                 # 64 KiB erase blocks (MTD_SPI_NOR_USE_4K_SECTORS off)
+KERNEL_FLASH_OFFSET=262144       # 0x40000
+KERNEL_PART_SIZE=3407872         # 0x340000
+# 0x302fd8 is the kernel_len of the U-Boot env on the units read so far (vendor build 2025.10.15.1127).
+# It is NOT universal: build 2025.02.25.1521 reads 0x303080 and stages at partition offset 0x303080
+# (CPC200-CCPA_resources documentation/05_Security_Analysis/kernel_encryption.md). Here it is the image
+# budget (the smaller value fits both) and flash-kernel's probe offset for "something is staged"
+# (which a staging at 0x303080 still satisfies); stage_kernel.py reads each unit's own values.
+KERNEL_MAX=3157976               # 0x302fd8: what the vendor U-Boot reads (norboot), zImage+DTB cap
+STAGING_PART_OFFSET=3165176      # U2AC: staged head at kernel+0x304bf8 (this unit's kernel_len, read from its update env by stage_kernel.py 2026-11-26)
+ENV_FLASH_OFFSET=196608          # 0x30000: the U-Boot env block, our 'env' MTD
+ROOTFS_PART_SIZE=12976128        # 0xc60000
+# Revision 8: the OCBM overlay region at the END of the 'rootfs' MTD (README §2.8, §7.0e). The GPL squashfs
+# keeps [0, OVERLAY_OFFSET) (build.sh refuses a bigger rootfs.img); [OVERLAY_OFFSET, ROOTFS_PART_SIZE) holds
+# a separately built image (the OCBM daemons, not part of this GPL recipe) that `ocbm-overlay` checks by its
+# own sha256 and unpacks into RAM. A squashfs reads only up to its bytes_used and flash-rootfs writes only
+# the image's length, so neither touches the region.
+OVERLAY_OFFSET=8388608           # 0x800000 (block 128 of 198)
+OVERLAY_SIZE=4587520             # 0x460000 = ROOTFS_PART_SIZE - OVERLAY_OFFSET
+ERASED_BLOCK_SHA256=71189f7fb6aed638640078fba3a35fda6c39c8962e74dcc75935aac948da9063  # 64 KiB of 0xFF
+ERASED_HEAD_SHA256=c1f7d702a80ae5e7dc52d62ef2577cbbb25c045d6dda3a49a872130518f48cc0   # 192 KiB of 0xFF
+
+# Chip identity for ocbm-identity: OCOTP CFG0||CFG1, 8 raw bytes at nvmem offset 4.
+: "${OCBM_NVMEM:=/sys/bus/nvmem/devices/imx-ocotp0/nvmem}"
+: "${OCBM_CHIPID_OFFSET:=4}"
+: "${OCBM_CHIPID_LEN:=8}"
+
+# The UDC net-up binds: the controller behind the port the host sees (usbotg2). Matched on the
+# sysfs path, because ci_hdrc.N numbering follows probe order and changes when usbotg1 is enabled.
+NCM_UDC_MATCH=2184200.usb
+
+# LEDs from the DT (gpio-leds labels).
+LED_RED=/sys/class/leds/red
+LED_BLUE=/sys/class/leds/blue
+
+# MFi coprocessor (mfi-probe): /dev/i2c-1 = the &i2c2 controller, address 0x11.
+MFI_I2C_BUS=1
+MFI_I2C_ADDR=0x11
+# OCBM role and MFi declarations, 2026-11-02. DECLARATIVE METADATA: nothing reads these at runtime.
+# The runtime MFi selector is the CARPLAY_MFI_ADDR environment variable (unset = local /dev/i2c-1).
+OCBM_ROLES="r1 r2"          # r1 replacement-firmware box; r2 MFi peripheral for another computer (mfid, staged by hand)
+MFI_SOURCE=local-i2c        # local-i2c | remote-mfid | host-provided | none
+MFI_CHIP=2.0C               # measured on the CCPA bench unit (945 B cert, 128-byte RSA); OCBM supports MFi 2.0 through 3.0
+TARGET_TRIPLE=armv7-unknown-linux-musleabihf   # Rust target of the box daemons (build.sh); not MUSL_TARGET
+# The SDIO host of the radio module (usdhc1, mmc@2190000), its power is reg_wlan (radio).
+RADIO_MMC_HOST=2190000.mmc
+# U2AC: only the BCM4358 (its firmware is in this board's rootfs overlay, lib/firmware/brcm); fetch none of the
+# other radios' linux-firmware files (regulatory.db is still fetched with RADIO_FW=1). No OCBM overlay region:
+# the whole rootfs MTD may hold the squashfs.
+FW_IW416= FW_RTL8822CS_WIFI= FW_RTL8822CS_BT= FW_RTL8822CS_BTCFG= FW_RTL8822BS_WIFI=
+OVERLAY_OFFSET=$ROOTFS_PART_SIZE
+SQUASHFS_COMP=xz                 # U2AC: zstd did not fit (15.0 MB vs 12.4 MB partition); xz + ARM BCJ, 256K blocks
+SQUASHFS_OPTS="-Xbcj arm -b 262144"
+# U2AC kernel pin override (2026-11-26 trial): latest stable. sha256 from cdn.kernel.org sha256sums.asc over HTTPS.
+KVER=${U2AC_KVER:-7.2.10}
+case $KVER in
+    7.3.6) KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.3.6.tar.xz
+           KERNEL_SHA256=8183d475a76a0faffa92d6cd500af421f589dfd0300a0f1060bb875e11d45723 ;;
+    7.2.15) KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.15.tar.xz
+           KERNEL_SHA256=d0f6b1d7324c937ccaeb5c4ca7084bfcf71db2edb3e2d3a31f0ad83a681809ab ;;
+esac
+RECOVERY_SFTP=0                  # U2AC: no sftp-server in the recovery initramfs (kernel image budget); use scp -O
diff --git a/baseline/arm-imx6ul-u2ac/dts/imx6ull-ccpa-baseline.dts b/baseline/arm-imx6ul-u2ac/dts/imx6ull-ccpa-baseline.dts
new file mode 100644
index 0000000..9d1b8cd
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/dts/imx6ull-ccpa-baseline.dts
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-2.0
+// Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+// Modified 2026-10-19/20: the changes against LIVI are stated below.
+/*
+ * Derived from LIVI scripts/livi-link/arm/imx6ul/imx6ull.dts (https://github.com/f-io/LIVI; the LIVI
+ * project is GPL-3.0-or-later, this file's upstream SPDX tag is GPL-2.0 and is kept as is).
+ * LIVI: "Pin settings are the ones the vendor kernel runs with, read off a running board."
+ *
+ * Changes against LIVI, all for "no radio active at boot, nothing chip-specific":
+ *  - GPIO1_IO05 (the radio module's power switch, reg_wlan) is muxed by the regulator node itself, not
+ *    by the usdhc1 group: the MMC host is a module that is never loaded at boot, so a pin in its group
+ *    would never be muxed and the regulator could not switch the module off. regulator-fixed requests
+ *    its GPIO in the "off" state at probe (GPIOD_OUT_LOW, fixed.c in 7.2.10), so the module is held
+ *    unpowered from that probe on; before it the pin keeps the boot loader's state.
+ *    (Polarity: regulator on = GPIO driven low. LIVI's working mwifiex and the stock DTB's "wlreg_on"
+ *    regulator, GPIO1_IO05 enable-active-low, agree.)
+ *  - no radio is named here: build.sh makes one top-level DTS per radio (imx6ull-ccpa-baseline-<r>.dts
+ *    = this file + radio-<r>.dtsi, the Bluetooth serdev node, none|iw416|rtl8822cs|rtl8822bs); each
+ *    is appended to the SAME zImage, so the appended DTB is the only per-radio part of an image.
+ *  - blue LED on the heartbeat trigger (kernel alive), red on until the rootfs is up.
+ *  - bootargs gain panic=10: a kernel panic during a rootfs boot reboots, and the bootstate mark
+ *    then keeps that next boot in recovery instead of hanging until a power cycle.
+ *  - usbotg1 (the female host port) stays disabled unless the build includes imx6ull-ccpa-usbhost.dtsi
+ *    (USB_HOST=1 or RECOVERY_USB=1).
+ *
+ * The appended DTB is what this kernel uses (ARM_APPENDED_DTB; ARM_ATAG_DTB_COMPAT must stay off): the
+ * vendor U-Boot passes its own FDT (norboot: "cp 0x80800800 0x83000000 0xf800 ... bootz 0x80800000 -
+ * 0x83000000") with its own bootargs (console=ttyLogFile0 root=/dev/mtdblock2 ... mtdparts=...), which
+ * would otherwise replace the partition map and the console below.
+ */
+/*
+ * Carlinkit U2AC_AUTOKIT (i.MX6ULL rev1.1, 128 MiB, MX25L12835F, Broadcom BCM4358 radio), adapted from the
+ * CCPA baseline below (milouk, 2026-11-26). Differences, each from the unit's live fingerprint (fp/pinctrl.txt,
+ * gpio.txt, mtd.txt, 2026-11-25) or the 2026-11-26 UART test:
+ *  - console on ttymxc1 (pads TX2/RX2, the stock DT muxes uart2grp; a Pi listens there). Only ONE console=:
+ *    imx_uart has a single struct console, so a second console= on another ttymxc never registers (r1, 2026-11-26).
+ *  - red LED only (GPIO1_IO02 = the vendor's "Power LED ON", echo 0 = on, active low; same pin as the CCPA).
+ *    NO blue LED: GPIO1_IO09 (the CCPA's blue LED) is in this board's stock "wifigrp" (usdhc1), a radio line here.
+ *  - partition map: r1/r2 used the stock map with the stock JFFS2 rootfs read-only; from r3 the LIVI/CCPA map
+ *    (rootfs 0xc60000 writable, customer + bootstate at the end) so the unit runs our own rootfs. Back to stock =
+ *    restore kernel + env + flash 0x380000-0xffffff from the repo backups.
+ */
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "imx6ull.dtsi"
+
+/ {
+	model = "Carlinkit U2AC AutoKit mainline (i.MX6ULL)";
+	compatible = "fsl,imx6ull";
+
+	chosen {
+		stdout-path = &uart2;
+		bootargs = "console=ttymxc1,115200 rdinit=/init panic=10 quiet";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x08000000>;
+	};
+
+	/* Power switch of the Wi-Fi/BT module (LIVI: "Enables the Wi-Fi/BT module (PDn)"). */
+	reg_wlan: regulator-wlan {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wlan_pwr>;
+		regulator-name = "wlan";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio1 5 GPIO_ACTIVE_LOW>;
+		startup-delay-us = <100000>;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_leds>;
+
+		led-red {
+			label = "red";
+			gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+	};
+};
+
+&iomuxc {
+	pinctrl_uart1: uart1grp {
+		fsl,pins = <
+			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX	0x1b0b1
+			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX	0x1b0b1
+		>;
+	};
+
+	pinctrl_uart2: uart2grp {
+		fsl,pins = <
+			MX6UL_PAD_UART2_TX_DATA__UART2_DCE_TX	0x1b0b1
+			MX6UL_PAD_UART2_RX_DATA__UART2_DCE_RX	0x1b0b1
+		>;
+	};
+
+	/* Both EVK buses (LIVI). The MFi coprocessor answers at 0x11 on i2c2 = /dev/i2c-1. */
+	pinctrl_i2c1: i2c1grp {
+		fsl,pins = <
+			MX6UL_PAD_UART4_TX_DATA__I2C1_SCL	0x4001b8b0
+			MX6UL_PAD_UART4_RX_DATA__I2C1_SDA	0x4001b8b0
+		>;
+	};
+
+	pinctrl_i2c2: i2c2grp {
+		fsl,pins = <
+			MX6UL_PAD_UART5_TX_DATA__I2C2_SCL	0x4001b8b0
+			MX6UL_PAD_UART5_RX_DATA__I2C2_SDA	0x4001b8b0
+		>;
+	};
+
+	/* The radio module's Bluetooth UART (no device node unless a radio .dtsi adds one). */
+	pinctrl_uart3: uart3grp {
+		fsl,pins = <
+			MX6UL_PAD_UART3_TX_DATA__UART3_DCE_TX	0x1b0b1
+			MX6UL_PAD_UART3_RX_DATA__UART3_DCE_RX	0x1b0b1
+			MX6UL_PAD_UART3_RTS_B__UART3_DCE_RTS	0x1b0b1
+			MX6UL_PAD_UART3_CTS_B__UART3_DCE_CTS	0x1b0b1
+		>;
+	};
+
+	pinctrl_qspi: qspigrp {
+		fsl,pins = <
+			MX6UL_PAD_NAND_WP_B__QSPI_A_SCLK	0x70a1
+			MX6UL_PAD_NAND_READY_B__QSPI_A_DATA00	0x70a1
+			MX6UL_PAD_NAND_CE0_B__QSPI_A_DATA01	0x70a1
+			MX6UL_PAD_NAND_CE1_B__QSPI_A_DATA02	0x70a1
+			MX6UL_PAD_NAND_CLE__QSPI_A_DATA03	0x70a1
+			MX6UL_PAD_NAND_DQS__QSPI_A_SS0_B	0x70a1
+		>;
+	};
+
+	pinctrl_usdhc1: usdhc1grp {
+		fsl,pins = <
+			MX6UL_PAD_SD1_CMD__USDHC1_CMD		0x17059
+			MX6UL_PAD_SD1_CLK__USDHC1_CLK		0x10071
+			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0	0x17059
+			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1	0x17059
+			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2	0x17059
+			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3	0x17059
+		>;
+	};
+
+	/* Moved out of usdhc1grp (LIVI) so it is muxed when reg_wlan probes. Pad value is LIVI's. */
+	pinctrl_leds: ledsgrp {
+		fsl,pins = <
+			MX6UL_PAD_GPIO1_IO02__GPIO1_IO02	0x17059
+		>;
+	};
+
+	pinctrl_wlan_pwr: wlanpwrgrp {
+		fsl,pins = <
+			MX6UL_PAD_GPIO1_IO05__GPIO1_IO05	0x17059
+		>;
+	};
+
+};
+
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart1>;
+	status = "okay";
+};
+
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart2>;
+	status = "okay";
+};
+
+&i2c1 {
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c1>;
+	status = "okay";
+};
+
+&i2c2 {
+	clock-frequency = <100000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c2>;
+	status = "okay";
+};
+
+&uart3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart3>;
+	uart-has-rtscts;
+	status = "okay";
+};
+
+/* The port the host sees (LIVI). */
+&usbotg2 {
+	dr_mode = "peripheral";
+	disable-over-current;
+	/* U2AC: completion IRQ at once (driver default 1 micro-frame = 125 us); ~125 IRQ/s at AA video rates */
+	itc-setting = <0>;
+	status = "okay";
+};
+
+/* SDIO to the radio module; sdhci-esdhc-imx is a rootfs module, never loaded at boot. */
+&usdhc1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_usdhc1>;
+	bus-width = <4>;
+	no-1-8-v;
+	non-removable;
+	keep-power-in-suspend;
+	vmmc-supply = <&reg_wlan>;
+	status = "okay";
+};
+
+&qspi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_qspi>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <29000000>;
+		spi-rx-bus-width = <1>;
+		spi-tx-bus-width = <1>;
+
+		/* LIVI's map, unchanged: hardware-proven 2026-10-19, and LIVI's provisioner keys on it. */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* U-Boot, its signature and the encrypted update env (+0x20000). Never written. */
+			partition@0 {
+				label = "uboot";
+				reg = <0x0 0x30000>;
+				read-only;
+			};
+
+			/* Erasing it makes U-Boot convert the staged kernel head on the next boot (flash-kernel). */
+			partition@30000 {
+				label = "env";
+				reg = <0x30000 0x10000>;
+			};
+
+			/* Read by U-Boot: 0x302fd8 bytes from here; staged head at +0x302fd8. */
+			partition@40000 {
+				label = "kernel";
+				reg = <0x40000 0x340000>;
+			};
+
+			/* Our squashfs rootfs (r3+). The stock JFFS2 that lived here is in the repo backup
+			 * (backup/mainline_r1_20261126/mtd3_stock_rootfs_2024.10.31.bin = flash 0x380000-0xffffff). */
+			partition@380000 {
+				label = "rootfs";
+				reg = <0x380000 0xc60000>;
+			};
+
+			/* Persist archive: SSH host key, authorized keys, root password (persistent root). */
+			partition@fe0000 {
+				label = "customer";
+				reg = <0xfe0000 0x10000>;
+			};
+
+			/* Boot-loop guard: a rootfs boot whose ways in are not up yet keeps the next boot in recovery. */
+			partition@ff0000 {
+				label = "bootstate";
+				reg = <0xff0000 0x10000>;
+			};
+		};
+	};
+};
+
+/* Generated by build.sh per kernel config: usbhost.dtsi for USB host builds (the default), else empty.
+ * The radio node is added by the per-radio top-level DTS that includes this file. */
+#include "imx6ull-ccpa-variant.dtsi"
diff --git a/baseline/arm-imx6ul-u2ac/dts/imx6ull-ccpa-usbhost.dtsi b/baseline/arm-imx6ul-u2ac/dts/imx6ull-ccpa-usbhost.dtsi
new file mode 100644
index 0000000..a0f0476
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/dts/imx6ull-ccpa-usbhost.dtsi
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The female USB port (usbotg1, 2184000.usb) as a host port. Included ONLY by USB_HOST=1 /
+ * RECOVERY_USB=1 builds (build.sh writes the include into imx6ull-ccpa-variant.dtsi).
+ *
+ * VERIFIED, the vendor boot log AND the stock DTB agree:
+ *  - stock DTB (the FDT U-Boot passes: offset 0x800 of the decrypted update env in mtd0+0x20000,
+ *    33,027 B; norboot copies it from 0x80800800): usb@02184000 and usb@02184200 are
+ *    "fsl,imx6ul-usb", status okay, dr_mode = "otg", disable-over-current, NO vbus-supply, NO pinctrl-0;
+ *    /regulators has no USB VBUS regulator, and the OTG1_ID pad is not muxed.
+ *  - vendor boot log (saved stock dmesg, var/log/box_last_reboot.log lines 276-285, 299-359):
+ *    "2184000.usb supply vbus not found, using dummy regulator" (same for 2184200.usb); ci_hdrc.0 ran the
+ *    OTG state machine, "fsm->id = 0" at 0.29 s -> a_host at 3.11 s, a USB stick enumerated at 3.34 s
+ *    (sda1, vfat, /mnt/UPAN). The ID pin reads 0 (host) at boot.
+ * Hence dr_mode "host" (no ID pin needed, and host-only creates no second UDC) and disable-over-current,
+ * as the vendor. Never "otg"/"peripheral" here while the kernel has a UDC driver: a second UDC would
+ * appear, and the NCM gadget must stay on usbotg2 (net-up selects the UDC by NCM_UDC_MATCH in board.env,
+ * so it would not silently move, but nothing needs it).
+ *
+ * VBUS enable = GPIO1_IO07, MEASURED 2026-10-20 on the IW416 unit (revision-2 kernel, revision-4 rootfs,
+ * this file without the regulator): no stick enumerated on usbotg1 (ci_hdrc.0, host) until sysfs gpio7
+ * (gpiochip0 = 209c000.gpio = GPIO1) was driven high; the port then connected and sda1 (vfat) enumerated
+ * at once; back to input, the stick dropped. GPIO1_IO06 high did nothing. The stock DTB does not describe
+ * it; the vendor's init_gpio.sh drives sysfs gpio6/gpio7 ("quick charge"), the same pins if bank 1
+ * starts at 0 on the vendor 3.14 kernel too (INFERRED; on mainline it does, measured). Hence
+ * reg_usb_otg1_vbus below, on from its probe (boot-on: the GPIO is requested high, no low glitch;
+ * always-on: chipidea's port-power calls never switch it off), in recovery and rootfs alike, and only in
+ * USB host builds. Its pinctrl sets the mux only (IMX_NO_PAD_CTL, bit 31): the pad keeps the electrical
+ * settings it had when measured (the boot loader's; the revision-2 kernel never touched the pad).
+ * VERIFIED on the unit (revision 5, 2026-10-20/21): the stick enumerates at boot with no manual GPIO.
+ * UNVERIFIED: the port's current limit; mainline chipidea host
+ * behaviour beyond enumeration. Wired-CarPlay role swapping (dr_mode "otg" plus the vendor's
+ * a_suspend_req_inf use) is out of the baseline; mainline chipidea would need USB_OTG_FSM /
+ * role-switch support for it.
+ */
+/ {
+	reg_usb_otg1_vbus: regulator-usb-otg1-vbus {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_usb_otg1_vbus>;
+		regulator-name = "usb_otg1_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio1 7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
+
+&iomuxc {
+	/* Mux only (0x80000000 = IMX_NO_PAD_CTL): pad settings as measured, see above. */
+	pinctrl_usb_otg1_vbus: usbotg1vbusgrp {
+		fsl,pins = <
+			MX6UL_PAD_GPIO1_IO07__GPIO1_IO07	0x80000000
+		>;
+	};
+};
+
+&usbotg1 {
+	dr_mode = "host";
+	disable-over-current;
+	vbus-supply = <&reg_usb_otg1_vbus>;
+	status = "okay";
+};
diff --git a/baseline/arm-imx6ul-u2ac/dts/radio-bcm4358.dtsi b/baseline/arm-imx6ul-u2ac/dts/radio-bcm4358.dtsi
