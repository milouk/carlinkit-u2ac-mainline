+
+### 🕵️ MITM / 📟 Video overlay
+  # Enable the H.264 text overlay (e.g. OBD values, sensor data, alerts) on the main Android Auto video. Requires mitm = true. The phone video is decoded, the text is drawn and the stream is re-encoded (extra CPU load, VIDEO_FPS_60 is capped to 30). When disabled the video path is completely untouched. Applies on the next connection. Disabled by default.
+  overlay_enabled = false
+
+  # Path to the live overlay JSON (or plain-text) file in shared memory. If empty, defaults to `/dev/shm/overlay.json`. The overlay pipeline starts immediately when `overlay_enabled = true` even if this file or its "text" field is initially empty, allowing text to be added or updated live. Default: `/dev/shm/overlay.json`.
+  overlay_text_path = "/dev/shm/overlay.json"
+
+  # Optional path to a TTF font file for rendering the overlay text (anti-aliased, national characters, HTML styling such as <b>, <i>, <u>, <font color>). If empty, missing or not a valid font, the built-in bitmap font is used. With a TTF font "text_scale" in the overlay JSON is the font size (1-4 = 12/24/36/48 px, larger = pixels). A font with many glyphs can use tens of MB of RAM. A non-empty "font_path" in the overlay JSON takes precedence. Default: empty.
+  overlay_font_path = ""
+
+  # Hardware acceleration backend for the video overlay: `none` (pure-Rust software with rusty_h264, default), `auto` (auto-detect V4L2 M2M H.264 decoder and encoder on /dev/video*, with automatic software fallback), or `v4l2` (force V4L2 M2M hardware codec with software fallback). The official image does not include the V4L2 codec drivers: a custom Buildroot image is needed on Raspberry Pi, see https://aa-proxy.github.io/docs/config-options#video-overlay-hardware-acceleration . Default: none.
+  overlay_hw_accel = "none"
+
+  # Optional explicit device path for V4L2 M2M H.264 hardware decoder (e.g. `/dev/video10` on Raspberry Pi with h264 hw acceleration). If empty, auto-detected when `overlay_hw_accel` is `auto` or `v4l2`. Default: empty.
+  overlay_v4l2_decoder = ""
+
+  # Optional explicit device path for V4L2 M2M H.264 hardware encoder (e.g. `/dev/video11` on Raspberry Pi with h264 hw acceleration). If empty, auto-detected when `overlay_hw_accel` is `auto` or `v4l2`. Default: empty.
+  overlay_v4l2_encoder = ""
+
+### 🕵️ MITM / 🔌 EV routing
+  # Enable EV routing
