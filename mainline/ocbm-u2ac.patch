+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# udhcpc script of u2ac-home (the home upload): the address, and a default route via the network's router so a
+# Pushgateway in another subnet is reached too. No DNS (the server is given by IP), nothing outside wlan0;
+# u2ac-home cleanup removes the address again (the route goes with it).
+case ${1:-} in
+    bound | renew)
+        ip addr add "$ip/${mask:-24}" dev "$interface" 2> /dev/null && echo "$ip/${mask:-24}" > /run/u2ac-home/ip
+        [ -n "${router:-}" ] && ip route add default via "${router%% *}" dev "$interface" 2> /dev/null \
+            && echo "${router%% *}" > /run/u2ac-home/router
+        ;;
+esac
+exit 0
