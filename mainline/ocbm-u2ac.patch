+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# GET /cgi-bin/about -> versions (cached for the boot: they cannot change while it runs) + CPU
+# frequency residency (cpufreq stats/time_in_state, live).
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+
+V=$WEB/versions
+if [ ! -s "$V" ]; then
+    # ver NAME CMD...: first line of CMD's output, only if CMD exists (no "not found" text in the UI)
+    ver() { _n=$1; shift; command -v "$1" > /dev/null 2>&1 || return 0; echo "$_n=$($TO "$@" < /dev/null 2>&1 | grep -m 1 .)"; }
+    {
+        echo "kernel=$(uname -r 2> /dev/null) $(uname -v 2> /dev/null)"
+        echo "build=$(head -n 1 "$R/etc/baseline-release" 2> /dev/null)"
+        echo "board=$(sed -n 's/^BOARD_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$R/etc/baseline/board.env" 2> /dev/null | head -n 1)"
+        ver aa-proxy-rs aa-proxy-rs --version
+        _b=/usr/libexec/bluetooth/bluetoothd; [ -x "$_b" ] || _b=bluetoothd
+        ver bluez "$_b" --version
+        ver hostapd hostapd -v
+        ver iw iw --version
+        echo "busybox=$(busybox 2>&1 | head -n 1 | sed 's/ multi-call binary.*//')"
+        echo "machine=$(uname -m 2> /dev/null)"
+    } > "$V.$$" && mv -f "$V.$$" "$V"
+fi
+
+hdr
+awk -v st="$R/sys/devices/system/cpu/cpu0/cpufreq/stats/time_in_state" -v gov="$R/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" "$AWKLIB"'
+BEGIN { printf "{\"ok\":true,\"versions\":{" }
+{ i = index($0, "="); if (!i) next; printf "%s%s:%s", (n++ ? "," : ""), js(substr($0, 1, i - 1)), js(substr($0, i + 1)) }
+END {
+    printf "},\"cpu\":{\"governor\":"; g = ""; getline g < gov; printf "%s,\"time_in_state\":[", js(g)
+    k = 0; while ((getline l < st) > 0) { split(l, a, " "); if (a[1] ~ /^[0-9]+$/) printf "%s{\"khz\":%d,\"ticks\":%d}", (k++ ? "," : ""), a[1], a[2] }
+    printf "]}}\n"
+}' "$V"
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/action b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/action
