index 0000000..ce61b11
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/settings
@@ -0,0 +1,65 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# GET /cgi-bin/settings -> current Wi-Fi name and channel width, Bluetooth name, paired phones, mode, what a reboot would
+# change. The Wi-Fi password is never returned.
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+now
+wif
+
+CSSID=$(tomlget ssid "$AACFG")
+ALIAS=$(tomlget btalias "$AACFG")
+WEBSRV=$(tomlget webserver "$AACFG")
+OVR=false OSSID=
+if [ -s "$WIFI_OVR" ]; then OVR=true; OSSID=$(ovrget SSID); fi
+SSID=${OSSID:-$CSSID}
+[ -n "$SSID" ] || SSID=$(sed -n 's/^ssid=//p' "$HAPCONF" 2> /dev/null | head -n 1)
+cache iwinfo 15 iw dev "$WIF" info
+LIVE=$(sed -n 's/^[[:space:]]*ssid //p' "$WEB/iwinfo" 2> /dev/null | head -n 1)
+PENDING=false
+[ -n "$LIVE" ] && [ "$LIVE" != "$SSID" ] && PENDING=true
+[ -e "$WEB/pending-reboot" ] && PENDING=true
+MODE=auto
+[ -e "$P/u2ac-aa-force" ] && MODE=aa
+[ -e "$P/u2ac-dev" ] && MODE=dev
+REC=false
+command -v reboot-recovery > /dev/null 2>&1 && REC=true
+# hotspot channel width: chosen (u2ac-wifi-80 flag), running now (iw info), and whether the firmware's locale
+# offers 80 MHz on channel 36 at all (without it the boot keeps 40 MHz whatever the flag says)
+WSET=40; [ -e "$P/u2ac-wifi-80" ] && WSET=80
+WLIVE=$(sed -n 's/.*width: \([0-9]*\) MHz.*/\1/p' "$WEB/iwinfo" 2> /dev/null | head -n 1)
+V80=false
+_phy=$(cat "$R/sys/class/net/$WIF/phy80211/name" 2> /dev/null)
+# (the locale does not change within a boot: the channel list is cached for an hour)
+[ -n "$_phy" ] && cache phych 3600 iw phy "$_phy" channels && grep -A3 '5180 MHz' "$WEB/phych" 2> /dev/null | grep -q VHT80 && V80=true
+
+# the other options (cgi-bin/action opt): flags in /run/persist
+OG=on; [ -e "$P/u2ac-hfp-guard-off" ] && OG=off
+OF=on; [ -e "$P/u2ac-flightlog-off" ] && OF=off
+OL=on; [ -e "$P/u2ac-led-off" ] && OL=off
+OB=fast; [ -e "$P/u2ac-bt-slowbaud" ] && OB=slow
+OP=stock; [ -e "$P/u2ac-bt-0092" ] && OP=0092
+OU=16384; [ -s "$P/u2ac-ffs-chunk" ] && read -r OU < "$P/u2ac-ffs-chunk"
+case $OU in 512 | 1024 | 2048 | 4096 | 8192 | 16384) ;; *) OU=16384 ;; esac
+
+hdr
+printf '{"ok":true,"opts":{"guard":"%s","flightlog":"%s","led":"%s","btbaud":"%s","btpatch":"%s","usbchunk":%s},' \
+    "$OG" "$OF" "$OL" "$OB" "$OP" "$OU"
+printf '"wifi":{"ssid":%s,"live_ssid":%s,"override":%s,"width":{"set":%s,"live":%s,"vht80":%s}},"bt":{"alias":%s},"mode":"%s","pending_reboot":%s,"recovery":%s,"aaproxy_web":%s,"paired":[' \
+    "$(jstr "$SSID")" "$(jstr "$LIVE")" "$OVR" "$WSET" "${WLIVE:-null}" "$V80" "$(jstr "$ALIAS")" "$MODE" "$PENDING" "$REC" "$(jstr "$WEBSRV")"
+_sep=
+for _x in "$BTLIB"/*/[0-9A-F][0-9A-F]:??:??:??:??:??; do
+    [ -d "$_x" ] || continue
+    _dev=${_x##*/} _ad=${_x%/*}; _ad=${_ad##*/}
+    valid_mac "$_dev" && valid_mac "$_ad" || continue
+    # Name= / Alias= of the [General] group, LinkKey present = bonded
+    _info=$(awk 'BEGIN { g = "" } /^\[/ { g = $0; next } g == "[General]" && /^Name=/ { n = substr($0, 6) } g == "[General]" && /^Alias=/ { a = substr($0, 7) } g == "[LinkKey]" { k = 1 } END { print (a != "" ? a : n); print (k ? "1" : "0") }' "$_x/info" 2> /dev/null)
+    _name=${_info%"
+"*}
+    _bond=${_info##*"
+"}
+    [ "$_name" = "$_info" ] && _bond=0
+    printf '%s{"adapter":"%s","addr":"%s","name":%s,"bonded":%s}' "$_sep" "$_ad" "$_dev" "$(jstr "$_name")" "$([ "$_bond" = 1 ] && echo true || echo false)"
+    _sep=,
+done
+printf ']}\n'
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/status b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/status
new file mode 100755
index 0000000..a738dff
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/status
@@ -0,0 +1,125 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# GET /cgi-bin/status: one JSON object for the dashboard (polled every 3 s). Cheap by design: process
+# states from /proc/*/comm with shell builtins, /proc and /sys read inside ONE awk, `iw info` and
+# `btmgmt info` cached 15 s; per call only `iw station dump`, `dumpleases` (when a client is on) and a
+# `tail` of the aa-proxy-rs log are run.
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+now
+wif
+
+AAP=0 AAPID=0 HOSTAPD=0 UDHCPD=0 DBUS=0 BLUEZ=0
+for _p in "$R"/proc/[0-9]*; do
+    { read -r _c < "$_p/comm"; } 2> /dev/null || continue
+    case $_c in
+        aa-proxy-rs) AAP=1 AAPID=${_p##*/} ;;
+        hostapd) HOSTAPD=1 ;;
+        udhcpd) UDHCPD=1 ;;
+        dbus-daemon) DBUS=1 ;;
+        bluetoothd) BLUEZ=1 ;;
+    esac
+done
+
+MODE=auto
+[ -e "$P/u2ac-aa-force" ] && MODE=aa
+[ -e "$P/u2ac-dev" ] && MODE=dev
+PAIRED=0
+for _x in "$BTLIB"/*/[0-9A-F][0-9A-F]:??:??:??:??:??; do [ -d "$_x" ] && PAIRED=$((PAIRED + 1)); done
+
+cache iwinfo 15 iw dev "$WIF" info
+cache btinfo 15 btm -i hci0 info
+STA=$(iw dev "$WIF" station dump 2> /dev/null)
+LEASE=; [ -n "$STA" ] && LEASE=$(dumpleases -f "$LEASES" 2> /dev/null)
+
+TZ0=$R/sys/class/thermal/thermal_zone0/temp
+CPU=$R/sys/devices/system/cpu/cpu0/cpufreq
+
+hdr
+{
+    echo "@@sta"; [ -n "$STA" ] && printf '%s\n' "$STA"
+    echo "@@lease"; [ -n "$LEASE" ] && printf '%s\n' "$LEASE"
+    echo "@@log"; tail -n 120 "$AALOG" 2> /dev/null
+} | awk -v now="$NOW" -v aap="$AAP" -v aapid="$AAPID" -v hostapd="$HOSTAPD" -v udhcpd="$UDHCPD" \
+    -v dbus="$DBUS" -v bluez="$BLUEZ" -v mode="$MODE" -v paired="$PAIRED" -v wif="$WIF" \
+    -v iwf="$WEB/iwinfo" -v btf="$WEB/btinfo" -v proc="$R/proc" -v cpu="$CPU" -v tz="$TZ0" \
+    -v rel="$R/etc/baseline-release" "$AWKLIB"'
+function rd(f,   l) { l = ""; if ((getline l < f) <= 0) l = ""; close(f); return l }
+function b(x) { return x ? "true" : "false" }
+function n(x) { return (x == "" ? "null" : x + 0) }
+function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
+/^@@/ { sec = substr($0, 3); next }
+sec == "sta" {
+    if ($1 == "Station") { ns++; mac[ns] = tolower($2); next }
+    if (!ns) next
+    l = trim($0); i = index(l, ":"); if (!i) next
+    k = substr(l, 1, i - 1); v = trim(substr(l, i + 1))
+    if (k == "signal") sig[ns] = v + 0
+    else if (k == "signal avg") sga[ns] = v + 0
+    else if (k == "tx bitrate") txr[ns] = v
+    else if (k == "rx bitrate") rxr[ns] = v
+    else if (k == "connected time") ct[ns] = v + 0
+    else if (k == "inactive time") ina[ns] = v + 0
+    else if (k == "rx bytes") rxb[ns] = v + 0
+    else if (k == "tx bytes") txb[ns] = v + 0
+    next
+}
+sec == "lease" { if ($1 ~ /^[0-9a-fA-F][0-9a-fA-F]:/) { m = tolower($1); lip[m] = $2; if (NF >= 4) lho[m] = $3 } next }
+sec == "log" {
+    l = trim(noansi($0)); if (l == "") next
+    nl++; last = l
+    if (l ~ /first video frame/) vs = nl
+    if (l ~ /session time:|[Cc]losing session|disconnected phone|Terminated single session|ByeBye|session error|[Cc]onnection reset/) ve = nl
+    next
+}
+END {
+    # Wi-Fi AP (cached iw info)
+    while ((getline l < iwf) > 0) {
+        l = trim(l)
+        if (l ~ /^ssid /) ssid = substr(l, 6)
+        else if (l ~ /^type /) itype = substr(l, 6)
+        else if (l ~ /^addr /) iaddr = substr(l, 6)
+        else if (l ~ /^channel /) { split(l, c, /[ (),]+/); chan = c[2]; freq = c[3]; if (match(l, /width: [0-9]+ MHz/)) width = substr(l, RSTART + 7, RLENGTH - 7) }
+        else if (l ~ /^txpower /) txp = substr(l, 9)
+    }
+    close(iwf)
+    # Bluetooth (cached btmgmt info)
+    while ((getline l < btf) > 0) {
+        l = trim(l)
+        if (l ~ /^addr /) { split(l, a, " "); btaddr = a[2] }
+        else if (l ~ /^current settings:/) btset = trim(substr(l, 18))
+        else if (l ~ /^name /) btname = substr(l, 6)
+    }
+    close(btf)
+    s = " " btset " "
+    # system
+    split(rd(proc "/uptime"), u, " "); split(rd(proc "/loadavg"), la, " ")
+    while ((getline l < (proc "/meminfo")) > 0) { split(l, mm, /[: ]+/); mem[mm[1]] = mm[2] }
+    close(proc "/meminfo")
+    avail = mem["MemAvailable"]; if (avail == "") avail = mem["MemFree"] + mem["Buffers"] + mem["Cached"]
+    t = rd(tz); if (t !~ /^-?[0-9]+$/) t = ""
+    rss = ""
+    if (aapid) { while ((getline l < (proc "/" aapid "/status")) > 0) if (l ~ /^VmRSS:/) { split(l, r, /[ \t]+/); rss = r[2] } close(proc "/" aapid "/status") }
+
+    # Android Auto state: aa-proxy-rs up + a Wi-Fi station + the newest session event in its log
+    if (!aap) st = "off"; else if (!ns) st = "waiting"; else if (vs && vs > ve) st = "streaming"; else st = "connected"
+    if (length(last) > 200) last = substr(last, 1, 200) "..."
+
+    printf "{\"ok\":true,\"t\":%d,", now
+    printf "\"aa\":{\"state\":\"%s\",\"running\":%s,\"pid\":%s,\"rss_kb\":%s,\"last\":%s},", st, b(aap), n(aapid ? aapid : ""), n(rss), js(last)
+    printf "\"mode\":{\"set\":\"%s\",\"active\":\"%s\"},", mode, (aap ? "aa" : "maint")
+    printf "\"svc\":{\"hostapd\":%s,\"udhcpd\":%s,\"dbus\":%s,\"bluetoothd\":%s,\"aa-proxy-rs\":%s},", b(hostapd), b(udhcpd), b(dbus), b(bluez), b(aap)
+    printf "\"wifi\":{\"iface\":%s,\"ssid\":%s,\"type\":%s,\"addr\":%s,\"channel\":%s,\"freq\":%s,\"width\":%s,\"txpower\":%s,\"clients\":[", js(wif), js(ssid), js(itype), js(iaddr), n(chan), n(freq), n(width), js(txp)
+    for (i = 1; i <= ns; i++) {
+        m = mac[i]
+        printf "%s{\"mac\":%s,\"ip\":%s,\"host\":%s,\"signal\":%s,\"signal_avg\":%s,\"tx\":%s,\"rx\":%s,\"tx_mbps\":%s,\"rx_mbps\":%s,\"connected_s\":%s,\"inactive_ms\":%s,\"rx_bytes\":%s,\"tx_bytes\":%s}", \
+            (i > 1 ? "," : ""), js(m), js(lip[m]), js(lho[m]), n(sig[i]), n(sga[i]), js(txr[i]), js(rxr[i]), n(txr[i]), n(rxr[i]), n(ct[i]), n(ina[i]), n(rxb[i]), n(txb[i])
+    }
+    printf "]},"
+    printf "\"bt\":{\"addr\":%s,\"name\":%s,\"settings\":%s,\"powered\":%s,\"connectable\":%s,\"discoverable\":%s,\"bondable\":%s,\"paired\":%d},", \
+        js(btaddr), js(btname), js(btset), b(index(s, " powered ")), b(index(s, " connectable ")), b(index(s, " discoverable ")), b(index(s, " bondable ")), paired
+    printf "\"sys\":{\"uptime\":%s,\"load\":[%s,%s,%s],\"cpu_khz\":%s,\"cpu_max_khz\":%s,\"governor\":%s,", \
+        n(int(u[1])), n(la[1]), n(la[2]), n(la[3]), n(rd(cpu "/scaling_cur_freq")), n(rd(cpu "/scaling_max_freq")), js(rd(cpu "/scaling_governor"))
+    printf "\"mem_total_kb\":%s,\"mem_avail_kb\":%s,\"mem_free_kb\":%s,\"temp_mc\":%s,\"build\":%s,\"kernel\":%s}}\n", \
+        n(mem["MemTotal"]), n(avail), n(mem["MemFree"]), n(t), js(rd(rel)), js(rd(proc "/sys/kernel/osrelease"))
+}'
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/token b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/token
new file mode 100755
index 0000000..4d93e02
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/token
@@ -0,0 +1,55 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# GET /cgi-bin/token -> {"ok","token":"<32 hex>"|null,"why":"first|usb|reveal|none","usb":bool}
+# The access code for changes (POST /cgi-bin/action). It is handed out only:
+#   first  - to the request that creates it (the file did not exist yet: first visit after a fresh persist),
+#            if it comes over USB or the hotspot no longer has the vendor's default password
+#   usb    - to any request from the USB link (192.168.50.0/24: a computer on the dongle's own cable)
+#   reveal - once, after `touch /run/u2ac-web/reveal-once` (e.g. over ssh); the flag is then removed
+# Anyone else gets null and has to type it in (it is in /run/persist/u2ac-webtoken).
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+
+# default_psk: the hotspot still has the vendor's well-known password (no override, or the override is it)
+default_psk() {
+    _k=; [ -s "$WIFI_OVR" ] && _k=$(sed -n 's/^PSK=//p' "$WIFI_OVR" | head -n 1)
+    [ -n "$_k" ] || _k=$(sed -n 's/^wpa_passphrase=//p' "$R/usr/share/u2ac/hostapd.conf" 2> /dev/null | head -n 1)
+    [ "$_k" = 12345678 ]
+}
+
+WHY=none
+token_read
+if [ -z "$TOK" ]; then
+    token_new && WHY=first
+    token_read
+    [ -n "$TOK" ] || fail "could not create the access code in /run/persist" persist
+    # to flash at once: the 30 s saver skips live sessions, and a code lost at ignition-off reopens the
+    # "first visitor gets it" window on the next boot
+    [ "$WHY" = first ] && { u2ac-aa persist > /dev/null 2>&1 & }
+fi
+USB=false
+from_usb && USB=true
+# On the vendor's default hotspot password anyone in range can join the hotspot: then a new code is shown
+# only over the USB link (a computer on the dongle's cable), never to the first visitor on the hotspot
+if [ "$WHY" = first ]; then
+    if [ "$USB" = false ] && default_psk; then
+        WHY=none; weblog "access code created, not shown (hotspot on the vendor default password: USB only)"
+    else
+        weblog "access code created and shown"
+    fi
+fi
+if [ "$WHY" != first ]; then
+    if [ "$USB" = true ]; then
+        WHY=usb
+    elif [ -e "$WEB/reveal-once" ] && rm -f "$WEB/reveal-once" 2> /dev/null && [ ! -e "$WEB/reveal-once" ]; then
+        WHY=reveal
+        weblog "access code revealed once"
+    fi
+fi
+
+hdr
+if [ "$WHY" = none ]; then
+    printf '{"ok":true,"token":null,"why":"none","usb":%s}\n' "$USB"
+else
+    printf '{"ok":true,"token":"%s","why":"%s","usb":%s}\n' "$TOK" "$WHY" "$USB"
+fi
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/index.html b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/index.html
