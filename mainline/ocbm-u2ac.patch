+</style>
+</head>
+<body>
+<div class="wrap">
+<header><h1 id="name">AutoKit dongle</h1><div id="live" role="status"><i></i><span>Connecting</span></div></header>
+
+<section id="t-status">
+  <div id="hero" data-s="off" aria-live="polite">
