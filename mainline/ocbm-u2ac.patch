diff --git a/baseline/arm-imx6ul-u2ac/modules/u2ac-ws2812/u2ac-ws2812.c b/baseline/arm-imx6ul-u2ac/modules/u2ac-ws2812/u2ac-ws2812.c
new file mode 100644
index 0000000..13f2d7d
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/modules/u2ac-ws2812/u2ac-ws2812.c
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * u2ac-ws2812: the U2AC AutoKit's WS2812B RGB status LED (data on GPIO1_IO03), bit-banged with interrupts off.
+ *
+ * The stock firmware drove it from user space through /dev/mem (colorLightDaemon, "led_ws2812b", gpio 3,
+ * colour table /etc/rgbLight.conf). Here it is one LED class device, /sys/class/leds/rgb:status:
+ *   color       RRGGBB (hex), the colour at full brightness
+ *   brightness  0..255, scales the colour; the kernel's timer trigger blinks it (no user-space loop)
+ * Pulse widths come from the ARM cycle counter (PMCCNTR) at the CPU clock tracked by a cpufreq notifier;
+ * the frame (24 bits x nleds, ~30 us per LED) runs with interrupts off (one core: nothing else touches
+ * GPIO1 meanwhile). After each CPU clock change the frame is sent again (a frame raced by a transition
+ * may have used the old clock).
+ */
+#include <linux/module.h>
+#include <linux/io.h>
+#include <linux/leds.h>
+#include <linux/cpufreq.h>
+#include <linux/spinlock.h>
+#include <linux/ktime.h>
+#include <linux/delay.h>
+
+#define GPIO1_BASE	0x0209c000
+#define GPIO_DR		0x00
+#define GPIO_GDIR	0x04
+
+static unsigned int pin = 3;
+module_param(pin, uint, 0444);
+MODULE_PARM_DESC(pin, "GPIO1 line of the LED data input (U2AC: 3)");
+static unsigned int nleds = 1;
+module_param(nleds, uint, 0444);
+MODULE_PARM_DESC(nleds, "LEDs in the chain (each gets the same colour)");
+static unsigned int t0h = 300, t1h = 750, tbit = 1250;
+module_param(t0h, uint, 0644);
+MODULE_PARM_DESC(t0h, "high time of a 0 bit, ns (WS2812B: 220-380)");
+module_param(t1h, uint, 0644);
+MODULE_PARM_DESC(t1h, "high time of a 1 bit, ns (WS2812B: 580-1000)");
+module_param(tbit, uint, 0644);
+MODULE_PARM_DESC(tbit, "bit period, ns");
+static unsigned int color = 0x7e172b;
+module_param(color, uint, 0444);
+MODULE_PARM_DESC(color, "colour at load, RRGGBB (stock StartUp: 0x7e172b)");
+
+static void __iomem *gpio;
+static struct led_classdev led;
+static u32 rgb;
+static unsigned int khz;
+static ktime_t last;
+static DEFINE_SPINLOCK(lock);
+
+static inline void ccnt_on(void)
+{
+	u32 v;
+
+	asm volatile("mrc p15, 0, %0, c9, c12, 0" : "=r"(v));
+	v = (v | 1) & ~8u;	/* E: enable; D off: count every cycle, not every 64th */
+	asm volatile("mcr p15, 0, %0, c9, c12, 0" : : "r"(v));
+	asm volatile("mcr p15, 0, %0, c9, c12, 1" : : "r"(0x80000000u));	/* PMCNTENSET.C */
+	isb();
+}
+
+static inline u32 ccnt(void)
+{
+	u32 v;
+
+	asm volatile("mrc p15, 0, %0, c9, c13, 0" : "=r"(v));
+	return v;
+}
+
+static void ws_send(u32 val)
+{
+	unsigned int k = READ_ONCE(khz) ? : 528000, n;
+	u32 c0 = DIV_ROUND_UP(t0h * k, 1000000), c1 = DIV_ROUND_UP(t1h * k, 1000000);
+	u32 cb = DIV_ROUND_UP(tbit * k, 1000000), grb, bit, dr, hi, t;
+	unsigned long flags;
+	s64 gap;
+
+	/* the WS2812B's colour order is G R B, most significant bit first */
+	grb = ((val >> 8) & 0xff) << 16 | ((val >> 16) & 0xff) << 8 | (val & 0xff);
+	spin_lock_irqsave(&lock, flags);
+	/* latch time: >= 300 us low since the previous frame */
+	gap = 300 - ktime_us_delta(ktime_get(), last);
+	if (gap > 0)
+		udelay(gap);
+	ccnt_on();
+	dr = readl_relaxed(gpio + GPIO_DR) & ~BIT(pin);
+	writel_relaxed(dr, gpio + GPIO_DR);
+	writel_relaxed(readl_relaxed(gpio + GPIO_GDIR) | BIT(pin), gpio + GPIO_GDIR);
+	hi = dr | BIT(pin);
+	for (n = 0; n < nleds; n++) {
+		for (bit = 1u << 23; bit; bit >>= 1) {
+			u32 th = (grb & bit) ? c1 : c0;
+
+			t = ccnt();
+			writel_relaxed(hi, gpio + GPIO_DR);
+			while (ccnt() - t < th)
+				;
+			writel_relaxed(dr, gpio + GPIO_DR);
+			while (ccnt() - t < cb)
+				;
+		}
+	}
+	wmb();
+	last = ktime_get();
+	spin_unlock_irqrestore(&lock, flags);
+}
+
+static void ws_show(enum led_brightness b)
+{
+	u32 c = READ_ONCE(rgb), o = 0;
+	int s;
+
+	for (s = 0; s < 24; s += 8)
+		o |= ((((c >> s) & 0xff) * b + 127) / 255) << s;
+	ws_send(o);
+}
+
+static void ws_set(struct led_classdev *cd, enum led_brightness b)
+{
+	ws_show(b);
+}
+
+static ssize_t color_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%06x\n", READ_ONCE(rgb));
+}
+
+static ssize_t color_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t len)
+{
+	u32 v;
+	int r = kstrtou32(buf, 16, &v);
+
+	if (r)
+		return r;
+	if (v > 0xffffff)
+		return -EINVAL;
+	WRITE_ONCE(rgb, v);
+	ws_show(READ_ONCE(led.brightness));
+	return len;
+}
+static DEVICE_ATTR_RW(color);
+
+static struct attribute *ws_attrs[] = { &dev_attr_color.attr, NULL };
+static const struct attribute_group ws_group = { .attrs = ws_attrs };
+static const struct attribute_group *ws_groups[] = { &ws_group, NULL };
+
+static int ws_cpufreq(struct notifier_block *nb, unsigned long ev, void *data)
+{
+	struct cpufreq_freqs *f = data;
+
+	if (ev == CPUFREQ_POSTCHANGE) {
+		WRITE_ONCE(khz, f->new);
+		ws_show(READ_ONCE(led.brightness));
+	}
+	return NOTIFY_OK;
+}
+static struct notifier_block ws_nb = { .notifier_call = ws_cpufreq };
+
+static int __init ws_init(void)
+{
+	int r;
+
+	if (pin > 31 || !nleds || nleds > 64 || color > 0xffffff)
+		return -EINVAL;
+	gpio = ioremap(GPIO1_BASE, 0x20);
+	if (!gpio)
+		return -ENOMEM;
+	khz = cpufreq_quick_get(0);
+	rgb = color;
+	led.name = "rgb:status";
+	led.max_brightness = LED_FULL;
+	led.brightness = LED_FULL;
+	led.brightness_set = ws_set;
+	led.groups = ws_groups;
+	r = led_classdev_register(NULL, &led);
+	if (r) {
+		iounmap(gpio);
+		return r;
+	}
+	ws_show(LED_FULL);
+	cpufreq_register_notifier(&ws_nb, CPUFREQ_TRANSITION_NOTIFIER);
+	return 0;
+}
+
+static void __exit ws_exit(void)
+{
+	cpufreq_unregister_notifier(&ws_nb, CPUFREQ_TRANSITION_NOTIFIER);
+	led_classdev_unregister(&led);
+	ws_send(0);
+	iounmap(gpio);
+}
+
+module_init(ws_init);
+module_exit(ws_exit);
+MODULE_DESCRIPTION("U2AC AutoKit WS2812B status LED (GPIO bit-bang)");
+MODULE_LICENSE("GPL");
