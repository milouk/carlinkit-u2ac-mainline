@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * u2ac-usbprobe FFS_DIR [ENABLE_MS [AOA_MS]]: tell a car from a computer on the USB port before the
+ * dongle shows the port anything a car would refuse (Carlinkit U2AC, milouk 2026-11-27).
+ *
+ * Why: the boot gadget used to be NCM (maintenance from a computer). A head unit has no NCM driver,
+ * so Ford SYNC 3 said "USB device not supported" at every plug-in, for the ~28 s until aa-proxy-rs
+ * took the port (car test 2026-11-27). This program serves ep0 of a FunctionFS function that looks
+ * exactly like aa-proxy-rs's own MTP stage (the shell side sets 18d1:4ee1, bcdDevice 0x3008 and the
+ * same strings; here the interface: MTP class 06/01/01, bulk OUT, bulk IN, interrupt IN), i.e. an
+ * Android phone. A head unit that does Android Auto probes it at once with the AOA vendor request
+ * GET_PROTOCOL (51); SYNC 3 sent it 33 ms after SET_CONFIGURATION. No computer sends it.
+ *
+ * Output on stdout: "configured" (flushed) as soon as the host sets the configuration, then the verdict
+ * as the last line, exit 0:
+ *   car     GET_PROTOCOL seen (answered 2, like aa-proxy-rs; the caller unbinds the port right away)
+ *   noaoa   the host configured the device but sent no AOA request within AOA_MS (a computer, or a car
+ *           that waits for the driver first): the caller brings NCM up and tests for a computer there
+ *   none    nobody configured the device within ENABLE_MS (no host yet, or a charger)
+ * Exit 2 (nothing on stdout): FunctionFS failed; the caller falls back to NCM.
+ * Every other control request to the function is stalled (f_fs.c ep0: read for IN, write for OUT).
+ * The bulk endpoints are never opened: a host that talks MTP/PTP to them gets NAKs until the end. */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+/* include/uapi/linux/usb/functionfs.h, spelled out (any libc's headers) */
+#define FFS_DESCRIPTORS_MAGIC_V2 3u
+#define FFS_STRINGS_MAGIC 2u
+#define FFS_HAS_FS_DESC 1u
+#define FFS_HAS_HS_DESC 2u
+#define FFS_ALL_CTRL_RECIP 64u /* class/vendor requests to the DEVICE reach us (AOA is device-recipient) */
+#define FFS_CONFIG0_SETUP 128u /* ... also before SET_CONFIGURATION (some head units probe that early) */
+enum { FFS_EV_BIND, FFS_EV_UNBIND, FFS_EV_ENABLE, FFS_EV_DISABLE, FFS_EV_SETUP, FFS_EV_SUSPEND, FFS_EV_RESUME };
+#define USB_DIR_IN 0x80
+#define USB_TYPE_MASK 0x60
+#define USB_TYPE_VENDOR 0x40
+#define AOA_GET_PROTOCOL 51
+
+#pragma pack(push, 1)
+struct if_desc { uint8_t bLength, bDescriptorType, bInterfaceNumber, bAlternateSetting, bNumEndpoints,
+                 bInterfaceClass, bInterfaceSubClass, bInterfaceProtocol, iInterface; };
+struct ep_desc { uint8_t bLength, bDescriptorType, bEndpointAddress, bmAttributes; uint16_t wMaxPacketSize;
+                 uint8_t bInterval; };
+struct speed { struct if_desc intf; struct ep_desc out, in, irq; };
+struct descs { uint32_t magic, length, flags, fs_count, hs_count; struct speed fs, hs; };
+struct strs { uint32_t magic, length, str_count, lang_count; uint16_t lang; char s[4]; };
+struct ctrlreq { uint8_t bRequestType, bRequest; uint16_t wValue, wIndex, wLength; };
+struct event { struct ctrlreq setup; uint8_t type, pad[3]; };
+#pragma pack(pop)
+
+static long ms_now(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000L + t.tv_nsec / 1000000L;
+}
+
+static struct speed speed_descs(uint16_t mps, uint8_t irq_interval) {
+    struct speed s = {
+        { 9, 4, 0, 0, 3, 0x06, 0x01, 0x01, 1 },   /* "MTP", the MTP stage's class triple */
+        { 7, 5, 0x01, 2, mps, 0 },                /* bulk OUT */
+        { 7, 5, 0x82, 2, mps, 0 },                /* bulk IN */
+        { 7, 5, 0x83, 3, 28, irq_interval },      /* interrupt IN (MTP event endpoint) */
+    };
+    return s;
+}
+
+int main(int argc, char **argv) {
+    char path[512];
+    long enable_ms = argc > 2 ? atol(argv[2]) : 3000, aoa_ms = argc > 3 ? atol(argv[3]) : 3000;
+    if (argc < 2 || argv[1][0] == '-') { fprintf(stderr, "usage: u2ac-usbprobe FFS_DIR [ENABLE_MS [AOA_MS]]\n"); return 2; }
+    snprintf(path, sizeof path, "%s/ep0", argv[1]);
+    int ep0 = open(path, O_RDWR);
+    if (ep0 < 0) { fprintf(stderr, "u2ac-usbprobe: %s: %s\n", path, strerror(errno)); return 2; }
+
+    struct descs d = { FFS_DESCRIPTORS_MAGIC_V2, sizeof d,
+                       FFS_HAS_FS_DESC | FFS_HAS_HS_DESC | FFS_ALL_CTRL_RECIP | FFS_CONFIG0_SETUP, 4, 4,
+                       speed_descs(64, 6), speed_descs(512, 6) };
+    struct strs s = { FFS_STRINGS_MAGIC, sizeof s, 1, 1, 0x0409, "MTP" };
+    if (write(ep0, &d, sizeof d) != (ssize_t)sizeof d || write(ep0, &s, sizeof s) != (ssize_t)sizeof s) {
+        fprintf(stderr, "u2ac-usbprobe: writing descriptors: %s\n", strerror(errno));
+        return 2;
+    }
+    /* the caller binds the UDC once ep1 exists; ENABLE_MS counts from here */
+    long t0 = ms_now(), deadline = t0 + enable_ms;
+    int enabled = 0;
+    const char *verdict = "none";
+    for (;;) {
+        long left = deadline - ms_now();
+        if (left <= 0) break;
+        struct pollfd p = { ep0, POLLIN, 0 };
+        int r = poll(&p, 1, (int)left);
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) continue;   /* timeout: the loop head ends it */
+        struct event ev[4];
+        ssize_t n = read(ep0, ev, sizeof ev);
+        if (n < 0) { if (errno == EINTR || errno == EAGAIN) continue; fprintf(stderr, "u2ac-usbprobe: ep0: %s\n", strerror(errno)); return 2; }
+        for (int i = 0; i < (int)(n / (ssize_t)sizeof ev[0]); i++) {
+            const struct ctrlreq *q = &ev[i].setup;
+            switch (ev[i].type) {
+            case FFS_EV_ENABLE:
+                fprintf(stderr, "u2ac-usbprobe: configured after %ld ms\n", ms_now() - t0);
+                if (!enabled) {
+                    enabled = 1; verdict = "noaoa"; deadline = ms_now() + aoa_ms;
+                    puts("configured");   /* progress for the caller: a host is there, the AOA window runs */
+                    fflush(stdout);
+                }
+                break;
+            case FFS_EV_SETUP:
+                if ((q->bRequestType & USB_TYPE_MASK) == USB_TYPE_VENDOR && q->bRequest == AOA_GET_PROTOCOL
+                    && (q->bRequestType & USB_DIR_IN)) {
+                    uint8_t v[2] = { 2, 0 };
+                    (void)!write(ep0, v, q->wLength < 2 ? q->wLength : 2);
+                    fprintf(stderr, "u2ac-usbprobe: AOA GET_PROTOCOL after %ld ms: a car\n", ms_now() - t0);
+                    puts("car");
+                    return 0;
+                } else {
+                    uint8_t b = 0;
+                    fprintf(stderr, "u2ac-usbprobe: SETUP %02x %02x %04x %04x %u: stall\n", q->bRequestType,
+                            q->bRequest, q->wValue, q->wIndex, q->wLength);
+                    if (q->bRequestType & USB_DIR_IN) (void)!read(ep0, &b, 1);
+                    else (void)!write(ep0, &b, 1);
+                }
+                break;
+            default: break;   /* BIND, DISABLE (a host reset), SUSPEND...: the deadline stands */
+            }
+        }
+    }
+    fprintf(stderr, "u2ac-usbprobe: %s after %ld ms\n", verdict, ms_now() - t0);
+    puts(verdict);
+    return 0;
+}
