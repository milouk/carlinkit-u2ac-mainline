@@ -0,0 +1,34 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# GET /cgi-bin/about -> versions (cached for the boot: they cannot change while it runs) + CPU
+# frequency residency (cpufreq stats/time_in_state, live).
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+
+V=$WEB/versions
+if [ ! -s "$V" ]; then
+    # ver NAME CMD...: first line of CMD's output, only if CMD exists (no "not found" text in the UI)
+    ver() { _n=$1; shift; command -v "$1" > /dev/null 2>&1 || return 0; echo "$_n=$($TO "$@" < /dev/null 2>&1 | grep -m 1 .)"; }
+    {
+        echo "kernel=$(uname -r 2> /dev/null) $(uname -v 2> /dev/null)"
+        echo "build=$(head -n 1 "$R/etc/baseline-release" 2> /dev/null)"
+        echo "board=$(sed -n 's/^BOARD_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$R/etc/baseline/board.env" 2> /dev/null | head -n 1)"
+        ver aa-proxy-rs aa-proxy-rs --version
+        _b=/usr/libexec/bluetooth/bluetoothd; [ -x "$_b" ] || _b=bluetoothd
+        ver bluez "$_b" --version
+        ver hostapd hostapd -v
+        ver iw iw --version
+        echo "busybox=$(busybox 2>&1 | head -n 1 | sed 's/ multi-call binary.*//')"
+        echo "machine=$(uname -m 2> /dev/null)"
+    } > "$V.$$" && mv -f "$V.$$" "$V"
+fi
+
+hdr
+awk -v st="$R/sys/devices/system/cpu/cpu0/cpufreq/stats/time_in_state" -v gov="$R/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" "$AWKLIB"'
+BEGIN { printf "{\"ok\":true,\"versions\":{" }
+{ i = index($0, "="); if (!i) next; printf "%s%s:%s", (n++ ? "," : ""), js(substr($0, 1, i - 1)), js(substr($0, i + 1)) }
+END {
+    printf "},\"cpu\":{\"governor\":"; g = ""; getline g < gov; printf "%s,\"time_in_state\":[", js(g)
+    k = 0; while ((getline l < st) > 0) { split(l, a, " "); if (a[1] ~ /^[0-9]+$/) printf "%s{\"khz\":%d,\"ticks\":%d}", (k++ ? "," : ""), a[1], a[2] }
+    printf "]}}\n"
+}' "$V"
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/action b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/action
new file mode 100755
index 0000000..0c9dbc2
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/action
@@ -0,0 +1,139 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# POST /cgi-bin/action (application/x-www-form-urlencoded), fields:
+#   token=<access code>  confirm=yes  action=<one of below> [+ its fields]
+#   wifi      ssid= psk= alias=   (each optional; empty = keep. SSID 1-32 printable ASCII without " or \,
+#                                  password 8-63 printable ASCII without " or \, Bluetooth name 1-32 [A-Za-z0-9 _-])
+#   forget    dev=<AA:BB:CC:DD:EE:FF>|all
+#   mode      to=auto|maintenance|aa
+#   aa-now | reboot | recovery
+# -> {"ok":true,"msg":"...","reboot":bool} or {"ok":false,"error":"...","code":"token|input|..."}
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+
+read_body
+need_token
+field confirm; [ "$FV" = yes ] || fail "not confirmed" confirm
+field action; ACT=$FV
+
+# one change at a time (from this UI; the service's 30 s saver is not part of this lock)
+exec 9> "$WEB/action.lock"
+command -v flock > /dev/null 2>&1 && { flock -n 9 || fail "another change is still running: try again in a moment" busy; }
+
+ok() { # ok MESSAGE [REBOOT]: fixed text from this script, plus the output of our own commands
+    hdr; printf '{"ok":true,"msg":%s,"reboot":%s}\n' "$(jstr "$1")" "${2:-false}"; exit 0
+}
+run() { # run CMD...: CMD's output (stdin /dev/null) into $OUT, logged
+    "$@" 9>&- < /dev/null > "$WEB/out.$$" 2>&1; _rc=$?
+    OUT=$(cat "$WEB/out.$$" 2> /dev/null); rm -f "$WEB/out.$$"
+    printf '%s\n' "$OUT" | sed "s/^/  $1: /" >> "$WEBLOG" 2> /dev/null
+    return $_rc
+}
+detach() { # detach CMD...: start CMD after this response is out, in its own session
+    if command -v setsid > /dev/null 2>&1; then
+        setsid sh -c 'sleep 1; exec "$@"' u2ac-web "$@" 9>&- < /dev/null > /dev/null 2>&1 &
+    else
+        sh -c 'sleep 1; exec "$@"' u2ac-web "$@" 9>&- < /dev/null > /dev/null 2>&1 &
+    fi
+}
+
+case $ACT in
+wifi)
+    field ssid; NS=; [ -n "$FV" ] && { NS=$(urldec "$FV") || fail "the Wi-Fi name has a character that is not allowed" input; }
+    field psk; NP=; [ -n "$FV" ] && { NP=$(urldec "$FV") || fail "the password has a character that is not allowed" input; }
+    field alias; NA=; [ -n "$FV" ] && { NA=$(urldec "$FV") || fail "the Bluetooth name has a character that is not allowed" input; }
+    [ -n "$NS$NP$NA" ] || fail "nothing to change" input
+    [ -z "$NS" ] || valid_ssid "$NS" || fail "Wi-Fi name: 1 to 32 characters, no \" or \\" input
+    [ -z "$NP" ] || valid_psk "$NP" || fail "password: 8 to 63 characters, no \" or \\" input
+    [ -z "$NA" ] || valid_alias "$NA" || fail "Bluetooth name: 1 to 32 letters, digits, spaces, _ or -" input
+    [ -s "$AACFG" ] || fail "no aa-proxy-rs config at /etc/aa-proxy-rs/config.toml" config
+    # current values fill what was left empty, so config.toml and the override always agree
+    CS=$(tomlget ssid "$AACFG"); CP=$(tomlget wpa_passphrase "$AACFG")
+    [ -s "$WIFI_OVR" ] && { _o=$(ovrget SSID); [ -n "$_o" ] && CS=$_o; _o=$(ovrget PSK); [ -n "$_o" ] && CP=$_o; }
+    : "${NS:=$CS}" "${NP:=$CP}"
+    valid_ssid "$NS" && valid_psk "$NP" || fail "the current Wi-Fi name or password is not valid: set both" input
+    # config.toml: replace the first `  ssid = `, `  wpa_passphrase = ` and (if given) `  btalias = ` lines
+    _new=$AACFG.web.$$
+    NS=$NS NP=$NP NA=$NA awk '
+        !s && index($0, "  ssid = \"") == 1 { print "  ssid = \"" ENVIRON["NS"] "\""; s = 1; next }
+        !p && index($0, "  wpa_passphrase = \"") == 1 { print "  wpa_passphrase = \"" ENVIRON["NP"] "\""; p = 1; next }
+        !a && ENVIRON["NA"] != "" && index($0, "  btalias = \"") == 1 { print "  btalias = \"" ENVIRON["NA"] "\""; a = 1; next }
+        { print }
+        END { if (!s || !p || (ENVIRON["NA"] != "" && !a)) exit 3 }' "$AACFG" > "$_new" \
+        || { rm -f "$_new"; fail "config.toml has no ssid / wpa_passphrase / btalias line to change" config; }
+    CFGCH=0
+    cmp -s "$_new" "$AACFG" || { mv -f "$_new" "$AACFG" && CFGCH=1; } || fail "could not write config.toml" config
+    rm -f "$_new"
+    # the override the service reads at boot (literal KEY=value lines, never sourced)
+    mkdir -p "$P"
+    _ov=$WEB/wifi.$$ OVRCH=0
+    (umask 077; printf 'SSID=%s\nPSK=%s\n' "$NS" "$NP" > "$_ov") || fail "could not write the Wi-Fi override" persist
+    cmp -s "$_ov" "$WIFI_OVR" 2> /dev/null || OVRCH=1
+    if [ $OVRCH = 1 ]; then mv -f "$_ov" "$WIFI_OVR" || fail "could not write /run/persist/u2ac-wifi.conf" persist; fi
+    rm -f "$_ov"
+    [ $CFGCH = 0 ] && [ $OVRCH = 0 ] && ok "Nothing changed: these are the current settings."
+    weblog "wifi/bt settings changed (ssid ${#NS} chars, alias ${NA:+set})"
+    # u2ac-aa persist writes the store when anything in /run/persist (override included) or config.toml changed
+    run u2ac-aa persist || fail "saved for this boot, but writing the persistent store failed (see the Service log)" persist
+    : > "$WEB/pending-reboot"
+    ok "Saved. Reboot the dongle to use the new settings, then reconnect your phone to the new Wi-Fi name." true
+    ;;
+forget)
+    field dev; D=$FV
+    [ "$D" = all ] || { D=$(urldec "$D") && valid_mac "$D"; } || fail "not a Bluetooth address" input
+    C=0
+    for _x in "$BTLIB"/*/[0-9A-F][0-9A-F]:??:??:??:??:??; do
+        [ -d "$_x" ] || continue
+        _dev=${_x##*/} _ad=${_x%/*}
+        valid_mac "$_dev" || continue
+        [ "$D" = all ] || [ "$D" = "$_dev" ] || continue
+        btm -i hci0 unpair "$_dev" > /dev/null 2>&1
+        rm -rf "$_x" "$_ad/cache/$_dev"
+        C=$((C + 1))
+    done
+    [ $C = 0 ] && fail "no such paired phone" input
+    # aa-proxy-rs's own list of phones it dials after a reboot (one address per line): drop them there too
+    KD=$R/etc/aa-proxy-rs/known_devices
+    if [ -f "$KD" ]; then
+        if [ "$D" = all ]; then : > "$KD"
+        else D=$D awk '{ l = $0; gsub(/[ \t\r]/, "", l); if (toupper(l) != ENVIRON["D"]) print }' "$KD" > "$KD.web" \
+            && mv -f "$KD.web" "$KD"; fi
+    fi
+    weblog "forgot $C paired device(s)"
+    run u2ac-aa persist || fail "forgotten for this boot, but writing the persistent store failed" persist
+    if [ $C = 1 ]; then ok "Forgot 1 phone. Remove the dongle from the phone's Bluetooth list too."
+    else ok "Forgot $C phones. Remove the dongle from each phone's Bluetooth list too."; fi
+    ;;
+mode)
+    field to
+    case $FV in
+        auto) A=off M="Automatic: Android Auto in the car, maintenance when a computer is on USB." ;;
+        maintenance) A=on M="Maintenance: USB stays a network link to the computer, Android Auto does not start." ;;
+        aa) A=aa M="Android Auto always, even with a computer on USB." ;;
+        *) fail "unknown mode" input ;;
+    esac
+    run u2ac-aa dev "$A" || fail "u2ac-aa dev $A failed" service
+    weblog "mode -> $FV"
+    ok "$M Applies from the next boot." true
+    ;;
+aa-now)
+    run u2ac-aa aa-now || fail "could not start Android Auto" service
+    weblog "aa-now"
+    case $OUT in *already*) ok "Android Auto is already running." ;; esac
+    ok "Android Auto is starting. A network link to a computer on USB goes away now."
+    ;;
+reboot)
+    run u2ac-aa persist
+    weblog "reboot"
+    detach reboot
+    ok "Rebooting. This page reconnects by itself in about 40 seconds." false
+    ;;
+recovery)
+    command -v reboot-recovery > /dev/null 2>&1 || fail "this build has no reboot-recovery" input
+    run u2ac-aa persist
+    weblog "reboot-recovery"
+    detach reboot-recovery
+    ok "Rebooting into recovery. This page will not answer until the normal system is back." false
+    ;;
+*) fail "unknown action" input ;;
+esac
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/logs b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/logs
