diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-aa b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-aa
new file mode 100755
index 0000000..d2d7a3d
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-aa
@@ -0,0 +1,645 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# u2ac-aa start|stop|status|persist|aa-now|dev on|off|aa|flightlog [last|SEQ]  (Carlinkit U2AC, milouk 2026-11-26)
+# Wireless Android Auto on mainline: BCM4358 Wi-Fi (brcmfmac) + BT (hci_bcm), a 5 GHz AP, DHCP, D-Bus,
+# BlueZ and aa-proxy-rs (aa-proxy/aa-proxy-rs v1.3.0, FunctionFS AOA gadget toward the car).
+#  - Calls / microphone: aa-proxy-rs only bootstraps over Bluetooth (AA Wireless RFCOMM + a log-only HSP
+#    stub); it never takes the phone's calls, so call audio and the mic stay between the phone and the
+#    car's own Bluetooth (the stock firmware needed hfpd killed for the same reason). The hands-free guard
+#    (patch 0004, aa_run) keeps a second, silent hands-free link to the phone so Android sends the car
+#    in-band ringing off: SYNC 3's own-ringtone mode loses the microphone of incoming calls otherwise.
+#  - Persistent state (pairings, aa-proxy-rs config + known devices) lives in /run/persist (the customer MTD
+#    archive, `persist save`), saved only when it changes.
+#  - USB port: at boot it first shows an Android phone (u2ac-usbprobe, board-rcS.sh): a CAR asks it AOA at once
+#    and never sees NCM. A COMPUTER (silent there, then it activates the NCM link and answers at
+#    192.168.50.100) keeps this boot in maintenance mode (NCM, ssh root@192.168.50.2, aa-proxy-rs not
+#    started); in the car aa-proxy-rs takes the UDC for Android Auto. `u2ac-aa dev on|off` forces it (persisted).
+#    The AP + ssh on 10.0.0.1 stay up in every mode.
+# bluetoothd lives in /usr/libexec/bluetooth (BlueZ layout), which busybox init's default PATH lacks
+export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/libexec/bluetooth
+. /lib/baseline/radio-lib.sh
+. /lib/baseline/mtd.sh
+P=/run/persist
+LOG=/run/log/u2ac-aa.log
+# cs: uptime in centiseconds (busybox date has 1 s resolution)
+cs() { read -r _u _ < /proc/uptime; _c=${_u#*.}; echo $(( ${_u%.*} * 100 + ${_c#0} )); }
+say() { _t=$(cut -d' ' -f1 /proc/uptime); echo "u2ac-aa: [$_t] $*"; echo "u2ac-aa: [$_t] $*" >> "$LOG"; }
+
+state_restore() {
+    # what the customer MTD holds (persist load just ran): the saver writes only when /run/persist differs.
+    # Taken before anything below adds to /run/persist (a new machine-id must reach flash too).
+    [ -s /run/persist.sig ] || sig "$P" > /run/persist.sig
+    mkdir -p /run/varlib/bluetooth /run/varlib/dbus /run/data/aa-proxy-rs /run/aa-etc /run/dbus /run/log
+    [ -d "$P/bluetooth" ] && cp -a "$P/bluetooth/." /run/varlib/bluetooth/
+    [ -d "$P/aa-data" ] && cp -a "$P/aa-data/." /run/data/aa-proxy-rs/
+    # /etc/aa-proxy-rs = /run/aa-etc: config.toml (web UI edits) + known_devices (the phones aa-proxy-rs
+    # dials after a reboot; without it every car start waits passively for the phone)
+    cp /usr/share/u2ac/aa-proxy-rs.config.toml /run/aa-etc/config.toml
+    [ -s "$P/aa-proxy-rs.config.toml" ] && cp "$P/aa-proxy-rs.config.toml" /run/aa-etc/config.toml
+    [ -d "$P/aa-etc" ] && cp -a "$P/aa-etc/." /run/aa-etc/
+    # aa-proxy-rs dials only the phones in known_devices, and records one only after a full BT handshake, a
+    # record the first car runs never got to flash (seen 2026-11-26: Pixel paired + persisted, known_devices
+    # empty = a manual connect at every car start). Every phone BlueZ holds a link key for goes in too.
+    for _i in /run/varlib/bluetooth/*/??:??:??:??:??:??/info; do
+        [ -f "$_i" ] && grep -q '^\[LinkKey\]' "$_i" || continue
+        _a=${_i%/info}; _a=${_a##*/}
+        grep -qix "$_a" /run/aa-etc/known_devices 2> /dev/null || echo "$_a" >> /run/aa-etc/known_devices
+    done
+    [ -s "$P/machine-id" ] || { mkdir -p "$P"; cat /proc/sys/kernel/random/uuid | tr -d - > "$P/machine-id"; }
+    cp "$P/machine-id" /run/varlib/dbus/machine-id
+    chmod 700 /run/varlib/bluetooth
+    # from now on the live dirs hold the archive's state: state_save may mirror them back (not before)
+    : > /run/u2ac-restored
+}
+
+# sig DIR: content signature (path list + file contents; NOT mtimes or modes, which change on every copy).
+# One md5sum for all files (-exec +), its lines sorted: same result whatever order find returns.
+sig() {
+    (cd "$1" 2>/dev/null || exit 0
+     find . | sort
+     find . -type f -exec md5sum {} + | sort) | md5sum | cut -d' ' -f1
+}
+
+# sync_dir SRC NAME: make $P/NAME a copy of SRC, touching $P/NAME only when the content differs.
+# A missing SRC changes nothing (an empty copy would replace the archived pairings/config).
+sync_dir() {
+    [ -d "$1" ] || return 0
+    _sd=/run/persist.next/$2
+    rm -rf "$_sd"; mkdir -p "$_sd"; cp -a "$1/." "$_sd/" 2>/dev/null
+    case $2 in
+        # BlueZ's per-device cache (SDP records etc.) is rebuilt on connect: not worth flash space/erases
+        bluetooth) rm -rf "$_sd"/*/cache ;;
+        # the shipped default config needs no flash (and keeping it would hide new defaults after an
+        # upgrade); sdr-ui-overrides.toml is aa-proxy-rs's auto-created MITM UI file (passthrough here)
+        aa-etc) cmp -s "$_sd/config.toml" /usr/share/u2ac/aa-proxy-rs.config.toml && rm -f "$_sd/config.toml"
+                rm -f "$_sd/sdr-ui-overrides.toml" ;;
+    esac
+    if [ "$(sig "$_sd")" != "$(sig "$P/$2")" ]; then rm -rf "$P/$2"; mv "$_sd" "$P/$2"; else rm -rf "$_sd"; fi
+}
+
+# state_save [force]: copy live state into /run/persist and write the archive only if /run/persist differs
+# from what was last written. One saver at a time (30 s loop, web UI, `u2ac-aa persist`); exit 1 = not saved.
+state_save() {
+    # never erase/write the NOR during a live AA session: every NOR erase stalls all rootfs reads
+    # (same chip) for ~0.4-2 s. 0x14A8 = port 5288, st 01 = ESTABLISHED. `force` (an explicit request) saves anyway.
+    if [ "${1:-}" != force ] && in_session; then
+        return 0
+    fi
+    (
+        exec 8> /run/u2ac-state.lock
+        flock 8
+        mkdir -p "$P" /run/persist.next
+        # before state_restore ran (e.g. the radios failed at boot and start() returned) the live dirs are
+        # not the archive's: save $P as loaded (flags like u2ac-dev included), never empty copies over it
+        if [ -e /run/u2ac-restored ]; then
+            sync_dir /run/varlib/bluetooth bluetooth
+            sync_dir /run/aa-etc aa-etc
+        fi
+        rm -rf /run/persist.next "$P/aa-data" "$P/aa-proxy-rs.config.toml"   # older layouts, never needed
+        _s=$(sig "$P")
+        [ "$_s" = "$(cat /run/persist.sig 2>/dev/null)" ] && exit 0
+        if persist save >> "$LOG" 2>&1; then
+            echo "$_s" > /run/persist.sig; say "state saved"
+        else
+            say "state save FAILED (persist save, see above)"; exit 1
+        fi
+    )
+}
+
+# mod_fast NAME [PARAMS]: load order from one awk pass, then insmod (radio-lib's mod_load forks ~600 times
+# for these five, ~1.5 s on the A7 at boot); radio-lib's mod_load if anything does not add up
+mod_fast() {
+    _m=$(echo "$1" | tr - _); shift
+    mod_loaded "$_m" && return 0
+    # NOT busybox modprobe: 1.38.0 insmods the module before its dependencies (radio-lib.sh; on the unit:
+    # "hci_uart: Unknown symbol" x34, then the slow fallback). One awk pass over /proc/modules + modules.dep
+    # (kmod lists a module's whole closure on its line) prints the still-missing modules in load order:
+    # "D path" for a dependency, "T path" for NAME (which gets the PARAMS). Anything odd: mod_load.
+    _ord=$(awk -v want="$_m" '
+        function nm(p) { sub(/:$/, "", p); sub(/.*\//, "", p); sub(/\.ko.*/, "", p); gsub(/-/, "_", p); return p }
+        FILENAME == ARGV[1] { have[$1] = 1; next }
+        { n = nm($1); k = $1; sub(/:$/, "", k); path[n] = k; dl[n] = ""
+          for (i = 2; i <= NF; i++) dl[n] = dl[n] " " nm($i) }
+        END {
+            if (!(want in path)) exit 1
+            c = split(want dl[want], T, " ")
+            for (pass = 0; pass < 64; pass++) {
+                left = 0; moved = 0
+                for (i = 1; i <= c; i++) {
+                    n = T[i]; if (n in have) continue
+                    if (!(n in path)) exit 1
+                    ok = 1; d = split(dl[n], D, " ")
+                    for (j = 1; j <= d; j++) if (!(D[j] in have)) { ok = 0; break }
+                    if (ok) { print (n == want ? "T " : "D ") path[n]; have[n] = 1; moved = 1 } else left = 1
+                }
+                if (!left) exit 0
+                if (!moved) exit 1
+            }
+            exit 1
+        }' "$MODLOAD_PROC" "$MODLOAD_DIR/modules.dep") && [ -n "$_ord" ] || { mod_load "$_m" "$@"; return; }
+    printf '%s\n' "$_ord" | while read -r _k _p; do
+        if [ "$_k" = T ]; then mod_insmod "$_p" "$@"; else mod_insmod "$_p"; fi || exit 1
+    done
+    mod_loaded "$_m" || mod_load "$_m" "$@"
+}
+
+radio_up() {
+    # brcmfmac + its vendor module (wcc) BEFORE the SDIO host (usdhc1): the host is not a modules.dep
+    # dependency of brcmfmac, and once it is up the chip enumerates and brcmfmac asks for wcc at once
+    # (rehearsal 2026-11-26: host first -> "brcmf_fwvid_request_module: mod=wcc: failed -2", no wlan0)
+    # feature_disable=0x10: no P2P (Wi-Fi Direct) interfaces; unused here
+    # hci_uart FIRST: the BT patch download runs in the kernel while Wi-Fi loads
+    # BT patch download at 3 Mbaud (kernel patch 0007), as the stock firmware does (brcm_patchram
+    # --use_baudrate_for_download): ~5 s -> ~1 s. If the chip ignores the early switch, hci_uart stays at
+    # 115200 (the vendor command fails, the host speed is not changed). Opt out: /run/persist/u2ac-bt-slowbaud
+    EB=bcm_force_early_baud=1; [ -e "$P/u2ac-bt-slowbaud" ] && EB=
+    # /run/persist/u2ac-bt-0092: use the newer Nexus 6P BT patch (BCM4358A3 Huawei N 0092, same config line
+    # as the stock 0082 but no AMPAK "LE HW config offset" record) instead of the stock one
+    if [ -e "$P/u2ac-bt-0092" ]; then
+        mkdir -p /run/fw/brcm && cp /lib/firmware/brcm/BCM4358A3-0092-nexus6p.hcd /run/fw/brcm/BCM4358A3.hcd \
+            && echo /run/fw > /sys/module/firmware_class/parameters/path
+    fi
+    # rfcomm explicitly: the AA Wireless bootstrap is an RFCOMM profile (bluetoothd opens its socket when
+    # aa-proxy-rs registers it); the kernel's bt-proto-3 autoload would work too, but not on a deadline
+    mod_fast hci_uart $EB && mod_fast rfcomm && mod_fast brcmfmac feature_disable=0x10 && mod_fast brcmfmac_wcc \
+        && mod_fast sdhci_esdhc_imx || return 1
+    n=0; while [ ! -e /sys/class/net/wlan0 ] && [ $n -lt 200 ]; do sleep 0.05; n=$((n + 1)); done
+    n=0; while [ ! -e /sys/class/bluetooth/hci0 ] && [ $n -lt 200 ]; do sleep 0.05; n=$((n + 1)); done
+    iw reg set GR 2>/dev/null
+    [ -e /sys/class/net/wlan0 ] && [ -e /sys/class/bluetooth/hci0 ]
+}
+
+ap_up() {
+    ip link set wlan0 down 2>/dev/null
+    # 40 MHz by default: AA video needs well under 50 Mbit/s and a 2x2 HT40/VHT40 AP gives ~300; 80 MHz costs
+    # ~40 mA more just listening (CYW4354 figures, audit/ROUND2_POWER.md). Opt in: /run/persist/u2ac-wifi-80
+    # (used only when the firmware's locale offers VHT80 on ch36, DT brcm,ccode-map GR/4)
+    HC=/usr/share/u2ac/hostapd.conf
+    [ -e "$P/u2ac-wifi-80" ] && iw phy "$(cat /sys/class/net/wlan0/phy80211/name)" channels 2>/dev/null \
+        | grep -A3 '5180 MHz' | grep -q VHT80 && HC=/usr/share/u2ac/hostapd-80.conf
+    # Wi-Fi name/password set from the web UI (/run/persist/u2ac-wifi.conf, SSID= / PSK= lines, validated by
+    # the UI): read literally, never sourced; aa-proxy-rs's config.toml carries the same values for the phone
+    W=$P/u2ac-wifi.conf
+    if [ -s "$W" ]; then
+        S=$(sed -n 's/^SSID=//p' "$W" | head -n 1); K=$(sed -n 's/^PSK=//p' "$W" | head -n 1)
+        if [ -n "$S" ] && [ ${#S} -le 32 ] && [ ${#K} -ge 8 ] && [ ${#K} -le 63 ]; then
+            grep -v -e '^ssid=' -e '^wpa_passphrase=' "$HC" > /run/hostapd.conf
+            printf 'ssid=%s\nwpa_passphrase=%s\n' "$S" "$K" >> /run/hostapd.conf
+            HC=/run/hostapd.conf
+        fi
+    fi
+    say "AP config ${HC##*/}"
+    : > /run/log/hostapd.log
+    hostapd -B -P /run/hostapd.pid -f /run/log/hostapd.log "$HC" || return 1
+    # ready = the control interface reports state=ENABLED (the -f log needs CONFIG_DEBUG_FILE, so it is
+    # only for reading, never the readiness test); max 15 s. The IP, DHCP, web UI and ssh below come up
+    # either way, so a slow 20/40 scan never leaves the AP without an address.
+    rc=1; n=0
+    while [ $n -lt 60 ]; do
+        hostapd_cli -p /run/hostapd -i wlan0 status 2>/dev/null | grep -q '^state=ENABLED' && { rc=0; break; }
+        sleep 0.25; n=$((n + 1))
+    done
+    echo -500 > /proc/$(cat /run/hostapd.pid 2>/dev/null)/oom_score_adj 2>/dev/null
+    # heat/battery: 14 dBm is plenty inside a car (nvram max 16.5 dBm on 5 GHz)
+    # a LIMIT, not "fixed" (fixed sets an override that bypasses the firmware's per-rate limits)
+    iw dev wlan0 set txpower limit 1400 2>/dev/null
+    ip addr add 10.0.0.1/24 dev wlan0 2>/dev/null
+    ip link set wlan0 up
+    udhcpd /usr/share/u2ac/udhcpd-wlan.conf
+    # web UI (busybox httpd + CGI) on the AP, and on the USB link when a computer brought NCM up
+    httpd -p 10.0.0.1:80 -h /usr/share/u2ac/www && echo "$(pgrep -n -x httpd)" > /run/httpd-wlan.pid
+    usb_httpd
+    # ssh over the AP too (same keys/host key as the NCM dropbear)
+    # KEY-ONLY on the AP (-s: no password logins): the AP password is the well-known vendor default and the
+    # root password the documented dev default, so a password login here would be root for anyone in range.
+    # The USB link (physical access) keeps key OR password (ssh-up on 192.168.50.2).
+    # host key: the persisted one, else ssh-up's ephemeral one, else one made here in RAM (first boot,
+    # before ssh-up made it; `-R` cannot work: dropbear has to save that key under the read-only /etc)
+    K=
+    for k in "$P/dropbear_ed25519_host_key" /run/dropbear/ephemeral_ed25519_host_key; do
+        [ -s "$k" ] && { K=$k; break; }
+    done
+    if [ -z "$K" ]; then
+        mkdir -p /run/dropbear; K=/run/dropbear/ap_ed25519_host_key
+        [ -s "$K" ] || dropbearkey -t ed25519 -f "$K" > /dev/null 2>&1
+    fi
+    dropbear -E -s -r "$K" -p 10.0.0.1:22 -P /run/dropbear-wlan.pid 2>> /run/log/dropbear.log
+    return $rc
+}
+
+bt_up() {
+    # stable public BD address, derived like the vendor did (38:BA:B0 + the Wi-Fi MAC's last 3 bytes)
+    # (the sysfs hci0 node appears before the controller finishes its patch/setup: wait for mgmt to answer,
+    # else public-addr fails silently and the chip default 43:58:A3:... stays)
+    # btmgmt (BlueZ 5.87) reads a non-tty stdin as a command script: from /dev/null it quits before the reply
+    # (no output), and at boot one call hung for good (seen on the unit). An open, empty FIFO as stdin makes it
+    # answer and exit deterministically (~10 ms); the timeout bounds any hang. fd 9 is closed before bluetoothd.
+    rm -f /run/btmgmt.in; mkfifo /run/btmgmt.in && exec 9<> /run/btmgmt.in
+    mg() { timeout 3 btmgmt -i hci0 "$@" <&9 2>/dev/null; }
+    n=0; until mg info | grep -q 'current settings'; do
+        [ $n -ge 40 ] && break; sleep 0.25; n=$((n + 1)); done
+    m=$(cat /sys/class/net/wlan0/address 2>/dev/null)
+    [ -n "$m" ] && mg power off > /dev/null && mg public-addr "38:BA:B0:${m#??:??:??:}" > /dev/null
+    exec 9<&-; rm -f /run/btmgmt.in
+    # a restart (stop, then start without a reboot): dbus-daemon refuses to start over its stale pid file
+    pgrep -x dbus-daemon > /dev/null || { rm -f /run/dbus-daemon.pid; dbus-daemon --system --fork; } || return 1
+    for d in dbus-daemon; do echo -500 > /proc/$(pgrep -n -x $d)/oom_score_adj 2>/dev/null; done
+    : > /run/log/bluetoothd.log
+    /usr/libexec/bluetooth/bluetoothd -n >> /run/log/bluetoothd.log 2>&1 &
+    echo -500 > /proc/$!/oom_score_adj 2>/dev/null
+    # ready when bluetoothd has taken the adapter ("Bluetooth management interface 1.x initialized"),
+    # max 5 s; its failure line "Failed to access management interface" must not count as ready
+    n=0; until grep -q 'management interface .* initialized' /run/log/bluetoothd.log 2>/dev/null; do
+        grep -q 'Failed to access management' /run/log/bluetoothd.log 2>/dev/null && return 1
+        [ $n -ge 20 ] && break; sleep 0.25; n=$((n + 1)); done
+    pgrep -x bluetoothd > /dev/null
+}
+
+# The boot's USB probe ran first (board-rcS.sh board_usb_probe, u2ac-usbprobe): the port showed an Android
+# phone, and a car asks it AOA GET_PROTOCOL at once (car), or nobody configured it (none, after ~10 s): no
+# computer, and the car never saw NCM. Otherwise (noaoa: a host that stayed silent, dev, failed, no probe):
+# a computer activates the NCM data interface (carrier) and answers ARP/ping at the host address it got
+# by DHCP; a car head unit has no NCM driver, so carrier stays 0 there. Runs in parallel with the radios.
+# Its stdout is the verdict file: log with say ... > /dev/null.
+computer_on_usb() {
+    t=$(cs)
+    if command -v u2ac-usbprobe > /dev/null 2>&1; then
+        until [ -s /run/u2ac-usbprobe ]; do [ $(($(cs) - t)) -ge 2000 ] && break; sleep 0.1; done
+    fi
+    _pv=$(cat /run/u2ac-usbprobe 2> /dev/null)
+    say "usb probe: ${_pv:-no verdict} ($(tr '\n' ' ' < /run/log/u2ac-usbprobe.log 2> /dev/null))" > /dev/null
+    case $_pv in car | none) return 1 ;; esac
+    # wait for rcS's NCM bring-up (usb0 with its address, max 10 s)
+    t=$(cs)
+    until ip -4 addr show usb0 2>/dev/null | grep -q 192.168.50.2; do
+        [ $(($(cs) - t)) -ge 1000 ] && return 1; sleep 0.05; done
+    # A computer configures the gadget and activates the NCM data interface (carrier) about a second after it
+    # sees it; a head unit has no NCM driver. Decide from the UDC state (usbotg2 = 2184200.usb):
+    #   configured, but no carrier 3 s later -> a car;  never configured within 2.5 s -> nobody / a car
+    U=; for u in /sys/class/udc/*; do case $(readlink -f "$u") in */2184200.usb/*) U=$u ;; esac; done
+    t=$(cs); tc=
+    until [ "$(cat /sys/class/net/usb0/carrier 2>/dev/null)" = 1 ]; do
+        now=$(cs)
+        [ -z "$tc" ] && [ "$(cat "$U/state" 2>/dev/null)" = configured ] && tc=$now
+        if [ -n "$tc" ]; then [ $((now - tc)) -ge 300 ] && return 1
+        else [ $((now - t)) -ge 250 ] && return 1; fi
+        sleep 0.05
+    done
+    # ARP first: a host firewall (Windows by default, macOS stealth mode) drops ping but always answers ARP
+    for _i in 1 2 3; do
+        arping -q -f -c 1 -w 1 -I usb0 192.168.50.100 > /dev/null 2>&1 && return 0
+        ping -c 1 -W 1 192.168.50.100 > /dev/null 2>&1 && return 0
+    done
+    return 1
+}
+
+# usb_httpd: the web UI on the USB link, once NCM has its address. Called from ap_up and again when a
+# computer was found (ap_up's moment can be too early: the USB probe delays NCM, a late host gets it after
+# the AP is up, and a failed hostapd returns before ap_up gets here). One instance.
+usb_httpd() {
+    [ -s /run/httpd-usb.pid ] && kill -0 "$(cat /run/httpd-usb.pid)" 2> /dev/null && return 0
+    ip -4 addr show usb0 2>/dev/null | grep -q 192.168.50.2 || return 1
+    httpd -p 192.168.50.2:80 -h /usr/share/u2ac/www && echo "$(pgrep -n -x httpd)" > /run/httpd-usb.pid
+}
+
+# aa-proxy-rs supervised: restarted if it dies, protected from the OOM killer, slight CPU priority
+aa_run() {
+    (
+        echo -900 > /proc/self/oom_score_adj
+        read -r me _ < /proc/self/stat; renice -n -10 -p "$me" > /dev/null 2>&1
+        # FunctionFS transfer size (our aa-proxy-rs patch). Field fallback without a rebuild: a head unit that
+        # resets on transfer errors (VAG, aa-proxy-rs #131/#144) -> `echo 512 > /run/persist/u2ac-ffs-chunk`
+        _c=; [ -s "$P/u2ac-ffs-chunk" ] && read -r _c < "$P/u2ac-ffs-chunk"
+        case $_c in 512 | 1024 | 2048 | 4096 | 8192 | 16384) AA_FFS_CHUNK=$_c ;; esac
+        export AA_FFS_CHUNK=${AA_FFS_CHUNK:-16384}
+        # hands-free guard (aa-build patch 0004): after the Bluetooth bootstrap the dongle stays connected as a
+        # silent second hands-free unit (never active, no calls), so Android turns in-band ringing off for the
+        # car (SYNC 3 on its own ringtone drops the microphone of incoming calls otherwise). Off:
+        # `: > /run/persist/u2ac-hfp-guard-off; persist save`
+        [ -e "$P/u2ac-hfp-guard-off" ] || export AA_HFP_GUARD=1
+        cd /run/data
+        # restart at once after a crash in a long run (2 s), back off up to 30 s when it keeps dying young (a
+        # bad config would otherwise start the 15 MB binary every 2 s on the single core all drive)
+        _d=2
+        while :; do
+            _t0=$(cs)
+            # its info lines already go to /var/log/aa-proxy-rs.log (config logfile); the terminal logger
+            # writes info to stdout and warn/error (+ panics) to stderr: keep only stderr here, not a 2nd copy
+            aa-proxy-rs > /dev/null 2>> /run/log/aa-proxy-rs.console
+            _rc=$?
+            [ $(($(cs) - _t0)) -ge 6000 ] && _d=2
+            say "aa-proxy-rs exited ($_rc), restarting in $_d s"
+            sleep $_d
+            _d=$((_d * 2)); [ $_d -gt 30 ] && _d=30
+        done
+    ) &
+    echo $! > /run/aa-proxy-rs.pid
+}
+
+# cpu_mode session|normal. An AA session: full speed, and no LOW-POWER-IDLE (cpuidle state2 flushes L1+L2 on
+# every entry and takes 300 us to wake, on every IRQ-driven wakeup of the relay; ondemand would also settle at
+# 198-396 MHz at relay loads, audit/ROUND2_PERFORMANCE.md). Otherwise ondemand with every idle state.
+cpu_mode() {
+    if [ "$1" = session ]; then _g=performance _d=1; else _g=ondemand _d=0; fi
+    for _x in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo $_g > "$_x"; done 2> /dev/null
+    for _x in /sys/devices/system/cpu/cpu*/cpuidle/state2/disable; do echo $_d > "$_x"; done 2> /dev/null
+    if [ $_g = ondemand ]; then
+        _o=/sys/devices/system/cpu/cpufreq/ondemand
+        [ -d $_o ] && { echo 50 > $_o/up_threshold; echo 10 > $_o/sampling_down_factor; } 2> /dev/null
+    fi
+    say "cpu: $1 ($_g)"
+}
+
+# in_session: a phone holds the AA TCP session (port 5288 = 0x14A8, state 01 ESTABLISHED)
+in_session() { grep -qiE '^ *[0-9]+: [0-9A-F]+:14A8 [0-9A-F:]+ 01 ' /proc/net/tcp /proc/net/tcp6 2> /dev/null; }
+# car_live: the car took the accessory (aa-proxy-rs's 18d1:2d00 gadget configured) while the phone is in
+# session: Android Auto is on the car's screen. in_session alone = the phone came, the car has not switched yet.
+car_live() {
+    in_session && grep -qx 0x2d00 /sys/kernel/config/usb_gadget/*/idProduct 2> /dev/null \
+        && grep -qx configured /sys/class/udc/*/state 2> /dev/null
+}
+# bt_key: changes when a phone is paired/removed or aa-proxy-rs records a known phone (rare, and lost with the
+# ignition if not saved at once: the first pairing happens right before the session that would block the save)
+bt_key() {
+    { ls -d /run/varlib/bluetooth/*/??:??:??:??:??:?? 2> /dev/null; cat /run/aa-etc/known_devices 2> /dev/null; } | md5sum
+}
+
+# status light: the WS2812B on GPIO1_IO03 (module u2ac-ws2812, /sys/class/leds/rgb:status) in the stock
+# firmware's colours (2024.10.31 /etc/rgbLight.conf): StartUp 7e172b, BtConnecting 005f7f 500/100,
+# BtConnected 00007f 300/100 (here: the phone is in, the car has not switched to Android Auto yet),
+# HULinkSuccess 003b00 (stock blinks it 1000/1000; steady here since 2026-11-27: Android Auto is on the car's
+# screen, a blink read as "still connecting" in the car), Fault 69480f 1000/500; maintenance (not stock) dim white.
+# led RRGGBB [ON_MS OFF_MS]: steady, or blinking by the kernel's timer trigger (no wakeups of ours).
+# /run/persist/u2ac-led-off: dark (the LED draws ~5-20 mA lit).
+LEDD=/sys/class/leds/rgb:status
+led() {
+    [ -d "$LEDD" ] || return 0
+    [ -e "$P/u2ac-led-off" ] && set -- 000000
+    echo none > "$LEDD/trigger"; echo "$1" > "$LEDD/color"; echo 255 > "$LEDD/brightness"
+    [ -n "${2:-}" ] || return 0
+    echo timer > "$LEDD/trigger" && echo "$2" > "$LEDD/delay_on" && echo "$3" > "$LEDD/delay_off"
+} 2> /dev/null
+# led_state: the colour for "no session" (AA waiting for the phone, or maintenance)
+led_state() { if pgrep -x aa-proxy-rs > /dev/null; then led 005f7f 500 100; else led 404040; fi; }
+
+# cap_logs: the RAM logs (tmpfs /run) stay under 1 MiB each, the newest 256 KiB kept. Every writer appends
+# (O_APPEND), so after the in-place rewrite it goes on writing at the new end. aa-proxy-rs alone logs ~4 MB/day
+# while it pages an absent phone (audit/ROUND2_POWER.md).
+cap_logs() {
+    for _f in /run/log/*.log /run/log/*.console; do
+        [ -f "$_f" ] || continue
+        [ "$(wc -c < "$_f")" -gt 1048576 ] || continue
+        tail -c 262144 "$_f" > "$_f.cap" && cat "$_f.cap" > "$_f"
+        rm -f "$_f.cap"
+    done
+}
+
+# flight recorder: the car-mode logs, kept across the power cut that ends every drive (/run is RAM).
+# Area: the last 1 MiB of the 'rootfs' MTD. The squashfs reads only up to its bytes_used (~10 MB of 12.4) and
+# the U2AC has no OCBM overlay region there (board.env), the same disjointness ocbm-overlay relies on, checked
+# before every write. 8 slots of 128 KiB, the oldest reused; a slot = a 512-byte header line
+# "U2AC-FLIGHTLOG 1 seq=N up=S why=W bytes=N" (NUL padded) + a gzip of the logs. Car mode only, at most 40 per
+# boot. Read it from maintenance mode: `u2ac-aa flightlog` (list), `u2ac-aa flightlog last|SEQ` (print).
+# /run/persist/u2ac-flightlog-off: never written. FL_ERASE (DEVICE OFFSET BLOCKS) replaces flash_erase in the
+# emulated selftest (MTD_SYS/MTD_DEV point mtd.sh at plain files there).
+# the area size is board.env's FLIGHTLOG_SIZE, which build.sh keeps the squashfs out of
+FL_AREA=$(sed -n 's/^FLIGHTLOG_SIZE=\([0-9][0-9]*\).*/\1/p' /etc/baseline/board.env 2> /dev/null)
+FL_AREA=${FL_AREA:-1048576} FL_SLOT=131072 FL_HDR=512
+FL_ERASE=${FL_ERASE:-flash_erase -q}
+fl_dev() {
+    _n=$(mtd_num rootfs) || return 1
+    _psz=$(mtd_attr "$_n" size); _es=$(mtd_attr "$_n" erasesize)
+    FL_D=$MTD_DEV/mtd$_n; FL_OFF=$((${_psz:-0} - FL_AREA))
+    [ "$_es" = 65536 ] && [ "$FL_OFF" -gt 0 ] || return 1
+    # squashfs superblock: magic "hsqs" at 0, bytes_used (le64) at 40: it must end before the area
+    [ "$(hexdump -v -n 4 -e '4/1 "%02x"' "$FL_D" 2> /dev/null)" = 68737173 ] || return 1
+    _u=$(hexdump -v -s 40 -n 4 -e '1/4 "%u"' "$FL_D" 2> /dev/null)
+    _hi=$(hexdump -v -s 44 -n 4 -e '1/4 "%u"' "$FL_D" 2> /dev/null)
+    [ "$_hi" = 0 ] && [ -n "$_u" ] && [ $(((_u + 65535) / 65536 * 65536)) -le "$FL_OFF" ]
+}
+# fl_hdr I: slot I's header line ("" when erased or foreign)
+fl_hdr() {
+    dd if="$FL_D" bs=512 skip=$(((FL_OFF + $1 * FL_SLOT) / 512)) count=1 2> /dev/null | tr -d '\000\377' \
+        | head -n 1 | grep '^U2AC-FLIGHTLOG 1 seq=[0-9]* '
+}
+fl_field() { echo "$1" | sed -n "s/.* $2=\([^ ]*\).*/\1/p"; }
+fl_lastseq() {
+    _m=0; _i=0
+    while [ $_i -lt 8 ]; do
+        _s=$(fl_field "$(fl_hdr $_i)" seq); [ -n "$_s" ] && [ "$_s" -gt $_m ] && _m=$_s; _i=$((_i + 1))
+    done
+    echo $_m
+}
+fl_bundle() { # BYTES_OF_AA_LOG: the text that goes into a slot (gzip'd by the caller)
+    echo "=== u2ac flight log: up $(cut -d' ' -f1 /proc/uptime) s, $(cat /proc/version)"
+    echo "=== status"; "$0" status 2>&1
+    echo "=== usb: $(cat /sys/class/udc/*/state 2> /dev/null) gadget $(cat /sys/kernel/config/usb_gadget/*/idProduct 2> /dev/null | tr '\n' ' ')"
+    echo "=== tcp"; cat /proc/net/tcp 2> /dev/null
+    echo "=== stations"; iw dev wlan0 station dump 2> /dev/null | grep -E 'Station|signal:|connected time|rx bitrate'
+    echo "=== u2ac-aa.log"; tail -c 65536 "$LOG" 2> /dev/null
+    echo "=== aa-proxy-rs.console"; tail -c 32768 /run/log/aa-proxy-rs.console 2> /dev/null
+    echo "=== aa-proxy-rs.log (last $1 B)"; tail -c "$1" /run/log/aa-proxy-rs.log 2> /dev/null
+    echo "=== bluetoothd.log"; tail -c 32768 /run/log/bluetoothd.log 2> /dev/null
+    echo "=== hostapd.log"; tail -c 16384 /run/log/hostapd.log 2> /dev/null
+    echo "=== dmesg"; dmesg 2> /dev/null | tail -c 49152
+}
+fl_write() { # WHY
+    [ -e "$P/u2ac-flightlog-off" ] && return 0
+    [ "${FL_N:-0}" -ge 40 ] && return 0
+    fl_dev || { say "flight log: no safe area in the rootfs MTD, not recording"; FL_N=99; return 1; }
+    [ -n "${FL_SEQ:-}" ] || FL_SEQ=$(fl_lastseq)
+    FL_SEQ=$((FL_SEQ + 1)); _off=$((FL_OFF + (FL_SEQ % 8) * FL_SLOT))
+    _b=786432
+    while :; do
+        fl_bundle $_b | gzip -c > /run/fl.gz
+        [ "$(wc -c < /run/fl.gz)" -le $((FL_SLOT - FL_HDR)) ] && break
+        [ $_b -le 16384 ] && { rm -f /run/fl.gz; return 1; }
+        _b=$((_b / 2))
+    done
+    _l="U2AC-FLIGHTLOG 1 seq=$FL_SEQ up=$(cut -d. -f1 /proc/uptime) why=$1 bytes=$(wc -c < /run/fl.gz)"
+    { echo "$_l"; head -c $((FL_HDR - ${#_l} - 1)) /dev/zero; cat /run/fl.gz; } > /run/fl.slot
+    rm -f /run/fl.gz
+    # never outside [area, end of the MTD): the squashfs lies below FL_OFF (fl_dev checked its bytes_used)
+    [ "$_off" -ge "$FL_OFF" ] && [ $((_off + FL_SLOT)) -le "$_psz" ] && [ $((_off % 65536)) = 0 ] \
+        || { say "flight log: slot offset $_off outside the area, not written"; FL_N=99; rm -f /run/fl.slot; return 1; }
+    # a slot fl_prep erased ahead of time (and still all 0xFF) is only programmed here: no erase stall now
+    if { fl_erased "$_off" || $FL_ERASE "$FL_D" "$_off" 2; } \
+        && dd if=/run/fl.slot of="$FL_D" bs=512 seek=$((_off / 512)) conv=notrunc 2> /dev/null
+    then FL_N=$((${FL_N:-0} + 1)); say "flight log: seq $FL_SEQ ($1) recorded"
+    else say "flight log: write of seq $FL_SEQ FAILED"; fi
+    rm -f /run/fl.slot
+}
+# fl_erased OFF: the 128 KiB slot at OFF reads all 0xFF
+fl_erased() {
+    [ "$(dd if="$FL_D" bs=65536 skip=$(($1 / 65536)) count=2 2> /dev/null | tr -d '\377' | head -c 1 | wc -c)" = 0 ]
+}
+# fl_prep: erase the slot the next fl_write uses ahead of time, called only outside a session (every NOR erase
+# stalls all rootfs reads for 0.4-2 s), so the write 60 s into a live session only programs pages. Once per slot.
+fl_prep() {
+    [ -e "$P/u2ac-flightlog-off" ] && return 0
+    [ "${FL_N:-0}" -ge 40 ] && return 0
+    [ -n "${FL_OFF:-}" ] || fl_dev || return 1
+    [ -n "${FL_SEQ:-}" ] || FL_SEQ=$(fl_lastseq)
+    _no=$((FL_OFF + ((FL_SEQ + 1) % 8) * FL_SLOT))
+    [ "${FL_PREP:-}" = "$_no" ] && return 0
+    [ "$_no" -ge "$FL_OFF" ] && [ $((_no + FL_SLOT)) -le "$_psz" ] && [ $((_no % 65536)) = 0 ] || return 1
+    fl_erased "$_no" || $FL_ERASE "$FL_D" "$_no" 2 || return 1
+    FL_PREP=$_no
+}
+flightlog() { # [last|SEQ]
+    fl_dev || { echo "flight log: no area (rootfs MTD / squashfs check failed)" >&2; return 1; }
+    _want=${1:-}; [ "$_want" = last ] && _want=$(fl_lastseq)
+    _i=0
+    while [ $_i -lt 8 ]; do
+        _h=$(fl_hdr $_i)
+        if [ -z "$_want" ]; then [ -n "$_h" ] && echo "$_h"
+        elif [ "$(fl_field "$_h" seq)" = "$_want" ]; then
+            _n=$(fl_field "$_h" bytes)
+            dd if="$FL_D" bs=512 skip=$(((FL_OFF + _i * FL_SLOT + FL_HDR) / 512)) count=$(((_n + 511) / 512)) 2> /dev/null \
+                | head -c "$_n" | gunzip -c
+            return
+        fi
+        _i=$((_i + 1))
+    done
+    [ -z "$_want" ] || { echo "flight log: no seq $_want" >&2; return 1; }
+}
+
+start() {
+    : > "$LOG"
+    say "start"
+    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g" 2>/dev/null; done
+    echo 1 > /proc/sys/vm/overcommit_memory   # aa-proxy-rs reserves ~1 GiB of address space up front
+    echo 4096 > /proc/sys/vm/min_free_kbytes  # keep atomic-allocation headroom for SDIO/USB/net (no compaction)
+    mount -o remount,size=24m /tmp 2>/dev/null
+    # rcS loads the persist archive in parallel with us (it writes /run/persist.loaded; ~0.1 s); max 10 s
+    n=0; until [ -e /run/persist.loaded ] || [ $n -ge 200 ]; do sleep 0.05; n=$((n + 1)); done
+    mod_fast u2ac_ws2812 > /dev/null 2>&1 && led 7e172b
+    # car or computer on USB: decided in parallel with the radios (its window no longer adds to the boot)
+    rm -f /run/u2ac-usbhost
+    # A car with NCM on the port (the probe could not tell: no AOA within 3 s) gets the port emptied at once,
+    # not ~20 s later when aa-proxy-rs takes it (SYNC 3 shows "USB device not supported" while NCM is there).
+    # Dev mode keeps NCM.
+    ( if computer_on_usb; then echo computer
+      else
+          _g=/sys/kernel/config/usb_gadget/baseline/UDC
+          if [ ! -e "$P/u2ac-dev" ] && [ -n "$(cat "$_g" 2> /dev/null)" ]; then
+              echo "" > "$_g" 2> /dev/null && say "USB: NCM off the port (no computer on it)" > /dev/null
+          fi
+          echo car
+      fi > /run/u2ac-usbhost ) &
+    cup=$!
+    # page the 15 MB aa-proxy-rs into the cache while the radios load (xz squashfs: it would otherwise be
+    # read and decompressed on the critical path when it starts); low priority, wasted only in dev mode
+    [ -e "$P/u2ac-dev" ] || ( read -r me _ < /proc/self/stat; renice -n 10 -p "$me" > /dev/null 2>&1
+                              cat /usr/bin/aa-proxy-rs > /dev/null ) &
+    radio_up || { say "radio did not come up (dmesg)"; led 69480f 1000 500; return 1; }
+    say "radios up"
+    state_restore
+    # BT bring-up (D-Bus, bluetoothd) in parallel with the AP
+    bt_up &
+    btp=$!
+    fault=0
+    if ap_up; then say "AP up"; else say "AP did not come up (/run/log/hostapd.log)"; fault=1; fi
+    if wait $btp; then say "BT up"; else say "D-Bus/BlueZ did not start (/run/log/bluetoothd.log)"; fault=1; fi
+    if [ -e "$P/u2ac-dev" ]; then
+        say "dev mode (forced): USB stays NCM (ssh root@192.168.50.2), aa-proxy-rs not started"
+    elif [ ! -e "$P/u2ac-aa-force" ] && wait $cup && [ "$(cat /run/u2ac-usbhost 2> /dev/null)" = computer ]; then
+        say "a computer is on the USB port: maintenance mode for this boot (NCM, ssh root@192.168.50.2); aa-proxy-rs not started"
+        usb_httpd || say "web UI on USB not started (no 192.168.50.2 on usb0)"
+    else
+        aa_run
+        say "aa-proxy-rs started (USB = Android Auto toward the car; ssh root@10.0.0.1 over AutoKit)"
+    fi
+    # steady state, one low-priority loop: every 5 s the CPU follows the AA session (cpu_mode); every 30 s
+    # new pairings/settings are persisted (only when changed, never during a session) and the RAM logs capped
+    cpu_mode normal
+    if [ $fault = 1 ]; then led 69480f 1000 500; else led_state; fi
+    # the light: phone in + car switched = green; phone in, car not (yet) = blue; else led_state.
+    # Flight recorder (car mode, aa-proxy-rs ours): 90 s after start, 60 s into each live session, 5 s after a
+    # session ends, and every 2 min while there is no live session if the aa-proxy-rs log grew.
+    (
+        read -r me _ < /proc/self/stat; renice -n 19 -p "$me" > /dev/null 2>&1
+        # idle states carry whether aa-proxy-rs runs (idle1 cyan / idle0 white): the light follows it when it is
+        # started or stopped outside a session (aa-now, a test run), not only at session changes
+        ar() { pgrep -x aa-proxy-rs > /dev/null && echo 1 || echo 0; }
+        m=normal; k=0; lit=idle$(ar); [ $fault = 1 ] && lit=fault; bk=$(bt_key); live=0; fl_at=18; fl_sz=
+        while :; do
+            sleep "${U2AC_TICK:-5}"; k=$((k + 1))   # U2AC_TICK: the selftest's fast clock
+            if in_session; then [ $m = session ] || { m=session; cpu_mode session; }
+            elif [ $m = session ]; then m=normal; cpu_mode normal; fi
+            # a start-up fault (radio/AP/BT) stays amber until a phone session shows things work after all
+            if car_live; then st=live; elif [ $m = session ]; then st=phone; elif [ $fault = 1 ]; then st=fault
+            else st=idle$(ar); fi
+            [ $st = live ] && fault=0
+            if [ $st != $lit ]; then
+                case $st in live) led 003b00 ;; phone) led 00007f 300 100 ;; fault) led 69480f 1000 500 ;;
+                    *) led_state ;; esac
+                lit=$st
+            fi
+            # a new pairing / known phone: to flash now, even in a session (state_save force)
+            _b=$(bt_key); [ "$_b" = "$bk" ] || { state_save force && bk=$_b; }
+            [ $((k % 6)) = 0 ] && { state_save; cap_logs; }
+            if [ -s /run/aa-proxy-rs.pid ]; then
+                if [ $st = live ]; then
+                    [ $live = 0 ] && { live=1; fl_at=$((k + 12)); fl_why=session+60s; }
+                elif [ $live = 1 ]; then live=0; fl_at=$((k + 1)); fl_why=session-end
+                elif [ $((k % 24)) = 0 ]; then
+                    _s=$(wc -c < /run/log/aa-proxy-rs.log 2> /dev/null)
+                    [ "${_s:-0}" != "${fl_sz:-0}" ] && { fl_at=$k; fl_why=periodic; }
+                fi
+                if [ "$fl_at" = "$k" ]; then
+                    fl_write "${fl_why:-start+90s}"; fl_sz=$(wc -c < /run/log/aa-proxy-rs.log 2> /dev/null)
+                fi
+                # outside a session: the next slot erased already (no I/O once it is)
+                [ $m = session ] || fl_prep
+            fi
+        done
+    ) &
+    echo $! > /run/u2ac-saver.pid
+}
+
+stop() {
+    for f in /run/u2ac-saver.pid /run/aa-proxy-rs.pid /run/hostapd.pid /run/udhcpd-wlan.pid /run/dropbear-wlan.pid \
+             /run/httpd-wlan.pid /run/httpd-usb.pid; do
+        [ -s "$f" ] && kill "$(cat "$f")" 2>/dev/null; rm -f "$f"
+    done
+    killall aa-proxy-rs bluetoothd dbus-daemon httpd 2>/dev/null
+    rm -f /run/dbus-daemon.pid
+    led 000000
+    state_save force
+}
+
+case ${1:-} in
+    start) start ;;
+    stop) stop ;;
+    persist) state_save force || exit 1 ;;
+    flightlog) flightlog "${2:-}" ;;
+    aa-now)
+        # start Android Auto now, from maintenance mode (the NCM link to the computer goes away). The supervisor
+        # counts, not only the process: between two of its restarts no aa-proxy-rs runs for a moment
+        if { [ -s /run/aa-proxy-rs.pid ] && kill -0 "$(cat /run/aa-proxy-rs.pid)" 2> /dev/null; } \
+            || pgrep -x aa-proxy-rs > /dev/null; then
+            echo "aa-proxy-rs already running"; exit 0
+        fi
+        aa_run; say "aa-proxy-rs started by hand (aa-now)"; led_state ;;
+    status)
+        for d in hostapd udhcpd dbus-daemon bluetoothd aa-proxy-rs; do
+            printf '%-12s %s\n' "$d" "$(pgrep -x "$d" > /dev/null && echo running || echo -)"
+        done
+        iw dev wlan0 info 2>/dev/null | grep -E 'ssid|type|channel'
+        cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null | sed 's/^/cpu kHz /'
+        if [ -e "$P/u2ac-dev" ]; then echo "mode: dev forced (NCM)"; elif [ -e "$P/u2ac-aa-force" ]; then echo "mode: android-auto forced"
+        else echo "mode: auto ($(pgrep -x aa-proxy-rs > /dev/null && echo android-auto || echo maintenance))"; fi
+        echo "usb at boot: probe $(cat /run/u2ac-usbprobe 2> /dev/null || echo -), host $(cat /run/u2ac-usbhost 2> /dev/null || echo -)"
+        echo "hands-free guard: $([ -e "$P/u2ac-hfp-guard-off" ] && echo off || echo on)"
+        ;;
+    dev)
+        case ${2:-} in
+            on) rm -f "$P/u2ac-aa-force"; : > "$P/u2ac-dev" && state_save force && echo "dev mode forced on (after reboot: USB = NCM always)" ;;
+            off) rm -f "$P/u2ac-dev" "$P/u2ac-aa-force" && state_save force && echo "auto mode (computer on USB = NCM, car = Android Auto)" ;;
+            aa) rm -f "$P/u2ac-dev"; : > "$P/u2ac-aa-force" && state_save force && echo "Android Auto forced (even with a computer on USB)" ;;
+            *) echo "usage: u2ac-aa dev on|off|aa" >&2; exit 2 ;;
+        esac
+        ;;
+    *) echo "usage: u2ac-aa start|stop|status|persist|aa-now|dev on|off|aa|flightlog [last|SEQ]" >&2; exit 2 ;;
+esac
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/wifi-connect b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/wifi-connect
new file mode 100755
index 0000000..893d3e4
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/wifi-connect
@@ -0,0 +1,255 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# wifi-connect: join a Wi-Fi network as a station with wpa_supplicant (nl80211) + udhcpc, and print the
+# state. The radios are OFF at boot: run `radio up` first; without a wireless interface this says so.
+#
+#   wifi-connect [-i IF] [--no-dhcp] [--dry-run] [--] <ssid> [psk|-]
+#   wifi-connect --status [-i IF]
+#   wifi-connect --stop [-i IF]           stop wpa_supplicant + udhcpc (every interface without -i)
+#
+#   psk   8..63 printable ASCII characters (a passphrase) or 64 hex digits (the PSK itself); "-" reads
+#         the passphrase from stdin (keeps it out of the process list); none: an open network
+#   -i    the interface (default: the first managed-mode one among /sys/class/net/*/phy80211)
+#   --dry-run   check the arguments and the interface, print the configuration (PSK masked) and the
+#               commands; writes and starts nothing. Exit status: what the real run would do (0, or 1
+#               when it would refuse the interface)
+#   WIFI_TIMEOUT=<s>  association wait (default 30); wpa_supplicant keeps trying after it
+#
+# Security: WPA2-PSK / WPA-PSK (key_mgmt WPA-PSK, PMF optional: ieee80211w=1) or open. WPA3-only (SAE)
+# networks CANNOT be joined: this wpa_supplicant has no SAE (internal crypto, no elliptic curves; README
+# §2.5); a WPA2/WPA3 transition network is joined with WPA2-PSK. No enterprise (802.1X), no WPS.
+#
+# RAM only, never flash: /run/wifi/<if>.conf (0600; it holds the 256-bit PSK wpa_passphrase derives,
+# never the passphrase), the control socket in /run/wpa_supplicant (wpa_cli -p /run/wpa_supplicant),
+# /run/wpa_supplicant-<if>.pid, /run/udhcpc-<if>.pid, /run/log/wpa_supplicant-<if>.log, /run/resolv.conf
+# (/etc/resolv.conf links there). Nothing survives a reboot: run it again after each boot.
+#
+# Test hooks (host self-test only): RADIO_SYS, RADIO_RUN, RADIO_LIB, WIFI_DHCP_SCRIPT.
+. "${RADIO_LIB:-/lib/baseline}/radio-lib.sh"
+CTRL=$RUN/wpa_supplicant
+DHCP_SCRIPT=${WIFI_DHCP_SCRIPT:-/etc/baseline/udhcpc.sh}
+TIMEOUT=${WIFI_TIMEOUT:-30}
+say() { echo "wifi-connect: $*"; }
+usage() { sed -n '6,8p' "$0" | sed 's/^# *//' >&2; exit 2; }
+bad() { say "$*" >&2; exit 2; }
+
+pid_wpa() { echo "$RUN/wpa_supplicant-$1.pid"; }
+pid_dhcp() { echo "$RUN/udhcpc-$1.pid"; }
+
+# ours PIDFILE NAME: the pid in PIDFILE is a running NAME (not a reused pid)
+ours() {
+    [ -s "$1" ] || return 1
+    _p=$(cat "$1")
+    case $_p in '' | *[!0-9]*) return 1 ;; esac
+    tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null | grep -q "$2"
+}
+
+stop_if() {
+    for _pf in "$(pid_dhcp "$1")" "$(pid_wpa "$1")"; do
+        _nm=wpa_supplicant
+        case $_pf in */udhcpc-*) _nm=udhcpc ;; esac
+        if ours "$_pf" "$_nm"; then
+            _p=$(cat "$_pf")
+            kill "$_p" 2>/dev/null && say "$1: stopped $_nm (pid $_p)"
+            _n=0
+            while kill -0 "$_p" 2>/dev/null && [ "$_n" -lt 5 ]; do sleep 1; _n=$((_n + 1)); done
+        fi
+        rm -f "$_pf"
+    done
+    if [ -e "$SYS/class/net/$1" ]; then
+        ip -4 addr flush dev "$1" 2> /dev/null
+        ip route del default dev "$1" 2> /dev/null
+    fi
+    rm -f "$RUN/wifi/$1.conf" "$CTRL/$1"
+}
+
+# the first managed-mode wireless interface (iw), else the first wireless one
+pick_if() {
+    _first=
+    for _i in $(wifs); do
+        [ -n "$_first" ] || _first=$_i
+        iw dev "$_i" info 2>/dev/null | grep -q 'type managed' && { echo "$_i"; return 0; }
+    done
+    echo "$_first"
+}
+
+state() {
+    say "$1: $(ifstate "$1")"
+    if [ -e "$CTRL/$1" ]; then
+        wpa_cli -p "$CTRL" -i "$1" status 2>/dev/null \
+            | awk -F= '$1 ~ /^(wpa_state|ssid|bssid|freq|key_mgmt|pairwise_cipher|pmf)$/ {
+                           k = $1; sub(/^[^=]*=/, ""); print "wifi-connect:   " k ": " $0 }'
+    else
+        say "  wpa_supplicant: not running on $1"
+    fi
+    _a=$(ip -4 addr show dev "$1" 2>/dev/null | sed -n 's/^ *inet \([0-9./]*\).*/\1/p' | tr '\n' ' ')
+    say "  IPv4: ${_a:-none}"
+    _r=$(ip route show dev "$1" 2>/dev/null | grep '^default' | head -n 1)
+    [ -n "$_r" ] && say "  route: $_r"
+    [ -s "$RUN/resolv.conf" ] && say "  DNS: $(sed -n 's/^nameserver //p' "$RUN/resolv.conf" | tr '\n' ' ')"
+    return 0
+}
+
+conf_text() { # conf_text MASK: the wpa_supplicant configuration (MASK=1: the PSK not shown)
+    echo "# wifi-connect: RAM only (/run), rewritten on every run; the PSK is derived, the passphrase is not stored"
+    echo "ctrl_interface=DIR=$CTRL GROUP=0"
+    echo "update_config=0"
+    echo "network={"
+    echo "	ssid=$SSID_HEX"
+    echo "	scan_ssid=1"
+    echo "	key_mgmt=$KEY_MGMT"
+    if [ -n "$PSK_HEX" ]; then
+        if [ "$1" = 1 ]; then echo "	psk=<64 hex digits, not shown>"; else echo "	psk=$PSK_HEX"; fi
+        echo "	ieee80211w=1"
+    fi
+    echo "}"
+}
+
+IF=
+DHCP=1
+DRY=
+MODE=connect
+while [ $# -gt 0 ]; do
+    case $1 in
+        -i) [ $# -ge 2 ] || usage; IF=$2; shift 2 ;;
+        --no-dhcp) DHCP=; shift ;;
+        -n | --dry-run) DRY=1; shift ;;
+        --stop) MODE=stop; shift ;;
+        --status) MODE=status; shift ;;
+        -h | --help) sed -n '2,/^# Test hooks/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
+        --) shift; break ;;
+        -?*) bad "unknown option $1 (--help)" ;;
+        *) break ;;
+    esac
+done
+
+case $MODE in
+    stop)
+        if [ -n "$IF" ]; then stop_if "$IF"; else
+            for _f in "$RUN"/wpa_supplicant-*.pid "$RUN"/udhcpc-*.pid; do
+                [ -e "$_f" ] || continue
+                _i=${_f##*/}
+                _i=${_i#wpa_supplicant-}
+                _i=${_i#udhcpc-}
+                stop_if "${_i%.pid}"
+            done
+        fi
+        exit 0
+        ;;
+    status)
+        [ -n "$IF" ] || IF=$(pick_if)
+        [ -n "$IF" ] || { say "no wireless interface; $(radio_off_hint)"; exit 1; }
+        state "$IF"
+        exit 0
+        ;;
+esac
+
+[ $# -ge 1 ] && [ $# -le 2 ] || usage
+SSID=$1
+PSK=
+HAVE_PSK=
+if [ $# -eq 2 ]; then
+    HAVE_PSK=1
+    PSK=$2
+    if [ "$PSK" = - ]; then
+        IFS= read -r PSK || bad "no passphrase on stdin"
+    fi
+fi
+_n=$(($(printf %s "$SSID" | wc -c)))
+[ "$_n" -ge 1 ] && [ "$_n" -le 32 ] || bad "an SSID has 1..32 bytes, this one $_n"
+SSID_HEX=$(printf %s "$SSID" | od -An -v -tx1 | tr -d ' \n')
+KEY_MGMT=NONE
+PSK_HEX=
+if [ -n "$HAVE_PSK" ]; then
+    _n=$(($(printf %s "$PSK" | wc -c)))
+    if [ "$_n" -eq 64 ] && [ -z "$(printf %s "$PSK" | tr -d '0-9a-fA-F')" ]; then
+        PSK_HEX=$(printf %s "$PSK" | tr 'A-F' 'a-f')
+        KIND="PSK given as 64 hex digits"
+    elif [ "$_n" -ge 8 ] && [ "$_n" -le 63 ] && [ -z "$(printf %s "$PSK" | LC_ALL=C tr -d ' -~')" ]; then
+        KIND="passphrase ($_n characters), PSK derived with wpa_passphrase"
+        command -v wpa_passphrase > /dev/null 2>&1 || { say "no wpa_passphrase in this image" >&2; exit 1; }
+        # the passphrase on stdin, never on a command line
+        PSK_HEX=$(printf '%s\n' "$PSK" | wpa_passphrase "$SSID" 2>/dev/null | sed -n 's/^[[:space:]]*psk=\([0-9a-f]\{64\}\)$/\1/p')
+        [ "${#PSK_HEX}" -eq 64 ] || { say "wpa_passphrase did not derive a PSK" >&2; exit 1; }
+    else
+        bad "a passphrase has 8..63 printable ASCII characters (or give the 64-hex-digit PSK); this one has $_n bytes"
+    fi
+    PSK=
+    # plain WPA-PSK only: the SHA-256 variant is left out until a radio's firmware is seen doing it
+    KEY_MGMT="WPA-PSK"
+else
+    KIND="open network (no psk given)"
+fi
+
+# The interface. A real run refuses a missing or non-wireless one; a dry run notes it and goes on.
+RC=0
+refuse() {
+    if [ -n "$DRY" ]; then say "NOTE: $*; a real run stops here"; RC=1; else say "$*" >&2; exit 1; fi
+}
+if [ -z "$IF" ]; then
+    IF=$(pick_if)
+    [ -n "$IF" ] || { refuse "no wireless interface; $(radio_off_hint)"; IF='<none>'; }
+elif [ ! -e "$SYS/class/net/$IF" ]; then
+    refuse "no interface $IF; $(radio_off_hint)"
+elif [ ! -e "$SYS/class/net/$IF/phy80211" ]; then
+    refuse "$IF is not a wireless interface (no phy80211)"
+fi
+for _t in wpa_supplicant wpa_cli; do
+    command -v "$_t" > /dev/null 2>&1 || refuse "no $_t in this image"
+done
+[ -z "$DHCP" ] || command -v udhcpc > /dev/null 2>&1 || refuse "no udhcpc in this image"
+
+CONF=$RUN/wifi/$IF.conf
+LOG=$RUN/log/wpa_supplicant-$IF.log
+WPA_CMD="wpa_supplicant -B -i $IF -D nl80211 -c $CONF -P $(pid_wpa "$IF") -f $LOG"
+DHCP_CMD="udhcpc -i $IF -s $DHCP_SCRIPT -p $(pid_dhcp "$IF") -t 5 -T 3 -A 10 -b -R"
+
+if [ -n "$DRY" ]; then
+    say "dry run: SSID $SSID (hex $SSID_HEX), $KIND, interface $IF"
+    say "would stop a previous wpa_supplicant/udhcpc on $IF, then write $CONF (0600):"
+    conf_text 1 | sed 's/^/    /'
+    say "would run: ip link set dev $IF up"
+    say "would run: $WPA_CMD"
+    say "would wait up to $TIMEOUT s for wpa_state=COMPLETED (wpa_cli -p $CTRL -i $IF status)"
+    if [ -n "$DHCP" ]; then say "would run: $DHCP_CMD"; else say "no DHCP (--no-dhcp)"; fi
+    say "dry run: nothing written, nothing started"
+    exit "$RC"
+fi
+
+stop_if "$IF" > /dev/null
+umask 077
+mkdir -p "$RUN/wifi" "$CTRL" "$RUN/log" || exit 1
+conf_text 0 > "$CONF.tmp" && mv "$CONF.tmp" "$CONF" || { say "cannot write $CONF" >&2; exit 1; }
+umask 022
+say "$IF: SSID $SSID, $KIND; configuration $CONF (RAM)"
+ip link set dev "$IF" up || { say "$IF could not be set administratively up (dmesg)" >&2; exit 1; }
+: > "$LOG"
+# shellcheck disable=SC2086
+$WPA_CMD || { say "wpa_supplicant did not start ($LOG)" >&2; tail -n 5 "$LOG" >&2; exit 1; }
+
+_n=0
+st=
+while [ "$_n" -lt "$TIMEOUT" ]; do
+    st=$(wpa_cli -p "$CTRL" -i "$IF" status 2>/dev/null | sed -n 's/^wpa_state=//p')
+    [ "$st" = COMPLETED ] && break
+    sleep 1
+    _n=$((_n + 1))
+done
+if [ "$st" != COMPLETED ]; then
+    say "$IF: not associated after $TIMEOUT s (wpa_state ${st:-unknown}); wpa_supplicant keeps trying (--stop ends it)"
+    grep -q 'reason=WRONG_KEY' "$LOG" 2>/dev/null && say "  the log says WRONG_KEY: wrong passphrase?"
+    grep -q 'CTRL-EVENT-NETWORK-NOT-FOUND' "$LOG" 2>/dev/null && say "  the network was not found in the scans (wifi-scan lists what is seen)"
+    grep -q 'CTRL-EVENT-ASSOC-REJECT' "$LOG" 2>/dev/null && say "  the AP rejected the association (WPA3-only? not supported by this build)"
+    say "  log: $LOG"
+    state "$IF"
+    exit 1
+fi
+say "$IF: associated after $_n s"
+if [ -n "$DHCP" ]; then
+    # shellcheck disable=SC2086
+    $DHCP_CMD > /dev/null 2>&1 || say "udhcpc failed to start"
+    [ -n "$(ip -4 addr show dev "$IF" 2>/dev/null | grep ' inet ')" ] \
+        || say "$IF: no DHCP lease yet (udhcpc keeps trying in the background)"
+fi
+state "$IF"
+exit 0
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/wifi-scan b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/wifi-scan
new file mode 100755
index 0000000..7ee7094
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/wifi-scan
@@ -0,0 +1,85 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# wifi-scan [-i IF] [-a]: the networks around, one line each, strongest first (iw scan, trimmed):
+#   SIGNAL dBm   FREQ MHz   BSSID   SECURITY   SSID
+# SECURITY: open, WEP, WPA-PSK, WPA2-PSK, WPA2/WPA3 (joinable with WPA2-PSK), WPA3-SAE (NOT joinable:
+# this build has no SAE), 802.1X (NOT joinable: no enterprise). "<hidden>" = the AP sends no SSID.
+#   -a   the full iw output instead
+# The radios are OFF at boot: run `radio up` first; without a wireless interface this says so. A
+# scan needs the interface administratively up (radio up does that; it is brought up here if not).
+# While wpa_supplicant (wifi-connect) runs, the kernel may refuse a new scan (busy): the results of the
+# last scan are shown then (iw scan dump).
+# Test hooks (host self-test only): RADIO_SYS, RADIO_LIB.
+. "${RADIO_LIB:-/lib/baseline}/radio-lib.sh"
+say() { echo "wifi-scan: $*"; }
+IF=
+RAW=
+while [ $# -gt 0 ]; do
+    case $1 in
+        -i) [ $# -ge 2 ] || { echo "usage: wifi-scan [-i IF] [-a]" >&2; exit 2; }; IF=$2; shift 2 ;;
+        -a) RAW=1; shift ;;
+        *) echo "usage: wifi-scan [-i IF] [-a]" >&2; exit 2 ;;
+    esac
+done
+command -v iw > /dev/null 2>&1 || { say "no iw in this image"; exit 1; }
+if [ -z "$IF" ]; then
+    for i in $(wifs); do IF=$i; break; done
+    [ -n "$IF" ] || { say "no wireless interface; $(radio_off_hint)"; exit 1; }
+elif [ ! -e "$SYS/class/net/$IF/phy80211" ]; then
+    say "$IF is not a wireless interface (or does not exist); $(radio_off_hint)"
+    exit 1
+fi
+case $(ifstate "$IF") in
+    "administratively down"*)
+        say "$IF is administratively down, bringing it up"
+        ip link set dev "$IF" up || { say "$IF could not be set up (dmesg)"; exit 1; }
+        ;;
+esac
+OUT=$(iw dev "$IF" scan 2>&1)
+rc=$?
+if [ "$rc" != 0 ]; then
+    case $OUT in
+        *busy* | *"(-16)"*)
+            say "$IF: the kernel refused a new scan (busy, wpa_supplicant scanning?): the last results"
+            OUT=$(iw dev "$IF" scan dump 2>&1) || { say "iw scan dump failed: $OUT"; exit 1; } ;;
+        *) say "iw scan on $IF failed: $OUT"; exit 1 ;;
+    esac
+fi
+if [ -n "$RAW" ]; then
+    printf '%s\n' "$OUT"
+    exit 0
+fi
+TAB=$(printf '\t')
+printf '%s\n' "$OUT" | awk '
+    function flush() {
+        if (bss == "") return
+        if (rsn) {
+            if (eap && !psk && !sae) sec = "802.1X"
+            else if (sae && psk) sec = "WPA2/WPA3"
+            else if (sae) sec = "WPA3-SAE"
+            else sec = "WPA2-PSK"
+        } else if (wpa) sec = (eap && !psk) ? "802.1X" : "WPA-PSK"
+        else if (priv) sec = "WEP"
+        else sec = "open"
+        if (ssid == "") ssid = "<hidden>"
+        printf "%s\t%s\t%s\t%s\t%s\n", sig, freq, bss, sec, ssid
+        bss = ""
+    }
+    /^BSS / { flush(); bss = substr($2, 1, 17); sig = "?"; freq = "?"; ssid = ""; rsn = wpa = priv = psk = sae = eap = 0; ie = ""; next }
+    /^\tfreq: / { freq = $2; sub(/\..*/, "", freq); next }
+    /^\tsignal: / { sig = $2; sub(/\..*/, "", sig); next }
+    /^\tSSID: / { ssid = substr($0, 8); next }
+    /^\tSSID:$/ { ssid = ""; next }
+    /^\tcapability: / { if ($0 ~ / Privacy/) priv = 1; next }
+    /^\tRSN:/ { rsn = 1; ie = "rsn" }
+    /^\tWPA:/ { wpa = 1; ie = "wpa" }
+    /^\t[^\t]/ && !/^\t(RSN|WPA):/ { ie = "" }
+    /Authentication suites:/ && ie != "" {
+        if ($0 ~ /SAE/) sae = 1
+        if ($0 ~ /PSK/) psk = 1
+        if ($0 ~ /IEEE 802\.1X/) eap = 1
+    }
+    END { flush() }' | sort -t "$TAB" -k1,1nr | awk -F '\t' '
+    BEGIN { printf "%-7s %-6s %-17s %-10s %s\n", "dBm", "MHz", "BSSID", "SECURITY", "SSID" }
+    { printf "%-7s %-6s %-17s %-10s %s\n", $1, $2, $3, $4, $5; n++ }
+    END { if (!n) print "(no networks found)" }'
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/dbus-1/session.conf b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/dbus-1/session.conf
new file mode 100644
index 0000000..323aad4
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/dbus-1/session.conf
@@ -0,0 +1,80 @@
+<!-- This configuration file controls the per-user-login-session message bus.
+     Add a session-local.conf and edit that rather than changing this 
+     file directly. -->
+
+<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <!-- Our well-known bus type, don't change this -->
+  <type>session</type>
+
+  <!-- If we fork, keep the user's original umask to avoid affecting
+       the behavior of child processes. -->
+  <keep_umask/>
+
+  <listen>unix:tmpdir=/tmp</listen>
+
+  <!-- On Unix systems, the most secure authentication mechanism is
+  EXTERNAL, which uses credential-passing over Unix sockets.
+
+  This authentication mechanism is not available on Windows,
+  is not suitable for use with the tcp: or nonce-tcp: transports,
+  and will not work on obscure flavours of Unix that do not have
+  a supported credentials-passing mechanism. On those platforms/transports,
+  comment out the <auth> element to allow fallback to DBUS_COOKIE_SHA1. -->
+  <auth>EXTERNAL</auth>
+
+  <standard_session_servicedirs />
+
+  <policy context="default">
+    <!-- Allow everything to be sent -->
+    <allow send_destination="*" eavesdrop="true"/>
+    <!-- Allow everything to be received -->
+    <allow eavesdrop="true"/>
+    <!-- Allow anyone to own anything -->
+    <allow own="*"/>
+  </policy>
+
+  <!-- Include legacy configuration location -->
+  <include ignore_missing="yes">/etc/dbus-1/session.conf</include>
+
+  <!-- Config files are placed here that among other things, 
+       further restrict the above policy for specific services. -->
+  <includedir>session.d</includedir>
+
+  <includedir>/etc/dbus-1/session.d</includedir>
+
+  <!-- This is included last so local configuration can override what's 
+       in this standard file -->
+  <include ignore_missing="yes">/etc/dbus-1/session-local.conf</include>
+
+  <include if_selinux_enabled="yes" selinux_root_relative="yes">contexts/dbus_contexts</include>
+
+  <!-- For the session bus, override the default relatively-low limits 
+       with essentially infinite limits, since the bus is just running 
+       as the user anyway, using up bus resources is not something we need 
+       to worry about. In some cases, we do set the limits lower than 
+       "all available memory" if exceeding the limit is almost certainly a bug, 
+       having the bus enforce a limit is nicer than a huge memory leak. But the 
+       intent is that these limits should never be hit. -->
+
+  <!-- the memory limits are 1G instead of say 4G because they can't exceed 32-bit signed int max -->
+  <limit name="max_incoming_bytes">1000000000</limit>
+  <limit name="max_incoming_unix_fds">250000000</limit>
+  <limit name="max_outgoing_bytes">1000000000</limit>
+  <limit name="max_outgoing_unix_fds">250000000</limit>
+  <limit name="max_message_size">1000000000</limit>
+  <!-- We do not override max_message_unix_fds here since the in-kernel
+       limit is also relatively low -->
+  <limit name="service_start_timeout">120000</limit>  
+  <limit name="auth_timeout">240000</limit>
+  <limit name="pending_fd_timeout">150000</limit>
+  <limit name="max_completed_connections">100000</limit>  
+  <limit name="max_incomplete_connections">10000</limit>
+  <limit name="max_connections_per_user">100000</limit>
+  <limit name="max_pending_service_starts">10000</limit>
+  <limit name="max_names_per_connection">50000</limit>
+  <limit name="max_match_rules_per_connection">50000</limit>
+  <limit name="max_replies_per_connection">50000</limit>
+
+</busconfig>
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/share/dbus-1/system.conf b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/dbus-1/system.conf
new file mode 100644
index 0000000..c3521b6
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/dbus-1/system.conf
@@ -0,0 +1,142 @@
+<!-- This configuration file controls the systemwide message bus.
+     Add a system-local.conf and edit that rather than changing this 
+     file directly. -->
+
+<!-- Note that there are any number of ways you can hose yourself
+     security-wise by screwing up this file; in particular, you
+     probably don't want to listen on any more addresses, add any more
+     auth mechanisms, run as a different user, etc. -->
+
+<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+
+  <!-- Our well-known bus type, do not change this -->
+  <type>system</type>
+
+  <!-- Run as special user -->
+  <user>dbus</user>
+
+  <!-- Fork into daemon mode -->
+  <fork/>
+
+  <!-- We use system service launching using a helper -->
+  <standard_system_servicedirs/>
+
+  <!-- This is a setuid helper that is used to launch system services -->
+  <servicehelper>/usr/libexec/dbus-daemon-launch-helper</servicehelper>
+
+  <!-- Write a pid file -->
+  <pidfile>/run/dbus-daemon.pid</pidfile>
+
+  <!-- Enable logging to syslog -->
+  <syslog/>
+
+  <!-- Only allow socket-credentials-based authentication -->
+  <auth>EXTERNAL</auth>
+
+  <!-- Only listen on a local socket. (abstract=/path/to/socket 
+       means use abstract namespace, don't really create filesystem 
+       file; only Linux supports this. Use path=/whatever on other 
+       systems.) -->
+  <listen>unix:path=/run/dbus/system_bus_socket</listen>
+
+  <policy context="default">
+    <!-- All users can connect to system bus -->
+    <allow user="*"/>
+
+    <!-- Holes must be punched in service configuration files for
+         name ownership and sending method calls -->
+    <deny own="*"/>
+    <deny send_type="method_call"/>
+
+    <!-- Signals and reply messages (method returns, errors) are allowed
+         by default -->
+    <allow send_type="signal"/>
+    <allow send_requested_reply="true" send_type="method_return"/>
+    <allow send_requested_reply="true" send_type="error"/>
+
+    <!-- All messages may be received by default -->
+    <allow receive_type="method_call"/>
+    <allow receive_type="method_return"/>
+    <allow receive_type="error"/>
+    <allow receive_type="signal"/>
+
+    <!-- Allow anyone to talk to the message bus -->
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.DBus" />
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.DBus.Introspectable"/>
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.DBus.Properties"/>
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.DBus.Containers1"/>
+    <!-- But disallow some specific bus services -->
+    <deny send_destination="org.freedesktop.DBus"
+          send_interface="org.freedesktop.DBus"
+          send_member="UpdateActivationEnvironment"/>
+    <deny send_destination="org.freedesktop.DBus"
+          send_interface="org.freedesktop.DBus.Debug.Stats"/>
+    <deny send_destination="org.freedesktop.DBus"
+          send_interface="org.freedesktop.systemd1.Activator"/>
+  </policy>
+
+  <!-- Only systemd, which runs as root, may report activation failures. -->
+  <policy user="root">
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.systemd1.Activator"/>
+  </policy>
+
+  <!-- root may monitor the system bus. -->
+  <policy user="root">
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.DBus.Monitoring"/>
+  </policy>
+
+  <!-- If the Stats interface was enabled at compile-time, root may use it.
+       Copy this into system.local.conf or system.d/*.conf if you want to
+       enable other privileged users to view statistics and debug info -->
+  <policy user="root">
+    <allow send_destination="org.freedesktop.DBus"
+           send_interface="org.freedesktop.DBus.Debug.Stats"/>
+  </policy>
+
+  <!-- Include legacy configuration location -->
+  <include ignore_missing="yes">/etc/dbus-1/system.conf</include>
+
+  <!-- The defaults for these limits are hard-coded in dbus-daemon.
+       Some clarifications:
+       Times are in milliseconds (ms); 1000ms = 1 second
+       133169152 bytes = 127 MiB
+       33554432 bytes = 32 MiB
+       150000ms = 2.5 minutes -->
+  <!-- <limit name="max_incoming_bytes">133169152</limit> -->
+  <!-- <limit name="max_incoming_unix_fds">64</limit> -->
+  <!-- <limit name="max_outgoing_bytes">133169152</limit> -->
+  <!-- <limit name="max_outgoing_unix_fds">64</limit> -->
+  <!-- <limit name="max_message_size">33554432</limit> -->
+  <!-- <limit name="max_message_unix_fds">16</limit> -->
+  <!-- <limit name="service_start_timeout">25000</limit> -->
+  <!-- <limit name="auth_timeout">5000</limit> -->
+  <!-- <limit name="pending_fd_timeout">150000</limit> -->
+  <!-- <limit name="max_completed_connections">2048</limit> -->
+  <!-- <limit name="max_incomplete_connections">64</limit> -->
+  <!-- <limit name="max_connections_per_user">256</limit> -->
+  <!-- <limit name="max_pending_service_starts">512</limit> -->
+  <!-- <limit name="max_names_per_connection">512</limit> -->
+  <!-- <limit name="max_match_rules_per_connection">512</limit> -->
+  <!-- <limit name="max_replies_per_connection">128</limit> -->
+
+  <!-- Config files are placed here that among other things, punch 
+       holes in the above policy for specific services. -->
+  <includedir>system.d</includedir>
+
+  <includedir>/etc/dbus-1/system.d</includedir>
+
+  <!-- This is included last so local configuration can override what's 
+       in this standard file -->
+  <include ignore_missing="yes">/etc/dbus-1/system-local.conf</include>
+
+  <include if_selinux_enabled="yes" selinux_root_relative="yes">contexts/dbus_contexts</include>
+
+</busconfig>
