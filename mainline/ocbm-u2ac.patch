+<style>
+:root{--bg:#0e1824;--panel:#152232;--line:#22344a;--ink:#e8eef5;--dim:#8a9bb0;--green:#3ddc84;--amber:#ffb020;--blue:#5aa9ff;--red:#ff6b5e;--off:#6d7d91;
+--cond:"Roboto Condensed","sans-serif-condensed","Arial Narrow",system-ui,sans-serif;--sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--mono:ui-monospace,"Roboto Mono","SF Mono",Menlo,monospace;color-scheme:dark}
+@media (prefers-color-scheme:light){:root{--bg:#e9eef3;--panel:#fff;--line:#d3dce6;--ink:#102030;--dim:#5a6b7f;--green:#0f9d58;--amber:#b7791f;--blue:#1a6fd1;--red:#d93a2b;--off:#8593a3;color-scheme:light}}
