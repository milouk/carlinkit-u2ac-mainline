@@ -0,0 +1,537 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<meta name="color-scheme" content="dark light">
+<meta name="theme-color" content="#0e1824">
+<title>AutoKit dongle</title>
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='9' fill='none' stroke='%233ddc84' stroke-width='2.5'/%3E%3Ccircle cx='12' cy='12' r='2.5' fill='%233ddc84'/%3E%3C/svg%3E">
+<style>
+:root{--bg:#0e1824;--panel:#152232;--line:#22344a;--ink:#e8eef5;--dim:#8a9bb0;--green:#3ddc84;--amber:#ffb020;--blue:#5aa9ff;--red:#ff6b5e;--off:#6d7d91;
+--cond:"Roboto Condensed","sans-serif-condensed","Arial Narrow",system-ui,sans-serif;--sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--mono:ui-monospace,"Roboto Mono","SF Mono",Menlo,monospace;color-scheme:dark}
+@media (prefers-color-scheme:light){:root{--bg:#e9eef3;--panel:#fff;--line:#d3dce6;--ink:#102030;--dim:#5a6b7f;--green:#0f9d58;--amber:#b7791f;--blue:#1a6fd1;--red:#d93a2b;--off:#8593a3;color-scheme:light}}
+*{box-sizing:border-box}
+[hidden]{display:none!important}
+html{-webkit-text-size-adjust:100%}
+body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 var(--sans);padding-bottom:calc(76px + env(safe-area-inset-bottom))}
+a{color:var(--blue)}
+button,input{font:inherit;color:inherit}
+:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
+.wrap{max-width:720px;margin:0 auto;padding:0 16px}
+header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0 6px}
+header h1{margin:0;font:700 19px/1.2 var(--cond);letter-spacing:.01em}
+#live{display:flex;align-items:center;gap:7px;color:var(--dim);font-size:13px;white-space:nowrap}
+#live i{width:8px;height:8px;border-radius:50%;background:var(--off)}
+#live.on i{background:var(--green)}#live.bad i{background:var(--red)}
+nav{position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--panel);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}
+nav .wrap{display:grid;grid-template-columns:repeat(4,1fr)}
+nav button{background:none;border:0;padding:10px 4px 12px;color:var(--dim);font:600 13px/1 var(--sans);display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer}
+nav button svg{width:22px;height:22px}
+nav button[aria-current=page]{color:var(--ink)}
+nav button[aria-current=page] svg{color:var(--green)}
+h2{font:600 14px/1.3 var(--sans);color:var(--dim);margin:26px 0 8px}
+.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:4px 16px}
+dl{margin:0}
+.row{display:grid;grid-template-columns:minmax(96px,38%) 1fr;gap:12px;padding:11px 0;border-top:1px solid var(--line)}
+.row:first-child{border-top:0}
+dt{color:var(--dim)}dd{margin:0;min-width:0;overflow-wrap:anywhere}
+.sub{color:var(--dim);font-size:13px}
+.num{font-family:var(--cond);font-variant-numeric:tabular-nums}
+/* hero: the tell-tale lamp */
