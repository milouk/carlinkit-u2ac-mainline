index 0000000..0798a22
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/index.html
@@ -0,0 +1,506 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<meta name="color-scheme" content="dark light">
+<meta name="theme-color" content="#0e1824">
+<title>AutoKit dongle</title>
