diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/bt-scan b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/bt-scan
new file mode 100755
index 0000000..5cd5b4a
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/bt-scan
@@ -0,0 +1,129 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# bt-scan [-i hciN] [-t SECONDS] [-l|-b] [-r]: Bluetooth devices around, without bluetoothd or D-Bus.
+#   btmgmt find (kernel management socket; BR/EDR and LE interleaved, -l LE only, -b BR/EDR only),
+#   bounded by -t SECONDS (default 15), one line per device:  ADDRESS  TYPE  RSSI  NAME
+#   Without btmgmt: hcitool scan (BR/EDR inquiry) or, with -l, hcitool lescan, under the same bound.
+#   -r   the tool's own output instead
+# The radios are OFF at boot: run `radio up` first (on a kernel image with the chip's Bluetooth DT node);
+# without an HCI device this says so. The controller must be UP (radio up / hciup run HCIDEVUP).
+# LE (B18, 2026-10-20, IW416 unit): after `radio up` the controller's settings are "powered br/edr", LE
+#   off, and the kernel REJECTS the interleaved and the LE-only find (status 0x0b). Unless -b, bt-scan
+#   reads the settings (btmgmt info) and, when LE is off, enables it (btmgmt le on; it stays on until
+#   `radio down`). A controller without LE, or an LE that does not come on, scans BR/EDR only (-l: exit 1).
+#   An interleaved find that is still refused (0x0b Rejected, 0x0c Not Supported) is retried BR/EDR only.
+#   Every run says which mode ran. Exit 1 when discovery did not start.
+# Test hooks (host self-test only): RADIO_SYS, RADIO_LIB.
+. "${RADIO_LIB:-/lib/baseline}/radio-lib.sh"
+say() { echo "bt-scan: $*"; }
+usage() { echo "usage: bt-scan [-i hciN] [-t SECONDS] [-l|-b] [-r]" >&2; exit 2; }
+HCI=
+T=15
+TYPE=
+RAW=
+while [ $# -gt 0 ]; do
+    case $1 in
+        -i) [ $# -ge 2 ] || usage; HCI=$2; shift 2 ;;
+        -t) [ $# -ge 2 ] || usage; T=$2; shift 2 ;;
+        -l) TYPE=-l; shift ;;
+        -b) TYPE=-b; shift ;;
+        -r) RAW=1; shift ;;
+        *) usage ;;
+    esac
+done
+case $T in '' | *[!0-9]*) usage ;; esac
+[ "$T" -ge 1 ] && [ "$T" -le 300 ] || { say "-t takes 1..300 seconds"; exit 2; }
+if [ -z "$HCI" ]; then
+    for h in $(hcis); do HCI=$h; break; done
+    [ -n "$HCI" ] || { say "no Bluetooth controller (no hciN); $(radio_off_hint)"; exit 1; }
+elif [ ! -e "$SYS/class/bluetooth/$HCI" ]; then
+    say "no $HCI; $(radio_off_hint)"
+    exit 1
+fi
+case $HCI in hci[0-9]*) IDX=${HCI#hci} ;; *) say "-i takes hciN"; exit 2 ;; esac
+if command -v hciup > /dev/null 2>&1; then
+    case $(hciup -i "$HCI" 2>&1) in
+        *" UP"*) ;;
+        *) say "$HCI is down: 'radio up' (or 'hciup $HCI') brings it up"; exit 1 ;;
+    esac
+fi
+if command -v btmgmt > /dev/null 2>&1; then
+    mode() { case $1 in -l) echo "LE only" ;; -b) echo "BR/EDR only" ;; *) echo "BR/EDR and LE" ;; esac; }
+    # info: btmgmt info into INFO; settings current|supported: its settings tokens ("" when unknown)
+    info() { INFO=$(timeout 5 btmgmt --index "$IDX" info 2>/dev/null); }
+    settings() { printf '%s\n' "$INFO" | sed -n "s/^[[:space:]]*$1 settings: *//p" | sed 's/ *$//' | head -n 1; }
+    has_le() { case " $1 " in *" le "*) return 0 ;; esac; return 1; }
+    if [ "$TYPE" != -b ]; then
+        info
+        CUR=$(settings current)
+        SUP=$(settings supported)
+        if [ -n "$CUR" ] && has_le "$CUR"; then
+            :
+        elif [ -n "$SUP" ] && ! has_le "$SUP"; then
+            [ "$TYPE" = -l ] && { say "$HCI has no LE (supported: $SUP): no LE scan; -b scans BR/EDR"; exit 1; }
+            say "$HCI has no LE (supported: $SUP): BR/EDR only"
+            TYPE=-b
+        else
+            LEOUT=$(timeout 5 btmgmt --index "$IDX" le on 2>&1)
+            info
+            NOW=$(settings current)
+            if [ -n "$NOW" ] && has_le "$NOW"; then
+                say "$HCI: LE was off (settings: ${CUR:-unknown}); enabled it (btmgmt le on, on until 'radio down')"
+            elif [ -n "$NOW$CUR" ]; then
+                say "$HCI: LE is off and 'btmgmt le on' did not enable it ($(printf '%s\n' "$LEOUT" | head -n 1))"
+                [ "$TYPE" = -l ] && { say "no LE scan; -b scans BR/EDR"; exit 1; }
+                say "$HCI: BR/EDR only"
+                TYPE=-b
+            else
+                say "$HCI: settings unknown (btmgmt info gave none); tried 'btmgmt le on': $(printf '%s\n' "$LEOUT" | head -n 1)"
+            fi
+        fi
+    fi
+    # find TYPE: btmgmt find in that mode into OUT. btmgmt ends by itself when discovery stops (~10 s);
+    # --timeout and timeout bound it either way
+    find_in() {
+        say "$HCI: btmgmt find${1:+ $1} ($(mode "$1")), at most $T s"
+        OUT=$(timeout "$((T + 2))" btmgmt --index "$IDX" --timeout "$T" find $1 2>&1)
+    }
+    refused() { printf '%s\n' "$OUT" | sed -n 's/.*Unable to start discovery\. *\(status 0x0[bc].*\)/\1/p' | head -n 1; }
+    find_in "$TYPE"
+    WHY=$(refused)
+    if [ -n "$WHY" ] && [ -z "$TYPE" ]; then
+        say "$HCI: $(mode "") discovery refused ($WHY); retrying BR/EDR only"
+        [ -n "$RAW" ] && printf '%s\n' "$OUT"
+        TYPE=-b
+        find_in -b
+    fi
+    case $OUT in *"Unable to start discovery"*) RC=1 ;; *) RC=0 ;; esac
+    if [ -n "$RAW" ]; then printf '%s\n' "$OUT"; exit "$RC"; fi
+    printf '%s\n' "$OUT" | awk '
+        / dev_found: / {
+            for (i = 1; i <= NF; i++) {
+                if ($i == "dev_found:") a = $(i + 1)
+                if ($i == "type") { t = $(i + 1); if ($(i + 2) == "Random" || $(i + 2) == "Public") t = t "-" $(i + 2) }
+                if ($i == "rssi") r = $(i + 1)
+            }
+            if (!(a in seen)) { order[++n] = a; seen[a] = 1 }
+            ty[a] = t; rs[a] = r
+            if (match($0, / name /)) nm[a] = substr($0, RSTART + 6)
+            last = a; next
+        }
+        /^name / && last != "" { nm[last] = substr($0, 6); next }
+        /Unable|Failed|failed|Invalid|not supported|rejected/ { print "bt-scan: btmgmt: " $0 }
+        END {
+            printf "%-17s %-11s %-5s %s\n", "ADDRESS", "TYPE", "RSSI", "NAME"
+            for (i = 1; i <= n; i++) { a = order[i]; printf "%-17s %-11s %-5s %s\n", a, ty[a], rs[a], (a in nm) ? nm[a] : "" }
+            if (!n) print "(no devices found)"
+        }'
+    [ "$RC" = 0 ] || say "$HCI: discovery did not start ($(mode "$TYPE"))"
+    exit "$RC"
+fi
+command -v hcitool > /dev/null 2>&1 || { say "neither btmgmt nor hcitool in this image"; exit 1; }
+if [ "$TYPE" = -l ]; then
+    say "$HCI: hcitool lescan, $T s"
+    timeout "$T" hcitool -i "$HCI" lescan --duplicates 2>&1 | awk 'NR == 1 || !seen[$1]++'
+else
+    say "$HCI: hcitool scan (BR/EDR inquiry), at most $T s"
+    timeout "$T" hcitool -i "$HCI" scan 2>&1
+fi
+exit 0
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/mfi-probe b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/mfi-probe
new file mode 100755
index 0000000..204e58c
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/mfi-probe
@@ -0,0 +1,64 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# mfi-probe: READ-ONLY check of the Apple MFi 2.0C authentication coprocessor on /dev/i2c-1 address
+# 0x11 (board.env MFI_I2C_BUS / MFI_I2C_ADDR: the &i2c2 controller on the UART5 pads). It reads two
+# registers whose meaning this project has proven on the chip, with the same access the project's
+# daemons use (crates/vendor/mfi-i2c-local/src/lib.rs i2c_rd: one transaction, register-address write +
+# repeated-start read, 5 tries 5 ms apart; box/carplayd/src/main.rs device_version):
+#   0x00  DeviceVersion, 1 byte (0x03 on the IW416 unit)
+#   0x30  accessory certificate length, 2 bytes big-endian
+# The register-address byte is a pointer write, not a register write; no control register (0x10) is
+# touched, no challenge is written, nothing is signed. Holds /tmp/carplay_mfi.lock (the lock every MFi
+# user of this project takes) while it reads.
+#   mfi-probe            the two values
+#   mfi-probe -v         also the raw i2ctransfer output
+. /etc/baseline/board.env
+BUS=${MFI_I2C_BUS:-1}
+ADDR=${MFI_I2C_ADDR:-0x11}
+V=
+[ "${1:-}" = -v ] && V=1
+say() { echo "mfi-probe: $*"; }
+
+[ -c "/dev/i2c-$BUS" ] || { say "no /dev/i2c-$BUS (i2c-dev, the i2c2 controller)"; exit 1; }
+
+# rd REG LEN: the LEN bytes i2ctransfer prints ("0x03 0x02 ...").
+rd() {
+    _n=0
+    while [ "$_n" -lt 5 ]; do
+        if _o=$(i2ctransfer -y "$BUS" "w1@$ADDR" "$1" "r$2" 2>/dev/null); then
+            [ -n "$V" ] && say "raw reg $1: $_o"
+            echo "$_o"
+            return 0
+        fi
+        usleep 5000
+        _n=$((_n + 1))
+    done
+    return 1
+}
+
+exec 9> /tmp/carplay_mfi.lock
+# Wait up to ~10 s for the lock. BusyBox flock has no -w (1.38.0 on the IW416 unit, 2026-10-20:
+# "flock: unrecognized option: w"), so poll -n: 50 tries 200 ms apart. The lock belongs to fd 9's open
+# file, which this shell keeps, so it stays held after flock exits until mfi-probe does.
+_n=0
+until flock -n 9; do
+    _n=$((_n + 1))
+    [ "$_n" -lt 50 ] || { say "the MFi lock is busy (another MFi user holds /tmp/carplay_mfi.lock)"; exit 1; }
+    usleep 200000
+done
+
+if ver=$(rd 0x00 1); then
+    say "DeviceVersion (reg 0x00) = $ver at $ADDR on /dev/i2c-$BUS"
+else
+    say "no answer at $ADDR on /dev/i2c-$BUS (5 tries): chip absent, asleep or wired elsewhere"
+    exit 1
+fi
+if len=$(rd 0x30 2); then
+    # shellcheck disable=SC2086
+    set -- $len
+    say "certificate length (reg 0x30) = $(( ($1 << 8) | $2 )) bytes"
+else
+    say "reg 0x30 (certificate length) did not answer"
+    exit 1
+fi
+exit 0
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/radio b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/radio
new file mode 100755
index 0000000..a1e6956
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/radio
@@ -0,0 +1,239 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Derived from LIVI scripts/livi-link/common/rootfs/usr/bin/livi-radio (GPL-3.0-or-later).
+# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+# Modified 2026-10-20: rewritten as an on-demand up/down/status tool that identifies the chip by its
+# SDIO id; LIVI's boot-time start, wlan0 MAC keeping and btd/accessoryd handling are not carried.
+# radio up|down|status (also as radio-up / radio-down): the Wi-Fi/BT module ON DEMAND. Nothing runs this
+# at boot; the radios stay off until it is called (README §2.5).
+#
+# up    1. load the MMC host (sdhci-esdhc-imx): it switches the module's power on through reg_wlan
+#          (vmmc-supply of usdhc1 in the DT; userspace has no other handle on that regulator) and
+#          enumerates the SDIO card
+#       2. identify the chip by the card's own SDIO vendor:device (/sys/bus/sdio/devices/*/):
+#            0x02df:0x9159  NXP IW416 (SD8978)  mwifiex_sdio (mrvl/sdiouartiw416_combo_v0.bin),
+#                                                BT: btnxpuart after the combo firmware (DT node nxp,88w8987-bt)
+#            0x024c:0xc822  Realtek RTL8822CS   rtw88_8822cs (rtw88/rtw8822c_fw.bin),
+#                                                BT: hci_uart H5 + btrtl (DT node realtek,rtl8822cs-bt)
+#            0x024c:0xb822  Realtek RTL8822BS   rtw88_8822bs (rtw88/rtw8822b_fw.bin), Wi-Fi only (LIVI:
+#                                                btrtl knows the 8822B over USB only; UNVERIFIED)
+#          an unknown id is reported and nothing is loaded for it (the module stays powered: radio down)
+#       3. bring every wireless interface administratively up (names are the driver's: mlan0 on mwifiex,
+#          wlan0 on rtw88; enumerated from /sys/class/net/*/phy80211, never assumed) and, when the kernel
+#          image carries the chip's Bluetooth DT node (RADIO_DT=<chip> build), the HCI device with hciup.
+#          "administratively up, no carrier" is the state until a network is joined (wifi-connect).
+#       Bluetooth WITHOUT that DT node (btattach on /dev/ttymxc2) is not done here: UNVERIFIED.
+#       Every module loads after its dependencies, from modules.dep (lib/baseline/radio-lib.sh mod_load, B10).
+# down  wifi-connect's wpa_supplicant/udhcpc stopped, interfaces down, HCI down, radio modules unloaded,
+#       MMC host unloaded (reg_wlan off), checked
+# status  what is powered, loaded and up (the same interface wording as up: admin state, carrier, operstate)
+# MWIFIEX_DRIVER_MODE=<n> passes driver_mode to the mwifiex module (0x1 station = default, 0x3 AP + station).
+# It is a parameter of mwifiex, not of mwifiex_sdio, and is read only when mwifiex loads, so mwifiex is
+# loaded with it before mwifiex_sdio (corrected 2026-10-20: it was passed to mwifiex_sdio, which has no
+# parameters). AP mode itself is UNVERIFIED.
+. "${RADIO_ETC:-/etc/baseline}/board.env"
+. "${RADIO_LIB:-/lib/baseline}/radio-lib.sh"
+HOST=${RADIO_MMC_HOST:-2190000.mmc}
+HOSTDRV=$SYS/bus/platform/drivers/sdhci-esdhc-imx
+FW=/lib/firmware
+# Unload order for `down` (absent ones are skipped; repeated until nothing more unloads).
+# The Bluetooth core (CONFIG_BT=m, radio-modules.fragment) is a module too: rfcomm (bt-proto-3, loaded
+# by the kernel on demand) and bluetooth itself, then the helpers bluetooth pulls in (ecdh_generic, ecc).
+# They come after the chip and hci_uart drivers that depend on them and are skipped when absent or built
+# in; a helper still used by another module stays loaded and rmmod fails quietly.
+MODS="btnxpuart hci_uart btrtl btintel btbcm btmtk rfcomm bluetooth ecdh_generic ecc mwifiex_sdio mwifiex rtw88_8822cs rtw88_8822bs rtw88_sdio
+rtw88_8822c rtw88_8822b rtw88_core mac80211 cfg80211 sdhci_esdhc_imx sdhci_pltfm sdhci cqhci mmc_core"
+
+say() { echo "radio: $*"; }
+
+reg_wlan() {
+    for r in "$SYS"/class/regulator/regulator.*; do
+        [ "$(cat "$r/name" 2>/dev/null)" = wlan ] || continue
+        echo "$(cat "$r/state" 2>/dev/null || echo unknown), users $(cat "$r/num_users" 2>/dev/null)"
+        return 0
+    done
+    echo "not found"
+}
+
+sdio_ids() {
+    for f in "$SYS"/bus/sdio/devices/*; do
+        [ -r "$f/vendor" ] || continue
+        echo "${f##*/} $(cat "$f/vendor"):$(cat "$f/device")"
+    done
+}
+
+# The compatible of the Bluetooth child of uart3 in the running DT, if the image has one.
+bt_node() {
+    for c in "$SYS"/bus/serial/devices/*/of_node/compatible; do
+        [ -r "$c" ] && { tr '\0' ' ' < "$c"; echo; return 0; }
+    done
+    return 1
+}
+
+loaded() { grep -q "^$1 " "$MODLOAD_PROC"; }
+
+# assoc IF: the station's association, when iw is there ("not associated" / "associated with ... SSID x")
+assoc() {
+    command -v iw > /dev/null 2>&1 || return 0
+    _li=$(iw dev "$1" link 2>/dev/null)
+    case $_li in
+        Connected*) echo "associated with $(echo "$_li" | sed -n 's/^Connected to \([0-9a-f:]*\).*/\1/p'), SSID $(echo "$_li" | sed -n 's/^[[:space:]]*SSID: //p')" ;;
+        *) echo "not associated (wifi-connect <ssid> [psk])" ;;
+    esac
+}
+
+need_fw() {
+    for f in "$@"; do
+        [ -s "$FW/$f" ] || { say "firmware $FW/$f is missing: the driver will fail"; return 1; }
+    done
+}
+
+status() {
+    say "reg_wlan (module power): $(reg_wlan)"
+    if [ -e "$HOSTDRV/$HOST" ]; then say "MMC host $HOST: bound"; else say "MMC host $HOST: not bound"; fi
+    ids=$(sdio_ids)
+    say "SDIO functions: ${ids:-none}"
+    m=
+    for x in $MODS; do loaded "$x" && m="$m $x"; done
+    say "radio modules loaded:${m:- none}"
+    for i in $(wifs); do
+        say "wireless interface $i: $(ifstate "$i"), $(cat "$SYS/class/net/$i/address")"
+        a=$(assoc "$i")
+        [ -n "$a" ] && say "  $i: $a"
+        [ -s "$RUN/wpa_supplicant-$i.pid" ] && say "  $i: wpa_supplicant running (wifi-connect --status -i $i)"
+    done
+    [ -n "$(wifs)" ] || say "wireless interfaces: none; $(radio_off_hint)"
+    for h in $(hcis); do say "$(hciup -i "$h" 2>&1)"; done
+    say "Bluetooth DT node: $(bt_node || echo none)"
+}
+
+up() {
+    if [ ! -e "$HOSTDRV/$HOST" ]; then
+        if loaded sdhci_esdhc_imx; then
+            echo "$HOST" > "$HOSTDRV/bind" 2>/dev/null || { say "binding $HOST to sdhci-esdhc-imx failed (dmesg)"; return 1; }
+        else
+            mod_load sdhci_esdhc_imx || { say "loading sdhci-esdhc-imx failed"; return 1; }
+        fi
+    fi
+    n=0
+    while [ -z "$(sdio_ids)" ] && [ "$n" -lt 20 ]; do
+        usleep 500000
+        n=$((n + 1))
+    done
+    say "module power (reg_wlan): $(reg_wlan)"
+    ids=$(sdio_ids)
+    [ -n "$ids" ] || { say "no SDIO card enumerated in 10 s (dmesg); 'radio down' powers the module off"; return 1; }
+    say "SDIO: $ids"
+    chip=
+    for id in $(echo "$ids" | while read -r _f vd; do echo "$vd"; done); do
+        case $id in
+            0x02df:0x9159) chip=iw416 ;;
+            0x024c:0xc822) chip=rtl8822cs ;;
+            0x024c:0xb822) chip=rtl8822bs ;;
+        esac
+        [ -n "$chip" ] && break
+    done
+    node=$(bt_node)
+    case $chip in
+        iw416)
+            say "NXP IW416: mwifiex_sdio${MWIFIEX_DRIVER_MODE:+ (mwifiex driver_mode=$MWIFIEX_DRIVER_MODE)}"
+            need_fw mrvl/sdiouartiw416_combo_v0.bin
+            if [ -n "${MWIFIEX_DRIVER_MODE:-}" ]; then
+                loaded mwifiex && say "mwifiex is already loaded: driver_mode=$MWIFIEX_DRIVER_MODE not applied ('radio down' first)"
+                mod_load mwifiex driver_mode="$MWIFIEX_DRIVER_MODE" || say "loading mwifiex driver_mode=$MWIFIEX_DRIVER_MODE failed"
+            fi
+            mod_load mwifiex_sdio || say "loading mwifiex_sdio failed"
+            btmod=btnxpuart btnode=nxp,88w8987-bt
+            ;;
+        rtl8822cs)
+            say "Realtek RTL8822CS: rtw88_8822cs"
+            need_fw rtw88/rtw8822c_fw.bin
+            mod_load rtw88_8822cs || say "loading rtw88_8822cs failed"
+            btmod=hci_uart btnode=realtek,rtl8822cs-bt
+            need_fw rtl_bt/rtl8822cs_fw.bin rtl_bt/rtl8822cs_config.bin
+            ;;
+        rtl8822bs)
+            say "Realtek RTL8822BS: rtw88_8822bs (Wi-Fi only)"
+            need_fw rtw88/rtw8822b_fw.bin
+            mod_load rtw88_8822bs || say "loading rtw88_8822bs failed"
+            btmod='' btnode=''
+            ;;
+        *)
+            say "unknown radio ($ids): no driver loaded; the module stays powered, 'radio down' switches it off"
+            return 1
+            ;;
+    esac
+    n=0
+    while [ -z "$(wifs)" ] && [ "$n" -lt 20 ]; do
+        usleep 500000
+        n=$((n + 1))
+    done
+    [ -n "$(wifs)" ] || say "no wireless interface appeared (dmesg: firmware download?)"
+    for i in $(wifs); do
+        if ip link set dev "$i" up; then
+            say "Wi-Fi: $i $(ifstate "$i"), $(cat "$SYS/class/net/$i/address"); join a network: wifi-connect <ssid> [psk]"
+        else
+            say "Wi-Fi: $i could not be set administratively up (dmesg)"
+        fi
+    done
+    if [ -z "$btmod" ]; then
+        say "Bluetooth: none for this chip"
+    elif [ -z "$node" ]; then
+        say "Bluetooth: this kernel image has no Bluetooth DT node (use the RADIO_DT=$chip image); not attached"
+    else
+        case $node in
+            *"$btnode"*) ;;
+            *) say "Bluetooth: the DT node is '$node', expected $btnode: wrong RADIO_DT image for this chip"; return 1 ;;
+        esac
+        mod_load "$btmod" || say "loading $btmod failed"
+        n=0
+        while [ -z "$(hcis)" ] && [ "$n" -lt 20 ]; do
+            usleep 500000
+            n=$((n + 1))
+        done
+        h=$(hcis | head -n 1)
+        if [ -z "$h" ]; then
+            say "Bluetooth: no HCI device appeared (dmesg)"
+        else
+            # The kernel powers a new controller for its setup and off again 2 s later when no
+            # Bluetooth daemon claims it; give that setup time, then bring it up for good.
+            sleep 3
+            say "Bluetooth: $(hciup "$h" 2>&1)"
+            command -v bt-scan > /dev/null 2>&1 && say "Bluetooth: scan with bt-scan"
+        fi
+    fi
+    say "done ('radio status', 'radio down')"
+}
+
+down() {
+    # wifi-connect's daemons first: a wpa_supplicant/udhcpc left on an interface that disappears
+    command -v wifi-connect > /dev/null 2>&1 && wifi-connect --stop > /dev/null 2>&1
+    for i in $(wifs); do ip link set dev "$i" down 2>/dev/null; done
+    for h in $(hcis); do hciup -d "$h" > /dev/null 2>&1; done
+    pass=0
+    while [ "$pass" -lt 4 ]; do
+        for m in $MODS; do loaded "$m" && rmmod "$m" 2>/dev/null; done
+        pass=$((pass + 1))
+    done
+    if [ -e "$HOSTDRV/$HOST" ]; then
+        echo "$HOST" > "$HOSTDRV/unbind" 2>/dev/null && say "MMC host $HOST unbound (its module is still in use)"
+    fi
+    left=
+    for m in $MODS; do loaded "$m" && left="$left $m"; done
+    [ -n "$left" ] && say "still loaded:$left"
+    say "module power (reg_wlan): $(reg_wlan)"
+    ids=$(sdio_ids)
+    [ -z "$ids" ] || { say "SDIO card still present: $ids"; return 1; }
+    say "radio off"
+}
+
+case ${0##*/} in
+    radio-up) up; exit $? ;;
+    radio-down) down; exit $? ;;
+esac
+case ${1:-} in
+    up) up ;;
+    down) down ;;
+    status) status ;;
+    *) echo "usage: radio up|down|status (or radio-up / radio-down)" >&2; exit 2 ;;
+esac
