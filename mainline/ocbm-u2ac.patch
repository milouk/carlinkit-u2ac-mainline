@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Merged after base.fragment; build.sh only WARNS if one of these does not survive (symbols whose
+# name or existence in 7.2.10 is not verified). UNMEASURED size effect.
+# Initrd decompressors: the initramfs is built in and uncompressed (the kernel image is XZ as a
+# whole), so none is needed. LIVI kept the defaults; this is a size change against LIVI.
+# CONFIG_RD_GZIP is not set
+# CONFIG_RD_BZIP2 is not set
+# CONFIG_RD_LZMA is not set
+# CONFIG_RD_XZ is not set
+# CONFIG_RD_LZO is not set
+# CONFIG_RD_LZ4 is not set
+# CONFIG_RD_ZSTD is not set
+# The legacy /sys/class/gpio export interface, if 7.2 splits it out of GPIO_SYSFS.
+CONFIG_GPIO_SYSFS_LEGACY=y
diff --git a/baseline/arm-imx6ul-u2ac/kernel/base.fragment b/baseline/arm-imx6ul-u2ac/kernel/base.fragment
new file mode 100644
index 0000000..ba00749
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/kernel/base.fragment
@@ -0,0 +1,188 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+# Modified 2026-10-19/20: a Kconfig fragment instead of a scripts/config list; KEPT and DROPPED below.
+# Kconfig fragment, merged onto allnoconfig (scripts/kconfig/merge_config.sh -n) for linux 7.2.10.
+# Derived from the scripts/config list in LIVI scripts/livi-link/arm/imx6ul/build.sh
+# (https://github.com/f-io/LIVI, GPL-3.0-or-later). build.sh fails if any value below does not
+# survive into the final .config (a dropped dependency is otherwise silent).
+# KEPT from LIVI: i.MX6UL/ULL core, VFP/NEON, !SMP, PREEMPT, size, XZ kernel, modules, built-in
+# initramfs, squashfs+xz, pseudo fs, serial console, I2C, GPIO, LEDs, watchdog, OCOTP, QSPI NOR,
+# chipidea UDC + NCM/ACM, IPv4/IPv6. DROPPED (built-in): Wi-Fi/cfg80211, Bluetooth, bridge, MMC/SDHCI
+# (radio drivers are rootfs modules, radio-modules.fragment). See README "Changes against LIVI".
+CONFIG_MMU=y
+CONFIG_ARCH_MULTIPLATFORM=y
+CONFIG_ARCH_MULTI_V7=y
+CONFIG_ARCH_MXC=y
+CONFIG_SOC_IMX6UL=y
+# The i.MX6UL/ULL pin controller. Its Kconfig default (`default SOC_IMX6UL`) never applies in THIS
+# flow: merge_config.sh -n feeds the fragment into the allnoconfig pass itself, which answers every
+# visible prompt not named here with n, and the later olddefconfig keeps that n. LIVI's flow differs
+# (allnoconfig first, then scripts/config, then olddefconfig: symbols that only became visible after the
+# enables get their Kconfig defaults), so LIVI's kernel has it without naming it (corrected 2026-10-20:
+# this comment said LIVI's config lacks it; review: LIVI's shipped Image contains imx6ul-pinctrl). Same
+# mechanism for NVMEM_SYSFS and ARM_THUMB below. Without it every node with pinctrl-0 (uart1, i2c, gpio
+# banks, reg_wlan) keeps deferring its probe (drivers/pinctrl/devicetree.c: -EPROBE_DEFER when no pin
+# controller driver exists and MODULES=y) and no DT pin muxing is applied (QEMU 2026-10-20: gpio-mxc
+# -517, no console).
+CONFIG_PINCTRL_IMX6UL=y
+CONFIG_ARM_APPENDED_DTB=y
+# CONFIG_ARM_ATAG_DTB_COMPAT is not set
+CONFIG_VFP=y
+CONFIG_VFPv3=y
+CONFIG_NEON=y
+# Thumb user binaries: Debian/Ubuntu armhf gcc defaults to -mthumb, and without ARM_THUMB the kernel
+# rejects a Thumb-entry ELF with ENOEXEC (QEMU 2026-10-20: "Failed to execute /init (error -8)").
+CONFIG_ARM_THUMB=y
+# CONFIG_SMP is not set
+CONFIG_PREEMPT=y
+CONFIG_CC_OPTIMIZE_FOR_SIZE=y
+CONFIG_KERNEL_LZO=y
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+CONFIG_EXPERT=y
+# CONFIG_IO_URING is not set
+# CONFIG_ETHTOOL_NETLINK is not set
+CONFIG_PRINTK=y
+CONFIG_PRINTK_TIME=y
+CONFIG_BUG=y
+CONFIG_FUTEX=y
+CONFIG_EPOLL=y
+CONFIG_EVENTFD=y
+CONFIG_SIGNALFD=y
+CONFIG_TIMERFD=y
+CONFIG_POSIX_TIMERS=y
+CONFIG_MULTIUSER=y
+CONFIG_FILE_LOCKING=y
+CONFIG_ADVISE_SYSCALLS=y
+CONFIG_SHMEM=y
+CONFIG_COMPAT_32BIT_TIME=y
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_NO_HZ_IDLE=y
+CONFIG_SYSVIPC=y
+CONFIG_INOTIFY_USER=y
+CONFIG_BLOCK=y
+CONFIG_BLK_DEV_WRITE_MOUNTED=y
+CONFIG_BINFMT_ELF=y
+CONFIG_BINFMT_SCRIPT=y
+CONFIG_PROC_FS=y
+# U2AC: /proc/sys is in kernel-<series>/sysctl.fragment (7.2: PROC_SYSCTL, 7.3: renamed SYSCTL)
+CONFIG_SYSFS=y
+CONFIG_TMPFS=y
+CONFIG_DEVTMPFS=y
+CONFIG_CONFIGFS_FS=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_INITRAMFS_COMPRESSION_NONE=y
+CONFIG_MISC_FILESYSTEMS=y
+CONFIG_SQUASHFS=y
+CONFIG_SQUASHFS_XZ=y
+CONFIG_TTY=y
+CONFIG_UNIX98_PTYS=y
+CONFIG_SERIAL_IMX=y
+CONFIG_SERIAL_IMX_CONSOLE=y
+CONFIG_I2C=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_IMX=y
+CONFIG_GPIOLIB=y
+CONFIG_GPIO_MXC=y
+CONFIG_GPIO_SYSFS=y
+CONFIG_NEW_LEDS=y
+CONFIG_LEDS_CLASS=y
+CONFIG_LEDS_GPIO=y
+CONFIG_LEDS_TRIGGERS=y
+CONFIG_LEDS_TRIGGER_HEARTBEAT=y
+CONFIG_LEDS_TRIGGER_TIMER=y
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_REGULATOR_ANATOP=y
+CONFIG_WATCHDOG=y
+CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
+CONFIG_IMX2_WDT=y
+CONFIG_NVMEM=y
+CONFIG_NVMEM_IMX_OCOTP=y
+# /sys/bus/nvmem/devices/imx-ocotp0/nvmem (ocbm-identity's chip-ID source) exists only with this;
+# allnoconfig drops it (QEMU 2026-10-20: the device was there, the nvmem file was not)
+CONFIG_NVMEM_SYSFS=y
+CONFIG_MTD=y
+CONFIG_MTD_BLOCK=y
+# (no MTD_CHAR symbol: mtdchar.o is part of mtd-y in drivers/mtd/Makefile, always built with MTD;
+#  verified against 7.2.10 on 2026-10-20)
+CONFIG_MTD_OF_PARTS=y
+CONFIG_MTD_SPI_NOR=y
+# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
+CONFIG_SPI=y
+CONFIG_SPI_MEM=y
+CONFIG_SPI_FSL_QUADSPI=y
+CONFIG_USB_SUPPORT=y
+CONFIG_USB_PHY=y
+CONFIG_USB_MXS_PHY=y
+CONFIG_USB_CHIPIDEA=y
+CONFIG_USB_CHIPIDEA_UDC=y
+CONFIG_USB_CHIPIDEA_IMX=y
+# CONFIG_USB_CHIPIDEA_HOST is not set
+CONFIG_USB_GADGET=y
+CONFIG_USB_LIBCOMPOSITE=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_NCM=y
+CONFIG_USB_CONFIGFS_ACM=y
+# FunctionFS (revision 6, 2026-10-30): the userspace gadget function behind `net-up ocbm`.
+# common/ocbm-accessory serves ocbmd's /dev/usb_accessory over its two bulk endpoint files (README
+# §2.8). The kernel has no Android accessory function; this is the only mainline way to a vendor
+# bulk interface. Selects USB_F_FS (and with it DMA_SHARED_BUFFER); built in, the rootfs has no
+# module loader in the boot path and the gadget scripts assume the fs type is present.
+CONFIG_USB_CONFIGFS_F_FS=y
+CONFIG_NET=y
+CONFIG_INET=y
+# U2AC: no IPv6 (everything binds IPv4; -120..170 KB of kernel image)
+# CONFIG_IPV6_SIT is not set
+CONFIG_PACKET=y
+CONFIG_UNIX=y
+CONFIG_NETDEVICES=y
+CONFIG_FW_LOADER=y
+# CONFIG_WIRELESS is not set
+# CONFIG_WLAN is not set
+# CONFIG_CFG80211 is not set
+# CONFIG_BT is not set
+# CONFIG_BRIDGE is not set
+# CONFIG_MMC is not set
+# CONFIG_IMX_MU_MSI is not set
+CONFIG_DEVMEM=y
+# CONFIG_STRICT_DEVMEM is not set
+CONFIG_MAGIC_SYSRQ=y
+CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
+# U2AC (2026-11-26): CPU frequency scaling + idle + thermal (stock ran cpufreq 396-900 MHz with a governor);
+# perf when busy, low clocks/heat when idle (ondemand: schedutil needs SMP, this kernel is UP). imx6q-cpufreq handles the 6UL/6ULL OPPs (speed-grade fuse capped).
+CONFIG_CPU_FREQ=y
+CONFIG_CPU_FREQ_STAT=y
+CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
+CONFIG_CPU_FREQ_GOV_ONDEMAND=y
+CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
+CONFIG_CPU_FREQ_GOV_POWERSAVE=y
+CONFIG_ARM_IMX6Q_CPUFREQ=y
+CONFIG_CPU_IDLE=y
+CONFIG_THERMAL=y
+CONFIG_IMX_THERMAL=y
+# U2AC wireless Android Auto (aa-proxy-rs): FunctionFS endpoint I/O may use Linux AIO (off in allnoconfig).
+CONFIG_AIO=y
+# U2AC kernel audit (2026-11-26, mainline/audit/KERNEL_AUDIT.md). allnoconfig + merge_config -n turns off every
+# default-y option not named here, so these were silently lost:
+#  - the rootfs is squashfs xz with the ARM BCJ filter: without these decoders most blocks fail to read
+CONFIG_XZ_DEC_ARM=y
+CONFIG_XZ_DEC_ARMTHUMB=y
+#  - Cortex-A7 has a hardware divider
+CONFIG_ARM_PATCH_IDIV=y
+#  - thermal: cpufreq cooling (passive trip actually throttles) + emergency path
+CONFIG_THERMAL_OF=y
+CONFIG_CPU_THERMAL=y
+CONFIG_CPU_FREQ_THERMAL=y
+CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=10000
+# NOT PANIC_ON_OOPS: an oops in a built-in driver before recovery's NCM is up would then reboot-loop the unit
+# (SPI-only recovery); real panics still reboot via panic=10 in bootargs.
+CONFIG_PANIC_TIMEOUT=10
+# the configfs gadgets' MaxPower default: tell the head unit 500 mA, not 2 mA
+CONFIG_USB_GADGET_VBUS_DRAW=500
+# ondemand reacts in 8 ms ticks instead of 20
+CONFIG_HZ_250=y
+# NOT HW_RANDOM_IMX_RNGC: its probe reads 0x02284000 at boot; QEMU aborts there (external abort -> panic in
+# PID 1) and some 6ULL parts fuse the block off -> a boot panic before recovery = SPI rescue. Not worth it.
+# RAM: 32 KiB printk buffer
+CONFIG_LOG_BUF_SHIFT=15
