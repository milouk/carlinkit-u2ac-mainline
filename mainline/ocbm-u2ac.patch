+    rows($("#d-ver"), Object.keys(L).filter(k => v[k]).map(k => [L[k], v[k]]));
+    const t = a.cpu.time_in_state, sum = t.reduce((x, y) => x + y.ticks, 0) || 1, r = $("#res"); r.replaceChildren();
+    if (!t.length) r.append(el("div", "empty", "This kernel does not record time per speed."));
+    for (const x of t) { const row = el("div", "res"), m = el("div", "meter"), i = el("i"), p = x.ticks / sum * 100; i.style.width = p.toFixed(1) + "%"; m.append(i);
+      row.append(el("span", "num", Math.round(x.khz / 1000) + " MHz"), m, el("span", "num sub", p < 1 && p > 0 ? "<1%" : Math.round(p) + "%")); r.append(row); }
+    if (a.cpu.governor) r.append(el("p", "sub", "Speed policy: " + a.cpu.governor + "."));
+  }).catch(() => toast("Could not read the versions.", true));
+}
+$("#aap").textContent = "ssh -L 8080:127.0.0.1:8080 root@" + location.hostname;
+
+/* ---------- tabs ---------- */
+function showTab(t){
