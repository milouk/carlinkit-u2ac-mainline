diff --git a/baseline/arm-imx6ul-u2ac/rootfs/etc/baseline/board-rcS.sh b/baseline/arm-imx6ul-u2ac/rootfs/etc/baseline/board-rcS.sh
new file mode 100644
index 0000000..2282d11
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/etc/baseline/board-rcS.sh
@@ -0,0 +1,126 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# i.MX6ULL hooks for common/rootfs/etc/init.d/rcS. LEDs (gpio-leds, pins and polarity from LIVI's DTS;
+# on hardware UNVERIFIED for the baseline), as `led` documents them:
+#   blue  heartbeat trigger from kernel start (DT linux,default-trigger): the kernel is alive
+#   red   on from kernel start (DT default-state); recovery blinks it 500/500 ms (100/100 ms while a
+#         flash helper writes, solid on after a write that failed once started); a rootfs whose ways
+#         in (NCM + SSH) are up turns it off; a rootfs where one is not up leaves it on (reason on the
+#         console and in /run/baseline/rcS.log)
+# No radio, no MFi daemon at boot: radio-up brings the Wi-Fi/BT module up on demand, mfi-probe reads the
+# MFi coprocessor (/dev/i2c-1, address 0x11: the &i2c2 controller on the UART5 pads, numbered 1 by the
+# imx6ul.dtsi i2c aliases).
+board_early() {
+    # U2AC: feed the i.MX watchdog from the rootfs only (recovery never opens it, so a flash write there is
+    # never cut short). A hung userspace reboots the dongle after 30 s; an unexpected close does not stop it.
+    # The feeder itself must never be the OOM victim (aa-proxy-rs is -900, the radio daemons -500): once the
+    # device is open the i.MX WDOG cannot be stopped, so a killed feeder = a reboot 30 s later, mid-drive.
+    [ -c /dev/watchdog ] && watchdog -T 30 -t 5 /dev/watchdog \
+        && for _w in $(pgrep -x watchdog); do echo -1000 > /proc/$_w/oom_score_adj; done 2>/dev/null
+    # Wireless Android Auto as early as possible: radios + BT patch load in parallel with persist/NCM/SSH
+    # (u2ac-aa waits for /run/persist.loaded before it touches /run/persist)
+    /usr/sbin/u2ac-aa start > /run/log/u2ac-aa.start 2>&1 &
+}
+
+board_late() {
+    # U2AC (2026-11-26): the red LED is the vendor's power LED (on = powered, like stock), so it stays on.
+    # Wireless Android Auto starts whether or not NCM came up (in the car nothing is on the NCM side).
+    [ "$1" = 1 ] || echo "rcS: NCM/SSH not up (Android Auto was started from board_early anyway)"
+}
+
+# U2AC (2026-11-27): car or computer on the USB port BEFORE NCM, so a car never sees the NCM gadget (Ford
+# SYNC 3: "USB device not supported" at every plug-in). The port shows aa-proxy-rs's own MTP-stage identity
+# (an Android phone) served by u2ac-usbprobe (tools/u2ac-usbprobe.c); a head unit asks it AOA GET_PROTOCOL at
+# once, a computer never does. Verdict in /run/u2ac-usbprobe, read by u2ac-aa:
+#   car    -> no NCM; the port stays empty until aa-proxy-rs presents Android Auto (phone in)
+#   noaoa  -> NCM as before (a computer, or a car that waits for the driver: u2ac-aa's NCM test decides)
+#   none   -> nobody configured the port within 1.5 s: no NCM now; the probe keeps the port until ~10 s for a
+#             host that comes later (a car still booting: car; a computer: NCM is brought up then). rcS goes
+#             on (and marks the boot slot) after those 1.5 s, so a cranking car does not cut boots short
+#   dev / missing -> NCM as before (dev mode, or the probe could not start: never worse than before)
+# Returns 1 when rcS must not bring NCM up (car, or nobody yet), 0 for NCM.
+UPG=/sys/kernel/config/usb_gadget/u2acprobe UPF=/run/u2ac-probe UPO=/run/u2ac-usbprobe.out
+usbprobe_up() {
+    _u=; _n=0
+    while [ -z "$_u" ] && [ $_n -lt 30 ]; do
+        for _d in /sys/class/udc/*; do
+            case $(readlink -f "$_d") in */"${NCM_UDC_MATCH:-}"*) _u=${_d##*/}; break ;; esac
+        done
+        [ -n "$_u" ] || { sleep 0.1; _n=$((_n + 1)); }
+    done
+    [ -n "$_u" ] || return 1
+    mkdir -p "$UPG/strings/0x409" "$UPG/configs/c.1/strings/0x409" "$UPG/functions/ffs.u2acprobe" "$UPF" \
+        || return 1
+    # the MTP stage of aa-proxy-rs v1.3.0 (usb_functionfs.rs): 18d1:4ee1, bcdDevice 0x3008, class at the
+    # interface, "aa-proxy" / "aa-proxy (<DT model>)" / serial 0123456 (no DT serial-number), config "config"
+    echo 0x18d1 > "$UPG/idVendor"; echo 0x4ee1 > "$UPG/idProduct"
+    echo 0x3008 > "$UPG/bcdDevice"; echo 0x0200 > "$UPG/bcdUSB"
+    for _a in bDeviceClass bDeviceSubClass bDeviceProtocol; do echo 0x00 > "$UPG/$_a"; done
+    echo aa-proxy > "$UPG/strings/0x409/manufacturer"
+    echo "aa-proxy ($(tr -d '\0' < /sys/firmware/devicetree/base/model 2> /dev/null))" > "$UPG/strings/0x409/product"
+    echo 0123456 > "$UPG/strings/0x409/serialnumber"
+    echo config > "$UPG/configs/c.1/strings/0x409/configuration"
+    mount -t functionfs u2acprobe "$UPF" || return 1
+    : > "$UPO"
+    u2ac-usbprobe "$UPF" 10000 3000 > "$UPO" 2>> /run/log/u2ac-usbprobe.log &
+    echo $! > /run/u2ac-usbprobe.pid
+    _n=0; while [ ! -e "$UPF/ep1" ] && [ $_n -lt 30 ]; do sleep 0.1; _n=$((_n + 1)); done
+    [ -e "$UPF/ep1" ] || return 1
+    ln -s "$UPG/functions/ffs.u2acprobe" "$UPG/configs/c.1/" && echo "$_u" > "$UPG/UDC"
+}
+# usbprobe_down: the port empty again and the probe gadget gone (NCM's own gadget is "baseline")
+usbprobe_down() {
+    # a probe still running holds ep0 (and so the functionfs mount): stop it and wait for it (max 1 s)
+    if [ -s /run/u2ac-usbprobe.pid ]; then
+        _p=$(cat /run/u2ac-usbprobe.pid); kill "$_p" 2> /dev/null
+        _w=0; while kill -0 "$_p" 2> /dev/null && [ $_w -lt 20 ]; do sleep 0.05; _w=$((_w + 1)); done
+    fi
+    [ -e "$UPG/UDC" ] && echo "" > "$UPG/UDC" 2> /dev/null
+    rm -f "$UPG/configs/c.1/ffs.u2acprobe" /run/u2ac-usbprobe.pid
+    umount "$UPF" 2> /dev/null
+    rmdir "$UPG/functions/ffs.u2acprobe" "$UPG/configs/c.1/strings/0x409" "$UPG/configs/c.1" \
+        "$UPG/strings/0x409" "$UPG" 2> /dev/null
+    return 0
+}
+# usbprobe_end: wait for the probe's verdict, free the port, record the verdict
+usbprobe_end() {
+    _p=$(cat /run/u2ac-usbprobe.pid 2> /dev/null)
+    [ -n "$_p" ] && while kill -0 "$_p" 2> /dev/null; do sleep 0.05; done
+    _v=$(tail -n 1 "$UPO" 2> /dev/null)
+    rm -f /run/u2ac-usbprobe.pid
+    usbprobe_down
+    case $_v in car | noaoa | none) ;; *) _v=failed ;; esac
+    echo "$_v" > /run/u2ac-usbprobe
+}
+board_usb_probe() {
+    rm -f /run/u2ac-usbprobe
+    if [ -e /run/persist/u2ac-dev ]; then echo dev > /run/u2ac-usbprobe; return 0; fi
+    command -v u2ac-usbprobe > /dev/null 2>&1 || return 0
+    if ! usbprobe_up; then
+        usbprobe_down; echo failed > /run/u2ac-usbprobe; return 0
+    fi
+    # a car answers at once, a computer configures within ~0.5 s (Mac 0.2-0.45 s) and then stays silent for
+    # 3 s; a host that configures after 1.5 s is handled by the late path below like any other
+    _n=0
+    while :; do
+        _v=$(tail -n 1 "$UPO" 2> /dev/null)
+        case $_v in car | noaoa | none) break ;; esac
+        # a probe that never ends (it cannot, its windows are bounded): the port goes back to NCM after 15 s
+        [ $_n -ge 150 ] && { usbprobe_down; echo failed > /run/u2ac-usbprobe; return 0; }
+        if [ $_n -ge 15 ] && [ "$_v" != configured ]; then
+            # nobody yet (a car still booting): rcS goes on without NCM, the probe keeps the port
+            (
+                usbprobe_end
+                if [ "$(cat /run/u2ac-usbprobe)" = noaoa ]; then
+                    # a host came late and is not a car (so far): NCM after all, as rcS would have
+                    echo noaoa-late > /run/u2ac-usbprobe.how
+                    _i=$(net-up ncm 2>> /run/log/net-up.log) && ssh-up "$NCM_DEV_IP" 2>> /run/log/ssh-up.log \
+                        && echo "rcS: NCM $_i $NCM_DEV_IP (a host came late, no AOA)"
+                fi
+            ) &
+            return 1
+        fi
+        sleep 0.1; _n=$((_n + 1))
+    done
+    usbprobe_end
+    [ "$_v" = noaoa ]
+}
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/etc/baseline/udhcpc.sh b/baseline/arm-imx6ul-u2ac/rootfs/etc/baseline/udhcpc.sh
new file mode 100755
index 0000000..551058c
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/etc/baseline/udhcpc.sh
@@ -0,0 +1,36 @@
+#!/bin/sh
+# shellcheck disable=SC2154 # interface, ip, mask, router, dns, domain: udhcpc's environment
+# SPDX-License-Identifier: GPL-3.0-or-later
+# udhcpc event script for wifi-connect (busybox udhcpc -s): configures ONLY the Wi-Fi interface udhcpc
+# runs on, never usb0/NCM. RAM only: the address and route live in the kernel, DNS in /run/resolv.conf
+# (/etc/resolv.conf links there). Variables from udhcpc: interface ip mask broadcast router dns domain.
+RUN=${RADIO_RUN:-/run}
+[ -n "${1:-}" ] && [ -n "${interface:-}" ] || exit 1
+case $1 in
+    deconfig)
+        ip -4 addr flush dev "$interface"
+        ip link set dev "$interface" up
+        ;;
+    bound | renew)
+        ip -4 addr flush dev "$interface"
+        ip addr add "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface" || exit 1
+        if [ -n "${router:-}" ]; then
+            while ip route del default dev "$interface" 2> /dev/null; do :; done
+            for r in $router; do
+                ip route add default via "$r" dev "$interface" metric 10 && break
+            done
+        fi
+        if [ -n "${dns:-}" ]; then
+            {
+                echo "# udhcpc on $interface (wifi-connect)"
+                [ -n "${domain:-}" ] && echo "search $domain"
+                for d in $dns; do echo "nameserver $d"; done
+            } > "$RUN/resolv.conf.$interface" && mv "$RUN/resolv.conf.$interface" "$RUN/resolv.conf"
+        fi
+        echo "udhcpc: $interface $1 $ip/${mask:-24}${router:+ via $router}"
+        ;;
+    leasefail | nak)
+        echo "udhcpc: $interface $1"
+        ;;
+esac
+exit 0
