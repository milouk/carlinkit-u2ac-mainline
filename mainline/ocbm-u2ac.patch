diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-aa b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-aa
new file mode 100755
index 0000000..a6fea8f
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-aa
@@ -0,0 +1,1001 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# u2ac-aa start|stop|status|persist|aa-now|watch|home-now [all]|dev on|off|aa|flightlog [last|SEQ]  (Carlinkit U2AC, milouk 2026-11-26)
+# Wireless Android Auto on mainline: BCM4358 Wi-Fi (brcmfmac) + BT (hci_bcm), a 5 GHz AP, DHCP, D-Bus,
+# BlueZ and aa-proxy-rs (aa-proxy/aa-proxy-rs v1.3.0, FunctionFS AOA gadget toward the car).
+#  - Calls / microphone: aa-proxy-rs only bootstraps over Bluetooth (AA Wireless RFCOMM + a log-only HSP
+#    stub); it never takes the phone's calls, so call audio and the mic stay between the phone and the
+#    car's own Bluetooth (the stock firmware needed hfpd killed for the same reason). The hands-free guard
+#    (patch 0004, aa_run) keeps a second, silent hands-free link to the phone so Android sends the car
+#    in-band ringing off: SYNC 3's own-ringtone mode loses the microphone of incoming calls otherwise.
+#  - Persistent state (pairings, aa-proxy-rs config + known devices) lives in /run/persist (the customer MTD
+#    archive, `persist save`), saved only when it changes.
+#  - USB port: at boot it first shows an Android phone (u2ac-usbprobe, board-rcS.sh): a CAR asks it AOA at once
+#    and never sees NCM. A COMPUTER (silent there, then it activates the NCM link and answers at
+#    192.168.50.100) keeps this boot in maintenance mode (NCM, ssh root@192.168.50.2, aa-proxy-rs not
+#    started); in the car aa-proxy-rs takes the UDC for Android Auto. `u2ac-aa dev on|off` forces it (persisted).
+#    The AP + ssh on 10.0.0.1 stay up in every mode.
+# bluetoothd lives in /usr/libexec/bluetooth (BlueZ layout), which busybox init's default PATH lacks
+export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/libexec/bluetooth
+. /lib/baseline/radio-lib.sh
+. /lib/baseline/mtd.sh
+P=/run/persist
+LOG=/run/log/u2ac-aa.log
+WI=/run/u2ac-watch   # radio_watch's state (and `: > $WI/off` stops it for this boot, for tests by hand)
+# cs: uptime in centiseconds (busybox date has 1 s resolution)
+cs() { read -r _u _ < /proc/uptime; _c=${_u#*.}; echo $(( ${_u%.*} * 100 + ${_c#0} )); }
+say() { _t=$(cut -d' ' -f1 /proc/uptime); echo "u2ac-aa: [$_t] $*"; echo "u2ac-aa: [$_t] $*" >> "$LOG"; }
+
+state_restore() {
+    # what the customer MTD holds (persist load just ran): the saver writes only when /run/persist differs.
+    # Taken before anything below adds to /run/persist (a new machine-id must reach flash too).
+    [ -s /run/persist.sig ] || sig "$P" > /run/persist.sig
+    mkdir -p /run/varlib/bluetooth /run/varlib/dbus /run/data/aa-proxy-rs /run/aa-etc /run/dbus /run/log
+    [ -d "$P/bluetooth" ] && cp -a "$P/bluetooth/." /run/varlib/bluetooth/
+    [ -d "$P/aa-data" ] && cp -a "$P/aa-data/." /run/data/aa-proxy-rs/
+    # /etc/aa-proxy-rs = /run/aa-etc: config.toml (web UI edits) + known_devices (the phones aa-proxy-rs
+    # dials after a reboot; without it every car start waits passively for the phone)
+    cp /usr/share/u2ac/aa-proxy-rs.config.toml /run/aa-etc/config.toml
+    [ -s "$P/aa-proxy-rs.config.toml" ] && cp "$P/aa-proxy-rs.config.toml" /run/aa-etc/config.toml
+    [ -d "$P/aa-etc" ] && cp -a "$P/aa-etc/." /run/aa-etc/
+    # aa-proxy-rs dials only the phones in known_devices, and records one only after a full BT handshake, a
+    # record the first car runs never got to flash (seen 2026-11-26: Pixel paired + persisted, known_devices
+    # empty = a manual connect at every car start). Every phone BlueZ holds a link key for goes in too.
+    for _i in /run/varlib/bluetooth/*/??:??:??:??:??:??/info; do
+        [ -f "$_i" ] && grep -q '^\[LinkKey\]' "$_i" || continue
+        _a=${_i%/info}; _a=${_a##*/}
+        grep -qix "$_a" /run/aa-etc/known_devices 2> /dev/null || echo "$_a" >> /run/aa-etc/known_devices
+    done
+    [ -s "$P/machine-id" ] || { mkdir -p "$P"; cat /proc/sys/kernel/random/uuid | tr -d - > "$P/machine-id"; }
+    cp "$P/machine-id" /run/varlib/dbus/machine-id
+    chmod 700 /run/varlib/bluetooth
+    # from now on the live dirs hold the archive's state: state_save may mirror them back (not before)
+    : > /run/u2ac-restored
+}
+
+# sig DIR: content signature (path list + file contents; NOT mtimes or modes, which change on every copy).
+# One md5sum for all files (-exec +), its lines sorted: same result whatever order find returns.
+sig() {
+    (cd "$1" 2>/dev/null || exit 0
+     find . | sort
+     find . -type f -exec md5sum {} + | sort) | md5sum | cut -d' ' -f1
+}
+
+# sync_dir SRC NAME: make $P/NAME a copy of SRC, touching $P/NAME only when the content differs.
+# A missing SRC changes nothing (an empty copy would replace the archived pairings/config).
+sync_dir() {
+    [ -d "$1" ] || return 0
+    _sd=/run/persist.next/$2
+    rm -rf "$_sd"; mkdir -p "$_sd"; cp -a "$1/." "$_sd/" 2>/dev/null
+    case $2 in
+        # BlueZ's per-device cache (SDP records etc.) is rebuilt on connect: not worth flash space/erases
+        bluetooth) rm -rf "$_sd"/*/cache ;;
+        # the shipped default config needs no flash (and keeping it would hide new defaults after an
+        # upgrade); sdr-ui-overrides.toml is aa-proxy-rs's auto-created MITM UI file (passthrough here)
+        aa-etc) cmp -s "$_sd/config.toml" /usr/share/u2ac/aa-proxy-rs.config.toml && rm -f "$_sd/config.toml"
+                rm -f "$_sd/sdr-ui-overrides.toml" ;;
+    esac
+    if [ "$(sig "$_sd")" != "$(sig "$P/$2")" ]; then rm -rf "$P/$2"; mv "$_sd" "$P/$2"; else rm -rf "$_sd"; fi
+}
+
+# state_save [force]: copy live state into /run/persist and write the archive only if /run/persist differs
+# from what was last written. One saver at a time (30 s loop, web UI, `u2ac-aa persist`); exit 1 = not saved.
+state_save() {
+    # never erase/write the NOR during a live AA session: every NOR erase stalls all rootfs reads
+    # (same chip) for ~0.4-2 s. 0x14A8 = port 5288, st 01 = ESTABLISHED. `force` (an explicit request) saves anyway.
+    if [ "${1:-}" != force ] && in_session; then
+        return 0
+    fi
+    (
+        exec 8> /run/u2ac-state.lock
+        flock 8
+        mkdir -p "$P" /run/persist.next
+        # before state_restore ran (e.g. the radios failed at boot and start() returned) the live dirs are
+        # not the archive's: save $P as loaded (flags like u2ac-dev included), never empty copies over it
+        if [ -e /run/u2ac-restored ]; then
+            sync_dir /run/varlib/bluetooth bluetooth
+            sync_dir /run/aa-etc aa-etc
+        fi
+        rm -rf /run/persist.next "$P/aa-data" "$P/aa-proxy-rs.config.toml"   # older layouts, never needed
+        _s=$(sig "$P")
+        [ "$_s" = "$(cat /run/persist.sig 2>/dev/null)" ] && exit 0
+        if persist save >> "$LOG" 2>&1; then
+            echo "$_s" > /run/persist.sig; say "state saved"
+        else
+            say "state save FAILED (persist save, see above)"; exit 1
+        fi
+    )
+}
+
+# mod_fast NAME [PARAMS]: load order from one awk pass, then insmod (radio-lib's mod_load forks ~600 times
+# for these five, ~1.5 s on the A7 at boot); radio-lib's mod_load if anything does not add up
+mod_fast() {
+    _m=$(echo "$1" | tr - _); shift
+    mod_loaded "$_m" && return 0
+    # NOT busybox modprobe: 1.38.0 insmods the module before its dependencies (radio-lib.sh; on the unit:
+    # "hci_uart: Unknown symbol" x34, then the slow fallback). One awk pass over /proc/modules + modules.dep
+    # (kmod lists a module's whole closure on its line) prints the still-missing modules in load order:
+    # "D path" for a dependency, "T path" for NAME (which gets the PARAMS). Anything odd: mod_load.
+    _ord=$(awk -v want="$_m" '
+        function nm(p) { sub(/:$/, "", p); sub(/.*\//, "", p); sub(/\.ko.*/, "", p); gsub(/-/, "_", p); return p }
+        FILENAME == ARGV[1] { have[$1] = 1; next }
+        { n = nm($1); k = $1; sub(/:$/, "", k); path[n] = k; dl[n] = ""
+          for (i = 2; i <= NF; i++) dl[n] = dl[n] " " nm($i) }
+        END {
+            if (!(want in path)) exit 1
+            c = split(want dl[want], T, " ")
+            for (pass = 0; pass < 64; pass++) {
+                left = 0; moved = 0
+                for (i = 1; i <= c; i++) {
+                    n = T[i]; if (n in have) continue
+                    if (!(n in path)) exit 1
+                    ok = 1; d = split(dl[n], D, " ")
+                    for (j = 1; j <= d; j++) if (!(D[j] in have)) { ok = 0; break }
+                    if (ok) { print (n == want ? "T " : "D ") path[n]; have[n] = 1; moved = 1 } else left = 1
+                }
+                if (!left) exit 0
+                if (!moved) exit 1
+            }
+            exit 1
+        }' "$MODLOAD_PROC" "$MODLOAD_DIR/modules.dep") && [ -n "$_ord" ] || { mod_load "$_m" "$@"; return; }
+    printf '%s\n' "$_ord" | while read -r _k _p; do
+        if [ "$_k" = T ]; then mod_insmod "$_p" "$@"; else mod_insmod "$_p"; fi || exit 1
+    done
+    mod_loaded "$_m" || mod_load "$_m" "$@"
+}
+
+radio_up() {
+    # brcmfmac + its vendor module (wcc) BEFORE the SDIO host (usdhc1): the host is not a modules.dep
+    # dependency of brcmfmac, and once it is up the chip enumerates and brcmfmac asks for wcc at once
+    # (rehearsal 2026-11-26: host first -> "brcmf_fwvid_request_module: mod=wcc: failed -2", no wlan0)
+    # feature_disable=0x10: no P2P (Wi-Fi Direct) interfaces; unused here
+    # hci_uart FIRST: the BT patch download runs in the kernel while Wi-Fi loads
+    # BT patch download at 3 Mbaud (kernel patch 0007), as the stock firmware does (brcm_patchram
+    # --use_baudrate_for_download): ~5 s -> ~1 s. If the chip ignores the early switch, hci_uart stays at
+    # 115200 (the vendor command fails, the host speed is not changed). Opt out: /run/persist/u2ac-bt-slowbaud
+    EB=bcm_force_early_baud=1; [ -e "$P/u2ac-bt-slowbaud" ] && EB=
+    # /run/persist/u2ac-bt-0092: use the newer Nexus 6P BT patch (BCM4358A3 Huawei N 0092, same config line
+    # as the stock 0082 but no AMPAK "LE HW config offset" record) instead of the stock one
+    if [ -e "$P/u2ac-bt-0092" ]; then
+        mkdir -p /run/fw/brcm && cp /lib/firmware/brcm/BCM4358A3-0092-nexus6p.hcd /run/fw/brcm/BCM4358A3.hcd \
+            && echo /run/fw > /sys/module/firmware_class/parameters/path
+    fi
+    # rfcomm explicitly: the AA Wireless bootstrap is an RFCOMM profile (bluetoothd opens its socket when
+    # aa-proxy-rs registers it); the kernel's bt-proto-3 autoload would work too, but not on a deadline
+    mod_fast hci_uart $EB && mod_fast rfcomm && mod_fast brcmfmac feature_disable=0x10 && mod_fast brcmfmac_wcc \
+        && mod_fast sdhci_esdhc_imx || return 1
+    n=0; while [ ! -e /sys/class/net/wlan0 ] && [ $n -lt 200 ]; do sleep 0.05; n=$((n + 1)); done
+    n=0; while [ ! -e /sys/class/bluetooth/hci0 ] && [ $n -lt 200 ]; do sleep 0.05; n=$((n + 1)); done
+    iw reg set GR 2>/dev/null
+    [ -e /sys/class/net/wlan0 ] && [ -e /sys/class/bluetooth/hci0 ]
+}
+
+# ap_radio: hostapd on wlan0, the AP address and DHCP (ap_up at boot, radio_watch after a crash).
+# 0 = the AP is enabled, 1 = hostapd runs but did not report ENABLED within 15 s, 2 = hostapd did not start
+ap_radio() {
+    ip link set wlan0 down 2>/dev/null
+    # 40 MHz by default: AA video needs well under 50 Mbit/s and a 2x2 HT40/VHT40 AP gives ~300; 80 MHz costs
+    # ~40 mA more just listening (CYW4354 figures, audit/ROUND2_POWER.md). Opt in: /run/persist/u2ac-wifi-80
+    # (used only when the firmware's locale offers VHT80 on ch36, DT brcm,ccode-map GR/4)
+    HC=/usr/share/u2ac/hostapd.conf
+    [ -e "$P/u2ac-wifi-80" ] && iw phy "$(cat /sys/class/net/wlan0/phy80211/name)" channels 2>/dev/null \
+        | grep -A3 '5180 MHz' | grep -q VHT80 && HC=/usr/share/u2ac/hostapd-80.conf
+    # Wi-Fi name/password set from the web UI (/run/persist/u2ac-wifi.conf, SSID= / PSK= lines, validated by
+    # the UI): read literally, never sourced; aa-proxy-rs's config.toml carries the same values for the phone
+    W=$P/u2ac-wifi.conf
+    if [ -s "$W" ]; then
+        S=$(sed -n 's/^SSID=//p' "$W" | head -n 1); K=$(sed -n 's/^PSK=//p' "$W" | head -n 1)
+        if [ -n "$S" ] && [ ${#S} -le 32 ] && [ ${#K} -ge 8 ] && [ ${#K} -le 63 ]; then
+            grep -v -e '^ssid=' -e '^wpa_passphrase=' "$HC" > /run/hostapd.conf
+            printf 'ssid=%s\nwpa_passphrase=%s\n' "$S" "$K" >> /run/hostapd.conf
+            HC=/run/hostapd.conf
+        fi
+    fi
+    say "AP config ${HC##*/}"
+    : > /run/log/hostapd.log
+    # -t: timestamps (seconds since power-on, no clock) in the log: when the phone associates and finishes
+    # its key handshake, for the start-up timeline
+    hostapd -B -t -P /run/hostapd.pid -f /run/log/hostapd.log "$HC" || return 2
+    # ready = the control interface reports state=ENABLED (the -f log needs CONFIG_DEBUG_FILE, so it is
+    # only for reading, never the readiness test); max 15 s. The IP, DHCP, web UI and ssh below come up
+    # either way, so a slow 20/40 scan never leaves the AP without an address.
+    rc=1; n=0
+    while [ $n -lt 60 ]; do
+        hostapd_cli -p /run/hostapd -i wlan0 status 2>/dev/null | grep -q '^state=ENABLED' && { rc=0; break; }
+        sleep 0.25; n=$((n + 1))
+    done
+    echo -500 > /proc/$(cat /run/hostapd.pid 2>/dev/null)/oom_score_adj 2>/dev/null
+    # heat/battery: 14 dBm is plenty inside a car (nvram max 16.5 dBm on 5 GHz)
+    # a LIMIT, not "fixed" (fixed sets an override that bypasses the firmware's per-rate limits)
+    iw dev wlan0 set txpower limit 1400 2>/dev/null
+    ip addr add 10.0.0.1/24 dev wlan0 2>/dev/null
+    ip link set wlan0 up
+    udhcpd /usr/share/u2ac/udhcpd-wlan.conf
+    # the interface this AP runs on: brcmfmac re-creates wlan0 (a new index) when it resets a crashed chip
+    mkdir -p "$WI"; cat /sys/class/net/wlan0/ifindex > "$WI/wlan0.ix" 2> /dev/null
+    return $rc
+}
+
+ap_up() {
+    ap_radio; rc=$?
+    [ $rc = 2 ] && return 1
+    # web UI (busybox httpd + CGI) on the AP, and on the USB link when a computer brought NCM up
+    httpd -p 10.0.0.1:80 -h /usr/share/u2ac/www && echo "$(pgrep -n -x httpd)" > /run/httpd-wlan.pid
+    usb_httpd
+    # ssh over the AP too (same keys/host key as the NCM dropbear)
+    # KEY-ONLY on the AP (-s: no password logins): the AP password is the well-known vendor default and the
+    # root password the documented dev default, so a password login here would be root for anyone in range.
+    # The USB link (physical access) keeps key OR password (ssh-up on 192.168.50.2).
+    # host key: the persisted one, else ssh-up's ephemeral one, else one made here in RAM (first boot,
+    # before ssh-up made it; `-R` cannot work: dropbear has to save that key under the read-only /etc)
+    K=
+    for k in "$P/dropbear_ed25519_host_key" /run/dropbear/ephemeral_ed25519_host_key; do
+        [ -s "$k" ] && { K=$k; break; }
+    done
+    if [ -z "$K" ]; then
+        mkdir -p /run/dropbear; K=/run/dropbear/ap_ed25519_host_key
+        [ -s "$K" ] || dropbearkey -t ed25519 -f "$K" > /dev/null 2>&1
+    fi
+    dropbear -E -s -r "$K" -p 10.0.0.1:22 -P /run/dropbear-wlan.pid 2>> /run/log/dropbear.log
+    return $rc
+}
+
+# home_window: the home upload (u2ac-home) while wlan0 is still free, before ap_up takes it. Only when it is set up
+# and prep found slots to send; at most U2AC_HOME_S (4) s, enforced here too. The phone gets the hotspot's
+# details over Bluetooth ~6 s after the radios are up (car runs 2026-11-28), so the box ends before it needs it.
+home_window() {
+    [ -s "$P/u2ac-home.conf" ] || return 0
+    n=0; until [ -e /run/u2ac-home/ready ] || [ $n -ge 20 ]; do sleep 0.05; n=$((n + 1)); done
+    ls /run/u2ac-home/q/*.prom > /dev/null 2>&1 || return 0
+    HS=${U2AC_HOME_S:-4}
+    u2ac-home push "$HS" > /dev/null 2>&1 &
+    hp=$!; n=0
+    # its own box ends the network part at HS s; 2 s more for leaving the network (wpa_supplicant's exit)
+    while kill -0 $hp 2> /dev/null && [ $n -lt $((HS * 20 + 40)) ]; do sleep 0.05; n=$((n + 1)); done
+    if kill -0 $hp 2> /dev/null; then
+        kill $hp 2> /dev/null; wait $hp 2> /dev/null; u2ac-home cleanup
+        say "home upload: stopped at its ${HS} s limit"
+    fi
+    return 0
+}
+
+# (the "BT: ..." stamps time the steps of the start-up's slowest part in the flight log)
+bt_up() { bt_addr; say "BT: address set"; bt_daemons; }
+
+bt_addr() {
+    # stable public BD address, derived like the vendor did (38:BA:B0 + the Wi-Fi MAC's last 3 bytes)
+    # (the sysfs hci0 node appears before the controller finishes its patch/setup: wait for mgmt to answer,
+    # else public-addr fails silently and the chip default 43:58:A3:... stays)
+    # btmgmt (BlueZ 5.87) reads a non-tty stdin as a command script: from /dev/null it quits before the reply
+    # (no output), and at boot one call hung for good (seen on the unit). An open, empty FIFO as stdin makes it
+    # answer and exit deterministically (~10 ms); the timeout bounds any hang. fd 9 is closed before bluetoothd.
+    rm -f /run/btmgmt.in; mkfifo /run/btmgmt.in && exec 9<> /run/btmgmt.in
+    mg() { timeout 3 btmgmt -i hci0 "$@" <&9 2>/dev/null; }
+    n=0; until mg info | grep -q 'current settings'; do
+        [ $n -ge 40 ] && break; sleep 0.25; n=$((n + 1)); done
+    # bt_addr settle (radio_watch, after a re-bind): the controller answers ~1 s after the bind, then the kernel
+    # powers it off on its own 2 s later (auto-off); an address set in between left no controller in mgmt
+    # (seen twice on the unit). At boot the Wi-Fi load comes first and covers that window.
+    [ "${1:-}" = settle ] && sleep 3
+    m=$(cat /sys/class/net/wlan0/address 2>/dev/null)
+    [ -n "$m" ] && mg power off > /dev/null && mg public-addr "38:BA:B0:${m#??:??:??:}" > /dev/null
+    exec 9<&-; rm -f /run/btmgmt.in
+}
+
+bt_daemons() {
+    # a restart (stop, then start without a reboot): dbus-daemon refuses to start over its stale pid file
+    pgrep -x dbus-daemon > /dev/null || { rm -f /run/dbus-daemon.pid; dbus-daemon --system --fork; } || return 1
+    # start's early D-Bus may still be setting up its socket: bluetoothd quits without the bus (max 5 s)
+    n=0; while [ ! -S /run/dbus/system_bus_socket ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
+    for d in dbus-daemon; do echo -500 > /proc/$(pgrep -n -x $d)/oom_score_adj 2>/dev/null; done
+    : > /run/log/bluetoothd.log
+    # from a subshell that exits at once: init reaps it if it dies (a child of the long-running saver loop,
+    # radio_watch's restart, would stay a zombie and look alive to kill -0)
+    ( /usr/libexec/bluetooth/bluetoothd -n >> /run/log/bluetoothd.log 2>&1 & echo $! > /run/bluetoothd.pid )
+    echo -500 > /proc/$(cat /run/bluetoothd.pid)/oom_score_adj 2>/dev/null
+    # ready when bluetoothd has taken the adapter ("Bluetooth management interface 1.x initialized"),
+    # max 5 s; its failure line "Failed to access management interface" must not count as ready
+    n=0; until grep -q 'management interface .* initialized' /run/log/bluetoothd.log 2>/dev/null; do
+        grep -q 'Failed to access management' /run/log/bluetoothd.log 2>/dev/null && return 1
+        [ $n -ge 20 ] && break; sleep 0.25; n=$((n + 1)); done
+    pgrep -x bluetoothd > /dev/null
+}
+
+# The boot's USB probe ran first (board-rcS.sh board_usb_probe, u2ac-usbprobe): the port showed an Android
+# phone, and a car asks it AOA GET_PROTOCOL at once (car), or nobody configured it (none, after ~10 s): no
+# computer, and the car never saw NCM. Otherwise (noaoa: a host that stayed silent, dev, failed, no probe):
+# a computer activates the NCM data interface (carrier) and answers ARP/ping at the host address it got
+# by DHCP; a car head unit has no NCM driver, so carrier stays 0 there. Runs in parallel with the radios.
+# Its stdout is the verdict file: log with say ... > /dev/null.
+computer_on_usb() {
+    t=$(cs)
+    if command -v u2ac-usbprobe > /dev/null 2>&1; then
+        until [ -s /run/u2ac-usbprobe ]; do [ $(($(cs) - t)) -ge 2000 ] && break; sleep 0.1; done
+    fi
+    _pv=$(cat /run/u2ac-usbprobe 2> /dev/null)
+    say "usb probe: ${_pv:-no verdict} ($(tr '\n' ' ' < /run/log/u2ac-usbprobe.log 2> /dev/null))" > /dev/null
+    case $_pv in car | none) return 1 ;; esac
+    # wait for rcS's NCM bring-up (usb0 with its address, max 10 s)
+    t=$(cs)
+    until ip -4 addr show usb0 2>/dev/null | grep -q 192.168.50.2; do
+        [ $(($(cs) - t)) -ge 1000 ] && return 1; sleep 0.05; done
+    # A computer configures the gadget and activates the NCM data interface (carrier) about a second after it
+    # sees it; a head unit has no NCM driver. Decide from the UDC state (usbotg2 = 2184200.usb):
+    #   configured, but no carrier 3 s later -> a car;  never configured within 2.5 s -> nobody / a car
+    U=; for u in /sys/class/udc/*; do case $(readlink -f "$u") in */2184200.usb/*) U=$u ;; esac; done
+    t=$(cs); tc=
+    until [ "$(cat /sys/class/net/usb0/carrier 2>/dev/null)" = 1 ]; do
+        now=$(cs)
+        [ -z "$tc" ] && [ "$(cat "$U/state" 2>/dev/null)" = configured ] && tc=$now
+        if [ -n "$tc" ]; then [ $((now - tc)) -ge 300 ] && return 1
+        else [ $((now - t)) -ge 250 ] && return 1; fi
+        sleep 0.05
+    done
+    # ARP first: a host firewall (Windows by default, macOS stealth mode) drops ping but always answers ARP
+    for _i in 1 2 3; do
+        arping -q -f -c 1 -w 1 -I usb0 192.168.50.100 > /dev/null 2>&1 && return 0
+        ping -c 1 -W 1 192.168.50.100 > /dev/null 2>&1 && return 0
+    done
+    return 1
+}
+
+# usb_httpd: the web UI on the USB link, once NCM has its address. Called from ap_up and again when a
+# computer was found (ap_up's moment can be too early: the USB probe delays NCM, a late host gets it after
+# the AP is up, and a failed hostapd returns before ap_up gets here). One instance.
+usb_httpd() {
+    [ -s /run/httpd-usb.pid ] && kill -0 "$(cat /run/httpd-usb.pid)" 2> /dev/null && return 0
+    ip -4 addr show usb0 2>/dev/null | grep -q 192.168.50.2 || return 1
+    httpd -p 192.168.50.2:80 -h /usr/share/u2ac/www && echo "$(pgrep -n -x httpd)" > /run/httpd-usb.pid
+}
+
+# zbin_unpack: board.env ZSTD_PACK executables (/usr/lib/zbin/NAME.zst, linked from their path to /run/zbin/NAME)
+# into RAM, once a boot; /run/zbin/.done when finished (aa_run waits for it)
+zbin_unpack() {
+    mkdir -p /run/zbin
+    for _z in /usr/lib/zbin/*.zst; do
+        [ -e "$_z" ] || continue
+        _n=${_z##*/}; _n=${_n%.zst}
+        [ -x "/run/zbin/$_n" ] && continue
+        if u2ac-unzstd < "$_z" > "/run/zbin/$_n.tmp" && chmod 0755 "/run/zbin/$_n.tmp"; then
+            mv -f "/run/zbin/$_n.tmp" "/run/zbin/$_n"
+        else rm -f "/run/zbin/$_n.tmp"; say "zbin: unpacking $_n FAILED"; fi
+    done
+    : > /run/zbin/.done
+}
+
+# aa-proxy-rs supervised: restarted if it dies, protected from the OOM killer, slight CPU priority
+aa_run() {
+    (
+        echo -900 > /proc/self/oom_score_adj
+        read -r me _ < /proc/self/stat; renice -n -10 -p "$me" > /dev/null 2>&1
+        # FunctionFS transfer size (our aa-proxy-rs patch). Field fallback without a rebuild: a head unit that
+        # resets on transfer errors (VAG, aa-proxy-rs #131/#144) -> `echo 512 > /run/persist/u2ac-ffs-chunk`
+        _c=; [ -s "$P/u2ac-ffs-chunk" ] && read -r _c < "$P/u2ac-ffs-chunk"
+        case $_c in 512 | 1024 | 2048 | 4096 | 8192 | 16384) AA_FFS_CHUNK=$_c ;; esac
+        export AA_FFS_CHUNK=${AA_FFS_CHUNK:-16384}
+        # hands-free guard (aa-build patch 0004): after the Bluetooth bootstrap the dongle stays connected as a
+        # silent second hands-free unit (never active, no calls), so Android turns in-band ringing off for the
+        # car (SYNC 3 on its own ringtone drops the microphone of incoming calls otherwise). Off:
+        # `: > /run/persist/u2ac-hfp-guard-off; persist save`
+        [ -e "$P/u2ac-hfp-guard-off" ] || export AA_HFP_GUARD=1
+        cd /run/data
+        # its binary unpacked into RAM by start's zbin_unpack (max 10 s)
+        if [ -d /usr/lib/zbin ]; then
+            _n=0; until [ -e /run/zbin/.done ] || [ $_n -ge 100 ]; do sleep 0.1; _n=$((_n + 1)); done
+        fi
+        # restart at once after a crash in a long run (2 s), back off up to 30 s when it keeps dying young (a
+        # bad config would otherwise start the 15 MB binary every 2 s on the single core all drive)
+        _d=2
+        while :; do
+            _t0=$(cs)
+            # its info lines already go to /var/log/aa-proxy-rs.log (config logfile); the terminal logger
+            # writes info to stdout and warn/error (+ panics) to stderr: keep only stderr here, not a 2nd copy
+            aa-proxy-rs > /dev/null 2>> /run/log/aa-proxy-rs.console
+            _rc=$?
+            [ $(($(cs) - _t0)) -ge 6000 ] && _d=2
+            say "aa-proxy-rs exited ($_rc), restarting in $_d s"
+            sleep $_d
+            _d=$((_d * 2)); [ $_d -gt 30 ] && _d=30
+        done
+    ) &
+    echo $! > /run/aa-proxy-rs.pid
+}
+
+# The radios' daemons kept alive: radio_watch runs on every tick of the saver loop (5 s) and repairs
+#  - hostapd gone, or wlan0 re-created (brcmfmac resets a crashed chip itself: "Firmware has halted or
+#    crashed", then wlan0 goes and comes back with a new index, and the old hostapd is left on nothing)
+#    -> the AP again (hostapd, address, DHCP; the web UI and ssh listeners on 10.0.0.1 carry on)
+#  - wlan0 missing for 60 s (the kernel's own reset did not bring the chip back) -> the SDIO host re-bound
+#  - dbus-daemon or bluetoothd gone -> started again; aa-proxy-rs registered its Bluetooth profiles with the
+#    old ones, so it is restarted too, but only outside an AA session (its supervisor starts it at once)
+#  - hci0 missing for 30 s -> the Bluetooth serdev re-bound (the chip's own shutdown GPIO resets it)
+# Each repair at most 8 times a boot and 30 s apart. A device still down = amber, until it is back.
+# No forks while all is well (builtins only): it runs every 5 s for the whole drive.
+pid_ok() { { read -r _p < "$1"; } 2> /dev/null && [ -n "$_p" ] && kill -0 "$_p" 2> /dev/null; }
+# watch_try NAME: may NAME be repaired now? (counts it)
+watch_try() {
+    _n=0; _l=; { read -r _n < "$WI/$1.n"; read -r _l < "$WI/$1.t"; } 2> /dev/null
+    _now=$(cs)
+    if [ "${_n:-0}" -ge 8 ]; then
+        [ -e "$WI/$1.gaveup" ] || { : > "$WI/$1.gaveup"; say "watch: $1 repaired 8 times, giving up until the next boot"; }
+        return 1
+    fi
+    [ -n "$_l" ] && [ $((_now - _l)) -lt "${U2AC_WATCH_GAP:-3000}" ] && return 1
+    echo $((${_n:-0} + 1)) > "$WI/$1.n"; echo "$_now" > "$WI/$1.t"
+}
+# gone_for NAME CS: NAME has been missing for CS centiseconds (the first call starts its clock)
+gone_for() {
+    [ -s "$WI/$1.gone" ] || { cs > "$WI/$1.gone"; return 1; }
+    read -r _g < "$WI/$1.gone"; [ $(($(cs) - _g)) -ge "$2" ]
+}
+# watch_init: where to re-bind the chips if they drop off (the drivers' sysfs nodes, read once at boot)
+watch_init() {
+    mkdir -p "$WI"
+    _h=$(readlink -f /sys/class/net/wlan0/device 2> /dev/null | sed -n 's#^\(.*/[0-9a-f]*\.mmc\)/.*#\1#p')
+    [ -n "$_h" ] && [ -e "$_h/driver" ] && echo "$(readlink -f "$_h/driver") ${_h##*/}" > "$WI/wlan.host"
+    _b=$(readlink -f /sys/class/bluetooth/hci0/device 2> /dev/null)
+    [ -n "$_b" ] && [ -e "$_b/driver" ] && echo "$(readlink -f "$_b/driver") ${_b##*/}" > "$WI/bt.dev"
+}
+rebind() { # FILE (driver path + device name): unbind, then bind again
+    read -r _drv _dev < "$1" 2> /dev/null || return 1
+    echo "$_dev" > "$_drv/unbind" 2> /dev/null; sleep 1; echo "$_dev" > "$_drv/bind" 2> /dev/null
+}
+ap_again() {
+    for _f in /run/hostapd.pid /run/udhcpd-wlan.pid; do
+        pid_ok "$_f" && kill "$_p" 2> /dev/null; rm -f "$_f"
+    done
+    # hostapd's exit takes the AP down (max 3 s)
+    _n=0; while pgrep -x hostapd > /dev/null && [ $_n -lt 30 ]; do sleep 0.1; _n=$((_n + 1)); done
+    ap_radio
+}
+radio_watch() {
+    _bad=0
+    if [ ! -e /sys/class/net/wlan0 ]; then
+        _bad=1
+        if gone_for wlan0 6000 && watch_try wifi-rebind; then
+            say "watch: wlan0 gone for 60 s, re-binding the Wi-Fi chip's SDIO host"
+            pid_ok /run/hostapd.pid && kill "$_p" 2> /dev/null
+            rebind "$WI/wlan.host" || say "watch: no SDIO host to re-bind"
+            rm -f "$WI/wlan0.gone"
+        fi
+    else
+        rm -f "$WI/wlan0.gone"
+        _ix=; _ox=; { read -r _ix < /sys/class/net/wlan0/ifindex; read -r _ox < "$WI/wlan0.ix"; } 2> /dev/null
+        if ! pid_ok /run/hostapd.pid || [ "$_ix" != "$_ox" ]; then
+            _bad=1
+            if watch_try hostapd; then
+                if [ "$_ix" != "$_ox" ]; then say "watch: wlan0 re-created (index $_ox -> $_ix), AP again"
+                else say "watch: hostapd gone, AP again"; fi
+                ap_again; _r=$?
+                case $_r in 0) say "watch: AP up again"; _bad=0 ;; 1) say "watch: AP started, not enabled yet" ;;
+                    *) say "watch: hostapd did not start (/run/log/hostapd.log)" ;; esac
+            fi
+        fi
+    fi
+    if [ ! -e /sys/class/bluetooth/hci0 ]; then
+        _bad=1
+        if gone_for hci0 3000 && watch_try bt-rebind; then
+            say "watch: hci0 gone for 30 s, re-binding the Bluetooth chip"
+            pid_ok /run/bluetoothd.pid && kill "$_p" 2> /dev/null
+            if rebind "$WI/bt.dev"; then
+                _n=0; while [ ! -e /sys/class/bluetooth/hci0 ] && [ $_n -lt 100 ]; do sleep 0.1; _n=$((_n + 1)); done
+                [ -e /sys/class/bluetooth/hci0 ] && bt_addr settle
+            else say "watch: no Bluetooth device to re-bind"; fi
+            rm -f "$WI/hci0.gone"
+        fi
+    else
+        rm -f "$WI/hci0.gone"
+        if ! pid_ok /run/dbus-daemon.pid || ! pid_ok /run/bluetoothd.pid; then
+            _bad=1
+            if watch_try bluetoothd; then
+                say "watch: D-Bus/bluetoothd gone, starting them again"
+                pid_ok /run/bluetoothd.pid && kill "$_p" 2> /dev/null
+                mv -f /run/log/bluetoothd.log /run/log/bluetoothd.log.old 2> /dev/null
+                if bt_daemons; then say "watch: bluetoothd up again"; _bad=0; : > "$WI/aa-restart"
+                else say "watch: bluetoothd did not start (/run/log/bluetoothd.log)"; fi
+            fi
+        fi
+    fi
+    if [ -e "$WI/aa-restart" ] && ! in_session; then
+        rm -f "$WI/aa-restart"
+        pgrep -x aa-proxy-rs > /dev/null && { say "watch: restarting aa-proxy-rs for the new bluetoothd"; killall aa-proxy-rs; }
+    fi
+    return $_bad
+}
+
+# Car off, USB still powered (Ford SYNC 3 keeps the port powered up to ~10 min, other cars for good): once a
+# drive has ended and the car has not used the USB port for SLEEP_S, the dongle sleeps. aa-proxy-rs stops (it
+# would keep calling the phone over Bluetooth and pull it onto the hotspot while you walk away or sit in the
+# parked car), the hotspot and the Bluetooth radio go off, the light goes dark. The port shows the boot's
+# MTP-stage identity again (board-rcS.sh usbprobe_up, u2ac-usbprobe); the first host that configures it wakes
+# the dongle with a reboot: a car (it asks AOA at once) or a computer (maintenance mode then, as at boot).
+# A wrong guess (a car that is on but has not used the port for SLEEP_S: the phone stayed away that long)
+# costs a reboot: the car configures the probe at once. Off: `: > /run/persist/u2ac-sleep-off` (web Options).
+SLEEP_S=${U2AC_SLEEP_S:-90}
+bt_power() { # on|off, the controller only (bluetoothd stays)
+    rm -f /run/btpower.in; mkfifo /run/btpower.in && exec 8<> /run/btpower.in || return 1
+    timeout 3 btmgmt -i hci0 power "$1" <&8 > /dev/null 2>&1; _r=$?
+    exec 8<&-; rm -f /run/btpower.in; return $_r
+}
+car_sleep() { # WHY
+    say "sleep: $1: radios off until a host uses the USB port again"
+    : > "$WI/off"   # radio_watch must not bring the radios back
+    : > /run/u2ac-sleeping
+    [ -e "$P/u2ac-flightlog-off" ] || fl_write sleep
+    pid_ok /run/aa-proxy-rs.pid && kill "$_p" 2> /dev/null   # the supervisor first, then the relay
+    rm -f /run/aa-proxy-rs.pid; killall aa-proxy-rs 2> /dev/null
+    for _g in /sys/kernel/config/usb_gadget/*/UDC; do
+        [ -n "$(cat "$_g" 2> /dev/null)" ] && echo "" > "$_g" 2> /dev/null
+    done
+    for _f in /run/hostapd.pid /run/udhcpd-wlan.pid; do pid_ok "$_f" && kill "$_p" 2> /dev/null; rm -f "$_f"; done
+    ip link set wlan0 down 2> /dev/null
+    bt_power off || say "sleep: Bluetooth power-off failed"
+    led 000000
+    cpu_mode normal
+    # the wake: the probe gadget on the port, hour by hour, until a host configures it
+    (
+        trap '' HUP   # `u2ac-aa sleep-now` over ssh: the wake must outlive the session
+        . /etc/baseline/board.env 2> /dev/null; . /etc/baseline/board-rcS.sh
+        while :; do
+            if usbprobe_up 3600000 3000; then usbprobe_end
+            else usbprobe_down; echo failed > /run/u2ac-usbprobe; sleep 30; fi
+            _v=$(cat /run/u2ac-usbprobe 2> /dev/null)
+            case $_v in
+                car | noaoa)
+                    say "sleep: a host configured the USB port ($_v): waking up (reboot)"
+                    state_save; sync; reboot; exit 0 ;;
+            esac
+        done
+    ) > /dev/null 2>&1 &
+    echo $! > /run/u2ac-wake.pid
+}
+
+# cpu_mode session|normal. An AA session: full speed, and no LOW-POWER-IDLE (cpuidle state2 flushes L1+L2 on
+# every entry and takes 300 us to wake, on every IRQ-driven wakeup of the relay; ondemand would also settle at
+# 198-396 MHz at relay loads, audit/ROUND2_PERFORMANCE.md). Otherwise ondemand with every idle state.
+cpu_mode() {
+    if [ "$1" = session ]; then _g=performance _d=1; else _g=ondemand _d=0; fi
+    for _x in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo $_g > "$_x"; done 2> /dev/null
+    for _x in /sys/devices/system/cpu/cpu*/cpuidle/state2/disable; do echo $_d > "$_x"; done 2> /dev/null
+    if [ $_g = ondemand ]; then
+        _o=/sys/devices/system/cpu/cpufreq/ondemand
+        [ -d $_o ] && { echo 50 > $_o/up_threshold; echo 10 > $_o/sampling_down_factor; } 2> /dev/null
+    fi
+    say "cpu: $1 ($_g)"
+}
+
+# in_session: a phone holds the AA TCP session (port 5288 = 0x14A8, state 01 ESTABLISHED)
+in_session() { grep -qiE '^ *[0-9]+: [0-9A-F]+:14A8 [0-9A-F:]+ 01 ' /proc/net/tcp /proc/net/tcp6 2> /dev/null; }
+# car_live: the car took the accessory (aa-proxy-rs's 18d1:2d00 gadget configured) while the phone is in
+# session: Android Auto is on the car's screen. in_session alone = the phone came, the car has not switched yet.
+car_live() {
+    in_session && grep -qx 0x2d00 /sys/kernel/config/usb_gadget/*/idProduct 2> /dev/null \
+        && grep -qx configured /sys/class/udc/*/state 2> /dev/null
+}
+# bt_key: changes when a phone is paired/removed or aa-proxy-rs records a known phone (rare, and lost with the
+# ignition if not saved at once: the first pairing happens right before the session that would block the save)
+bt_key() {
+    { ls -d /run/varlib/bluetooth/*/??:??:??:??:??:?? 2> /dev/null; cat /run/aa-etc/known_devices 2> /dev/null; } | md5sum
+}
+
+# status light: the WS2812B on GPIO1_IO03 (module u2ac-ws2812, /sys/class/leds/rgb:status) in the stock
+# firmware's colours (2024.10.31 /etc/rgbLight.conf): StartUp 7e172b, BtConnecting 005f7f 500/100,
+# BtConnected 00007f 300/100 (here: the phone is in, the car has not switched to Android Auto yet),
+# HULinkSuccess 003b00 (stock blinks it 1000/1000; steady here since 2026-11-27: Android Auto is on the car's
+# screen, a blink read as "still connecting" in the car), Fault 69480f 1000/500; maintenance (not stock) dim white.
+# led RRGGBB [ON_MS OFF_MS]: steady, or blinking by the kernel's timer trigger (no wakeups of ours).
+# /run/persist/u2ac-led-off: dark (the LED draws ~5-20 mA lit).
+LEDD=/sys/class/leds/rgb:status
+led() {
+    [ -d "$LEDD" ] || return 0
+    [ -e "$P/u2ac-led-off" ] && set -- 000000
+    echo none > "$LEDD/trigger"; echo "$1" > "$LEDD/color"; echo 255 > "$LEDD/brightness"
+    [ -n "${2:-}" ] || return 0
+    echo timer > "$LEDD/trigger" && echo "$2" > "$LEDD/delay_on" && echo "$3" > "$LEDD/delay_off"
+} 2> /dev/null
+# led_state: the colour for "no session" (AA waiting for the phone, or maintenance)
+led_state() { if pgrep -x aa-proxy-rs > /dev/null; then led 005f7f 500 100; else led 404040; fi; }
+
+# cap_logs: the RAM logs (tmpfs /run) stay under 1 MiB each, the newest 256 KiB kept. Every writer appends
+# (O_APPEND), so after the in-place rewrite it goes on writing at the new end. aa-proxy-rs alone logs ~4 MB/day
+# while it pages an absent phone (audit/ROUND2_POWER.md).
+cap_logs() {
+    for _f in /run/log/*.log /run/log/*.console; do
+        [ -f "$_f" ] || continue
+        [ "$(wc -c < "$_f")" -gt 1048576 ] || continue
+        tail -c 262144 "$_f" > "$_f.cap" && cat "$_f.cap" > "$_f"
+        rm -f "$_f.cap"
+    done
+}
+
+# flight recorder: the car-mode logs, kept across the power cut that ends every drive (/run is RAM).
+# Area: the last 1 MiB of the 'rootfs' MTD. The squashfs reads only up to its bytes_used (~10 MB of 12.4) and
+# the U2AC has no OCBM overlay region there (board.env), the same disjointness ocbm-overlay relies on, checked
+# before every write. 8 slots of 128 KiB, the oldest reused; a slot = a 512-byte header line
+# "U2AC-FLIGHTLOG 1 seq=N up=S why=W bytes=N" (NUL padded) + a gzip of the logs. Car mode only, at most 40 per
+# boot. Read it from maintenance mode: `u2ac-aa flightlog` (list), `u2ac-aa flightlog last|SEQ` (print).
+# /run/persist/u2ac-flightlog-off: never written. FL_ERASE (DEVICE OFFSET BLOCKS) replaces flash_erase in the
+# emulated selftest (MTD_SYS/MTD_DEV point mtd.sh at plain files there).
+# the area size is board.env's FLIGHTLOG_SIZE, which build.sh keeps the squashfs out of
+FL_AREA=$(sed -n 's/^FLIGHTLOG_SIZE=\([0-9][0-9]*\).*/\1/p' /etc/baseline/board.env 2> /dev/null)
+FL_AREA=${FL_AREA:-1048576} FL_SLOT=131072 FL_HDR=512
+FL_ERASE=${FL_ERASE:-flash_erase -q}
+fl_dev() {
+    _n=$(mtd_num rootfs) || return 1
+    _psz=$(mtd_attr "$_n" size); _es=$(mtd_attr "$_n" erasesize)
+    FL_D=$MTD_DEV/mtd$_n; FL_OFF=$((${_psz:-0} - FL_AREA))
+    [ "$_es" = 65536 ] && [ "$FL_OFF" -gt 0 ] || return 1
+    # squashfs superblock: magic "hsqs" at 0, bytes_used (le64) at 40: it must end before the area
+    [ "$(hexdump -v -n 4 -e '4/1 "%02x"' "$FL_D" 2> /dev/null)" = 68737173 ] || return 1
+    _u=$(hexdump -v -s 40 -n 4 -e '1/4 "%u"' "$FL_D" 2> /dev/null)
+    _hi=$(hexdump -v -s 44 -n 4 -e '1/4 "%u"' "$FL_D" 2> /dev/null)
+    [ "$_hi" = 0 ] && [ -n "$_u" ] && [ $(((_u + 65535) / 65536 * 65536)) -le "$FL_OFF" ]
+}
+# fl_hdr I: slot I's header line ("" when erased or foreign)
+fl_hdr() {
+    dd if="$FL_D" bs=512 skip=$(((FL_OFF + $1 * FL_SLOT) / 512)) count=1 2> /dev/null | tr -d '\000\377' \
+        | head -n 1 | grep '^U2AC-FLIGHTLOG 1 seq=[0-9]* '
+}
+fl_field() { echo "$1" | sed -n "s/.* $2=\([^ ]*\).*/\1/p"; }
+fl_lastseq() {
+    _m=0; _i=0
+    while [ $_i -lt 8 ]; do
+        _s=$(fl_field "$(fl_hdr $_i)" seq); [ -n "$_s" ] && [ "$_s" -gt $_m ] && _m=$_s; _i=$((_i + 1))
+    done
+    echo $_m
+}
+fl_bundle() { # BYTES_OF_AA_LOG: the text that goes into a slot (gzip'd by the caller)
+    echo "=== u2ac flight log: up $(cut -d' ' -f1 /proc/uptime) s, $(cat /proc/version)"
+    echo "=== status"; "$0" status 2>&1
+    # the health numbers (Prometheus text) of this moment: what the home upload reads from the slots later
+    echo "=== metrics"; u2ac-metrics 2>&1
+    echo "=== usb:$(cat /sys/class/udc/*/state 2> /dev/null) gadget $(cat /sys/kernel/config/usb_gadget/*/idProduct 2> /dev/null | tr '\n' ' ')"
+    echo "=== tcp"; cat /proc/net/tcp 2> /dev/null
+    echo "=== stations"; iw dev wlan0 station dump 2> /dev/null | grep -E 'Station|signal:|connected time|rx bitrate'
+    echo "=== u2ac-aa.log"; tail -c 65536 "$LOG" 2> /dev/null
+    echo "=== aa-proxy-rs.console"; tail -c 32768 /run/log/aa-proxy-rs.console 2> /dev/null
+    echo "=== aa-proxy-rs.log (last $1 B)"; tail -c "$1" /run/log/aa-proxy-rs.log 2> /dev/null
+    echo "=== bluetoothd.log"; tail -c 32768 /run/log/bluetoothd.log 2> /dev/null
+    echo "=== hostapd.log"; tail -c 16384 /run/log/hostapd.log 2> /dev/null
+    echo "=== dmesg"; dmesg 2> /dev/null | tail -c 49152
+}
+fl_write() { # WHY
+    [ -e "$P/u2ac-flightlog-off" ] && return 0
+    [ "${FL_N:-0}" -ge 40 ] && return 0
+    fl_dev || { say "flight log: no safe area in the rootfs MTD, not recording"; FL_N=99; return 1; }
+    [ -n "${FL_SEQ:-}" ] || FL_SEQ=$(fl_lastseq)
+    FL_SEQ=$((FL_SEQ + 1)); _off=$((FL_OFF + (FL_SEQ % 8) * FL_SLOT))
+    _b=786432
+    while :; do
+        fl_bundle $_b | gzip -c > /run/fl.gz
+        [ "$(wc -c < /run/fl.gz)" -le $((FL_SLOT / 2 - FL_HDR)) ] && break   # 2nd half: drive records
+        [ $_b -le 16384 ] && { rm -f /run/fl.gz; return 1; }
+        _b=$((_b / 2))
+    done
+    _l="U2AC-FLIGHTLOG 1 seq=$FL_SEQ up=$(cut -d. -f1 /proc/uptime) why=$1 bytes=$(wc -c < /run/fl.gz)"
+    # home=SEQ: the last slot this boot's home upload sent (u2ac-home): the mark reaches flash here, in a drive
+    _hs=$(cat /run/u2ac-home/sent 2> /dev/null); case $_hs in '' | *[!0-9]*) ;; *) _l="$_l home=$_hs" ;; esac
+    # t=EPOCH: wall-clock time of this write, when this boot's home upload learned it (u2ac-home: /run/u2ac-clock)
+    _ck=$(cat /run/u2ac-clock 2> /dev/null); case $_ck in '' | *[!0-9]*) ;; *) _l="$_l t=$(($(cut -d. -f1 /proc/uptime) + _ck))" ;; esac
+    { echo "$_l"; head -c $((FL_HDR - ${#_l} - 1)) /dev/zero; cat /run/fl.gz; } > /run/fl.slot
+    rm -f /run/fl.gz
+    # never outside [area, end of the MTD): the squashfs lies below FL_OFF (fl_dev checked its bytes_used)
+    [ "$_off" -ge "$FL_OFF" ] && [ $((_off + FL_SLOT)) -le "$_psz" ] && [ $((_off % 65536)) = 0 ] \
+        || { say "flight log: slot offset $_off outside the area, not written"; FL_N=99; rm -f /run/fl.slot; return 1; }
+    # a slot fl_prep erased ahead of time (and still all 0xFF) is only programmed here: no erase stall now
+    if { fl_erased "$_off" || $FL_ERASE "$FL_D" "$_off" 2; } \
+        && dd if=/run/fl.slot of="$FL_D" bs=512 seek=$((_off / 512)) conv=notrunc 2> /dev/null
+    then FL_N=$((${FL_N:-0} + 1)); say "flight log: seq $FL_SEQ ($1) recorded"
+        # this boot's drive records go into the (erased) second half of its first slot (dr_rec)
+        [ -n "${DR_OFF:-}" ] || { DR_OFF=$((_off + FL_SLOT / 2)); DR_N=0; }
+    else say "flight log: write of seq $FL_SEQ FAILED"; fi
+    rm -f /run/fl.slot
+}
+# dr_rec: one drive record. The drive's state so far as one 256-byte line, every minute (every 5 min after two
+# hours), in the second half of this boot's first slot: fl_write erased it with the slot and fills only the first
+# half, and programming erased NOR needs no erase, so nothing stalls the rootfs reads in a session. The last line
+# written before the power cut is the drive's summary: length, Android Auto time and drops, calls, peak temperature,
+# worst phone signal, hotspot devices and reconnects, data, memory, CPU (u2ac-home sends it as u2ac_drive_*).
+# Keys: up t ls(live s) ses err ring rst rep tmax smin sta dev join txf rx tx mem(kB) cpu(%); x = not known.
+# DR_OFF, DR_N, dr_lt (live ticks) and the running extremes dr_tmax/dr_smin/dr_sta/dr_mem live in the saver loop.
+dr_rec() {
+    [ -n "${DR_OFF:-}" ] && [ "${DR_N:-0}" -lt 256 ] || return 0
+    _o=$((DR_OFF + DR_N * 256))
+    [ "$(dd if="$FL_D" bs=256 skip=$((_o / 256)) count=1 2> /dev/null | tr -d '\377' | head -c 1 | wc -c)" = 0 ] \
+        || { DR_N=256; return 0; }
+    _up=$(cut -d. -f1 /proc/uptime); _t=x
+    _ck=$(cat /run/u2ac-clock 2> /dev/null); case $_ck in '' | *[!0-9]*) ;; *) _t=$((_up + _ck)) ;; esac
+    _rep=0; for _x in "$WI"/*.n; do [ -s "$_x" ] && _rep=$((_rep + $(cat "$_x"))); done
+    _rst=$(grep -c 'aa-proxy-rs exited' "$LOG" 2> /dev/null)
+    { iw dev wlan0 station dump 2> /dev/null
+      echo "@@aa"; grep -F -e 'Starting to proxy data' -e 'Connection error' -e 'hfp-guard:' /run/log/aa-proxy-rs.log 2> /dev/null
+      echo "@@hap"; grep -F 'AP-STA-CONNECTED' /run/log/hostapd.log 2> /dev/null
+      echo "@@sys"; for _f in /sys/class/thermal/thermal_zone0/temp /sys/class/net/wlan0/statistics/rx_bytes \
+          /sys/class/net/wlan0/statistics/tx_bytes; do v=; read -r v < "$_f" 2> /dev/null; echo "${v:-x}"; done
+      grep -m 1 '^MemAvailable:' /proc/meminfo; head -n 1 /proc/stat
+    } | awk -v up="$_up" -v t="$_t" -v ls="$((${dr_lt:-0} * 5))" -v rep="$_rep" -v rst="${_rst:-0}" \
+            -v tmax="${dr_tmax:-x}" -v smin="${dr_smin:-x}" -v sta="${dr_sta:-0}" -v mem="${dr_mem:-x}" '
+        /^@@/ { sec = substr($0, 3); next }
+        sec == "" && /^Station/ { n++ }
+        sec == "" && /^[ \t]*signal:/ { s = $2 + 0; if (smin == "x" || s < smin + 0) smin = s }
+        sec == "" && /^[ \t]*tx failed:/ { txf += $3 }
+        sec == "aa" { if (index($0, "Starting to proxy data")) ses++; else if (index($0, "Connection error")) err++; else if (index($0, "RING")) ring++ }
+        sec == "hap" { for (i = 1; i < NF; i++) if ($i == "AP-STA-CONNECTED") { dev[$(i + 1)] = 1; join++ } }
+        sec == "sys" { v[++nv] = $0 }
+        END {
+            if (v[1] != "x" && v[1] != "") { tc = int(v[1] / 1000); if (tmax == "x" || tc > tmax + 0) tmax = tc }
+            split(v[4], ma, " "); if (ma[2] != "" && (mem == "x" || ma[2] + 0 < mem + 0)) mem = ma[2]
+            split(v[5], c, " "); tot = 0; for (i = 2; i <= 8; i++) tot += c[i]
+            cpu = tot ? int(100 * (tot - c[5] - c[6]) / tot) : 0
+            if (n > sta) sta = n; nd = 0; for (d in dev) nd++
+            printf "D1 up=%d t=%s ls=%d ses=%d err=%d ring=%d rst=%d rep=%d tmax=%s smin=%s sta=%d dev=%d join=%d txf=%d rx=%s tx=%s mem=%s cpu=%d\n", \
+                up, t, ls, ses, err, ring, rst, rep, tmax, smin, sta, nd, join, txf, v[2], v[3], mem, cpu
+            print tmax, smin, sta, mem
+        }' > /run/dr.rec 2> /dev/null || return 0
+    { read -r _l; read -r dr_tmax dr_smin dr_sta dr_mem; } < /run/dr.rec
+    printf '%-255.255s\n' "$_l" > /run/dr.line
+    dd if=/run/dr.line of="$FL_D" bs=256 seek=$((_o / 256)) conv=notrunc 2> /dev/null && DR_N=$((DR_N + 1))
+    rm -f /run/dr.rec /run/dr.line
+}
+# fl_erased OFF: the 128 KiB slot at OFF reads all 0xFF
+fl_erased() {
+    [ "$(dd if="$FL_D" bs=65536 skip=$(($1 / 65536)) count=2 2> /dev/null | tr -d '\377' | head -c 1 | wc -c)" = 0 ]
+}
+# fl_prep: erase the slot the next fl_write uses ahead of time, called only outside a session (every NOR erase
+# stalls all rootfs reads for 0.4-2 s), so the write 60 s into a live session only programs pages. Once per slot.
+fl_prep() {
+    [ -e "$P/u2ac-flightlog-off" ] && return 0
+    [ "${FL_N:-0}" -ge 40 ] && return 0
+    [ -n "${FL_OFF:-}" ] || fl_dev || return 1
+    [ -n "${FL_SEQ:-}" ] || FL_SEQ=$(fl_lastseq)
+    _no=$((FL_OFF + ((FL_SEQ + 1) % 8) * FL_SLOT))
+    [ "${FL_PREP:-}" = "$_no" ] && return 0
+    [ "$_no" -ge "$FL_OFF" ] && [ $((_no + FL_SLOT)) -le "$_psz" ] && [ $((_no % 65536)) = 0 ] || return 1
+    fl_erased "$_no" || $FL_ERASE "$FL_D" "$_no" 2 || return 1
+    FL_PREP=$_no
+}
+flightlog() { # [last|SEQ]
+    fl_dev || { echo "flight log: no area (rootfs MTD / squashfs check failed)" >&2; return 1; }
+    _want=${1:-}; [ "$_want" = last ] && _want=$(fl_lastseq)
+    _i=0
+    while [ $_i -lt 8 ]; do
+        _h=$(fl_hdr $_i)
+        if [ -z "$_want" ]; then [ -n "$_h" ] && echo "$_h"
+        elif [ "$(fl_field "$_h" seq)" = "$_want" ]; then
+            _n=$(fl_field "$_h" bytes)
+            dd if="$FL_D" bs=512 skip=$(((FL_OFF + _i * FL_SLOT + FL_HDR) / 512)) count=$(((_n + 511) / 512)) 2> /dev/null \
+                | head -c "$_n" | gunzip -c
+            # the drive records in the slot's second half (dr_rec), padding stripped
+            dd if="$FL_D" bs=65536 skip=$(((FL_OFF + _i * FL_SLOT) / 65536 + 1)) count=1 2> /dev/null | tr -d '\377' \
+                | awk '/^D1 up=[0-9]+ / && length($0) < 300 { sub(/ +$/, ""); if (!n++) print "=== drive records"; print }'
+            return
+        fi
+        _i=$((_i + 1))
+    done
+    [ -z "$_want" ] || { echo "flight log: no seq $_want" >&2; return 1; }
+}
+
+start() {
+    : > "$LOG"
+    say "start"
+    # how the previous run ended (u2ac-metrics, flight log): WDOG1 WRSR, the source of the last reset (read-only):
+    # POR = power-on (the car's normal start), TOUT = the watchdog fired (userspace hung), SFTW = a software reboot
+    # (by hand, the car-off sleep's wake, or a kernel panic's restart). Plus the boot-slot counter's failed attempts
+    _w=$(devmem 0x020BC004 16 2> /dev/null); case $_w in 0x[0-9a-fA-F]*) _w=$((_w)) ;; *) _w=0 ;; esac
+    if [ $((_w & 16)) != 0 ]; then echo power; elif [ $((_w & 2)) != 0 ]; then echo watchdog
+    elif [ $((_w & 1)) != 0 ]; then echo software; else echo unknown; fi > /run/u2ac-reset
+    _bs=$(mtd_num bootstate 2> /dev/null) && bootslot_scan "$_bs" 2> /dev/null | awk '{ print $2 + 0 }' > /run/u2ac-bootfails
+    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g" 2>/dev/null; done
+    echo 1 > /proc/sys/vm/overcommit_memory   # aa-proxy-rs reserves ~1 GiB of address space up front
+    echo 4096 > /proc/sys/vm/min_free_kbytes  # keep atomic-allocation headroom for SDIO/USB/net (no compaction)
+    mount -o remount,size=24m /tmp 2>/dev/null
+    # rcS loads the persist archive in parallel with us (it writes /run/persist.loaded; ~0.1 s); max 10 s
+    n=0; until [ -e /run/persist.loaded ] || [ $n -ge 200 ]; do sleep 0.05; n=$((n + 1)); done
+    # the boot reads the NOR at 49.5 MHz instead of the device tree's 24.75 MHz (u2ac-qspi-boost, tested on the
+    # unit: rootfs read 4.73 s -> 2.87 s, checksums equal); back to normal once the boot's reads are done (below).
+    # Recovery never loads it. Off: `: > /run/persist/u2ac-qspi-normal; persist save` (web Troubleshooting)
+    [ -e "$P/u2ac-qspi-normal" ] || { mod_fast u2ac_qspi_boost > /dev/null 2>&1 && say "flash: NOR at 49.5 MHz for the boot"; }
+    mod_fast u2ac_ws2812 > /dev/null 2>&1 && led 7e172b
+    # the image's zstd-packed executables (aa-proxy-rs) into RAM: ~3 s of work (5.95 MB off the 2.8 MB/s NOR +
+    # 0.86 s of zstd) instead of ~4.5 s via the xz squashfs. Low priority: at full priority it held the radio
+    # bring-up back by that much (radios up 7.7 s -> 11.0 s, the flash 2026-11-28); aa_run waits for it
+    ( read -r me _ < /proc/self/stat; renice -n 10 -p "$me" > /dev/null 2>&1; zbin_unpack ) &
+    # home upload (u2ac-home): the flight-log slots it has not sent yet are read out now, while the radios load;
+    # home_window below sends them before the hotspot starts
+    [ -s "$P/u2ac-home.conf" ] && ( read -r me _ < /proc/self/stat; renice -n 10 -p "$me" > /dev/null 2>&1; u2ac-home prep ) &
+    # car or computer on USB: decided in parallel with the radios (its window no longer adds to the boot)
+    rm -f /run/u2ac-usbhost
+    # A car with NCM on the port (the probe could not tell: no AOA within 3 s) gets the port emptied at once,
+    # not ~20 s later when aa-proxy-rs takes it (SYNC 3 shows "USB device not supported" while NCM is there).
+    # Dev mode keeps NCM.
+    ( if computer_on_usb; then echo computer
+      else
+          _g=/sys/kernel/config/usb_gadget/baseline/UDC
+          if [ ! -e "$P/u2ac-dev" ] && [ -n "$(cat "$_g" 2> /dev/null)" ]; then
+              echo "" > "$_g" 2> /dev/null && say "USB: NCM off the port (no computer on it)" > /dev/null
+          fi
+          echo car
+      fi > /run/u2ac-usbhost ) &
+    cup=$!
+    # Programs come from the xz squashfs, which the single A7 core decompresses at ~3 MB/s (on the unit:
+    # bluetoothd starts in 2.1 s cold / 0.3 s cached, aa-proxy-rs 2.2 s / 0.01 s; a car run had "BT up" 6.2 s
+    # after the radios and the relay's first line 1.7 s after its start). While the radios load: D-Bus started
+    # now (it needs no radio), the Bluetooth stack read into the page cache, then the 15 MB aa-proxy-rs at low
+    # priority (wasted only in dev mode)
+    ( pgrep -x dbus-daemon > /dev/null || { rm -f /run/dbus-daemon.pid; dbus-daemon --system --fork; }
+      cat /usr/libexec/bluetooth/bluetoothd /usr/bin/btmgmt /usr/lib/libglib-2.0.so.0 /usr/lib/libpcre2-8.so.0 \
+          > /dev/null 2>&1 ) &
+    radio_up || { say "radio did not come up (dmesg)"; led 69480f 1000 500; return 1; }
+    say "radios up"
+    watch_init
+    state_restore
+    # A car on the port (the boot's USB probe saw AOA at once), or Android Auto forced: aa-proxy-rs starts now,
+    # in parallel with the AP and Bluetooth (it needs wlan0's MAC and the restored config, both here now). Its
+    # 15 MB binary took 3.5 s to page in when it was started after "BT up" (car runs 2026-11-28: first log line
+    # 3.5 s later, the phone called 0.9 s after that), and it retries the Bluetooth adapter every second until
+    # bluetoothd is up. Anything else (a computer, nobody, dev mode) waits for the computer test below.
+    early=0
+    if [ ! -e "$P/u2ac-dev" ] && { [ "$(cat /run/u2ac-usbprobe 2> /dev/null)" = car ] || [ -e "$P/u2ac-aa-force" ]; }; then
+        aa_run; early=1; say "aa-proxy-rs started early (a car on USB at boot), Bluetooth still coming up"
+    fi
+    # BT bring-up (D-Bus, bluetoothd) in parallel with the AP
+    bt_up &
+    btp=$!
+    home_window
+    fault=0
+    if ap_up; then say "AP up"; else say "AP did not come up (/run/log/hostapd.log)"; fault=1; fi
+    if wait $btp; then say "BT up"; else say "D-Bus/BlueZ did not start (/run/log/bluetoothd.log)"; fault=1; fi
+    # the boot's flash reads are done once the relay is in RAM too: the NOR back to the device tree's clock (the
+    # writes later in the run, persist and the flight recorder, keep the speed they were always tested at)
+    if mod_loaded u2ac_qspi_boost; then
+        ( n=0; until [ -e /run/zbin/.done ] || [ $n -ge 300 ]; do sleep 0.1; n=$((n + 1)); done
+          rmmod u2ac_qspi_boost 2> /dev/null && say "flash: NOR clock back to normal" ) &
+    fi
+    if [ -e "$P/u2ac-dev" ]; then
+        say "dev mode (forced): USB stays NCM (ssh root@192.168.50.2), aa-proxy-rs not started"
+    elif [ ! -e "$P/u2ac-aa-force" ] && wait $cup && [ "$(cat /run/u2ac-usbhost 2> /dev/null)" = computer ]; then
+        say "a computer is on the USB port: maintenance mode for this boot (NCM, ssh root@192.168.50.2); aa-proxy-rs not started"
+        usb_httpd || say "web UI on USB not started (no 192.168.50.2 on usb0)"
+    else
+        [ $early = 1 ] || aa_run
+        say "aa-proxy-rs started (USB = Android Auto toward the car; ssh root@10.0.0.1 over AutoKit)"
+    fi
+    # steady state, one low-priority loop: every 5 s the CPU follows the AA session (cpu_mode); every 30 s
+    # new pairings/settings are persisted (only when changed, never during a session) and the RAM logs capped
+    cpu_mode normal
+    if [ $fault = 1 ]; then led 69480f 1000 500; else led_state; fi
+    # the light: phone in + car switched = green; phone in, car not (yet) = blue; else led_state.
+    # Flight recorder (car mode, aa-proxy-rs ours): 90 s after start, 60 s into each live session, 5 s after a
+    # session ends, and every 2 min while there is no live session if the aa-proxy-rs log grew.
+    (
+        read -r me _ < /proc/self/stat; renice -n 19 -p "$me" > /dev/null 2>&1
+        # idle states carry whether aa-proxy-rs runs (idle1 cyan / idle0 white): the light follows it when it is
+        # started or stopped outside a session (aa-now, a test run), not only at session changes
+        ar() { pgrep -x aa-proxy-rs > /dev/null && echo 1 || echo 0; }
+        m=normal; k=0; lit=idle$(ar); [ $fault = 1 ] && lit=fault; bk=$(bt_key); live=0; fl_at=18; fl_sz=; wf=0
+        had=0; seen=0; sleep_ticks=$((SLEEP_S / 5)); dr_lt=0
+        while :; do
+            sleep "${U2AC_TICK:-5}"; k=$((k + 1))   # U2AC_TICK: the selftest's fast clock
+            # the radios' daemons (radio_watch): wf = something is down right now
+            wf=0; [ -e "$WI/off" ] || radio_watch || wf=1
+            if in_session; then [ $m = session ] || { m=session; cpu_mode session; }
+            elif [ $m = session ]; then m=normal; cpu_mode normal; fi
+            # a start-up fault (radio/AP/BT) stays amber until a phone session shows things work after all
+            if car_live; then st=live; elif [ $m = session ]; then st=phone; elif [ $fault = 1 ] || [ $wf = 1 ]; then st=fault
+            else st=idle$(ar); fi
+            [ $st = live ] && fault=0
+            # car off, USB still powered (car_sleep): a drive ended and the car has not used the port (the UDC is
+            # "configured" only while a host uses it) for SLEEP_S, in ticks of 5 s
+            if [ -s /run/aa-proxy-rs.pid ] && [ ! -e /run/u2ac-sleeping ] && [ ! -e "$P/u2ac-sleep-off" ]; then
+                us=; for _u in /sys/class/udc/*; do { read -r us < "$_u/state"; } 2> /dev/null; break; done
+                if [ $st = live ] || [ "$us" = configured ]; then
+                    [ $st = live ] && had=1; seen=$k
+                elif [ $had = 1 ] && [ $m != session ] && [ $((k - seen)) -ge $sleep_ticks ]; then
+                    car_sleep "no car on USB for ${SLEEP_S} s after the drive (USB ${us:-unknown})"
+                fi
+            fi
+            [ -e /run/u2ac-sleeping ] && lit=sleep
+            if [ $st != $lit ] && [ $lit != sleep ]; then
+                case $st in live) led 003b00 ;; phone) led 00007f 300 100 ;; fault) led 69480f 1000 500 ;;
+                    *) led_state ;; esac
+                lit=$st
+            fi
+            # a new pairing / known phone: to flash now, even in a session (state_save force)
+            _b=$(bt_key); [ "$_b" = "$bk" ] || { state_save force && bk=$_b; }
+            [ $((k % 6)) = 0 ] && { state_save; cap_logs; }
+            if [ -s /run/aa-proxy-rs.pid ]; then
+                if [ $st = live ]; then
+                    [ $live = 0 ] && { live=1; fl_at=$((k + 12)); fl_why=session+60s; }
+                elif [ $live = 1 ]; then live=0; fl_at=$((k + 1)); fl_why=session-end
+                elif [ $((k % 24)) = 0 ]; then
+                    _s=$(wc -c < /run/log/aa-proxy-rs.log 2> /dev/null)
+                    [ "${_s:-0}" != "${fl_sz:-0}" ] && { fl_at=$k; fl_why=periodic; }
+                fi
+                if [ "$fl_at" = "$k" ]; then
+                    fl_write "${fl_why:-start+90s}"; fl_sz=$(wc -c < /run/log/aa-proxy-rs.log 2> /dev/null)
+                fi
+                # the drive record (dr_rec): every 12 ticks = 60 s, every 60 = 5 min after 120 records
+                [ $st = live ] && dr_lt=$((dr_lt + 1))
+                dr_ev=12; [ "${DR_N:-0}" -ge 120 ] && dr_ev=60
+                [ $((k % dr_ev)) = 0 ] && dr_rec
+                # outside a session: the next slot erased already (no I/O once it is)
+                [ $m = session ] || fl_prep
+            fi
+        done
+    ) &
+    echo $! > /run/u2ac-saver.pid
+}
+
+stop() {
+    for f in /run/u2ac-saver.pid /run/aa-proxy-rs.pid /run/hostapd.pid /run/udhcpd-wlan.pid /run/dropbear-wlan.pid \
+             /run/httpd-wlan.pid /run/httpd-usb.pid /run/bluetoothd.pid; do
+        [ -s "$f" ] && kill "$(cat "$f")" 2>/dev/null; rm -f "$f"
+    done
+    killall aa-proxy-rs bluetoothd dbus-daemon httpd 2>/dev/null
+    rm -f /run/dbus-daemon.pid
+    led 000000
+    state_save force
+}
+
+case ${1:-} in
+    start) start ;;
+    stop) stop ;;
+    persist) state_save force || exit 1 ;;
+    flightlog) flightlog "${2:-}" ;;
+    aa-now)
+        # start Android Auto now, from maintenance mode (the NCM link to the computer goes away). The supervisor
+        # counts, not only the process: between two of its restarts no aa-proxy-rs runs for a moment
+        if { [ -s /run/aa-proxy-rs.pid ] && kill -0 "$(cat /run/aa-proxy-rs.pid)" 2> /dev/null; } \
+            || pgrep -x aa-proxy-rs > /dev/null; then
+            echo "aa-proxy-rs already running"; exit 0
+        fi
+        aa_run; say "aa-proxy-rs started by hand (aa-now)"; led_state ;;
+    status)
+        for d in hostapd udhcpd dbus-daemon bluetoothd aa-proxy-rs; do
+            printf '%-12s %s\n' "$d" "$(pgrep -x "$d" > /dev/null && echo running || echo -)"
+        done
+        iw dev wlan0 info 2>/dev/null | grep -E 'ssid|type|channel'
+        cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null | sed 's/^/cpu kHz /'
+        if [ -e "$P/u2ac-dev" ]; then echo "mode: dev forced (NCM)"; elif [ -e "$P/u2ac-aa-force" ]; then echo "mode: android-auto forced"
+        else echo "mode: auto ($(pgrep -x aa-proxy-rs > /dev/null && echo android-auto || echo maintenance))"; fi
+        echo "usb at boot: probe $(cat /run/u2ac-usbprobe 2> /dev/null || echo -), host $(cat /run/u2ac-usbhost 2> /dev/null || echo -)"
+        echo "hands-free guard: $([ -e "$P/u2ac-hfp-guard-off" ] && echo off || echo on)"
+        _r=; for _x in hostapd wifi-rebind bluetoothd bt-rebind; do
+            [ -s "$WI/$_x.n" ] && _r="$_r $_x=$(cat "$WI/$_x.n")"; done
+        echo "radio repairs this boot:${_r:- none}$([ -e "$WI/off" ] && echo ' (watch off)')"
+        if [ -e /run/u2ac-sleeping ]; then echo "car-off sleep: SLEEPING (radios off, USB port waits for a host)"
+        else echo "car-off sleep: $([ -e "$P/u2ac-sleep-off" ] && echo off || echo "on (after ${SLEEP_S} s without the car)")"; fi
+        u2ac-home status 2> /dev/null
+        ;;
+    home-now)
+        # the home upload by hand (web "Upload now"): the hotspot stops for the few seconds wlan0 is a client.
+        # `all`: every slot in the flight log again, not only the ones newer than the last upload
+        [ -s "$P/u2ac-home.conf" ] || { echo "the home upload is not set up (web Settings, Home upload)"; exit 1; }
+        in_session && { echo "not during an Android Auto session"; exit 1; }
+        [ -e /run/u2ac-sleeping ] && { echo "not while the dongle sleeps"; exit 1; }
+        if [ "${2:-}" = all ]; then U2AC_HOME_ALL=1 u2ac-home prep; else u2ac-home prep; fi
+        if ! ls /run/u2ac-home/q/*.prom > /dev/null 2>&1; then echo "nothing new to send"; exit 0; fi
+        # radio_watch would bring the hotspot back in the middle of it
+        mkdir -p "$WI"; wo=0; [ -e "$WI/off" ] || { : > "$WI/off"; wo=1; }
+        for f in /run/hostapd.pid /run/udhcpd-wlan.pid; do [ -s "$f" ] && kill "$(cat "$f")" 2> /dev/null; rm -f "$f"; done
+        sleep 0.5
+        u2ac-home push 20 > /dev/null 2>&1; hrc=$?   # (not rc: ap_radio sets that)
+        ap_radio > /dev/null 2>&1; say "home upload: hotspot back"
+        [ $wo = 1 ] && rm -f "$WI/off"
+        # the learned channel and the mark to flash (outside a session, as always)
+        state_save > /dev/null 2>&1
+        r=$(cut -d' ' -f4- /run/u2ac-home/result 2> /dev/null); echo "${r:-no result}"
+        exit $hrc
+        ;;
+    sleep-now) mkdir -p "$WI"; car_sleep "by hand (u2ac-aa sleep-now)"; echo "sleeping: radios off, the USB port waits for a host" ;;
+    watch) mkdir -p "$WI"; [ -s "$WI/wlan.host" ] || watch_init; radio_watch && echo "radios ok" || { echo "a radio is down (see $LOG)"; exit 1; } ;;
+    dev)
+        case ${2:-} in
+            on) rm -f "$P/u2ac-aa-force"; : > "$P/u2ac-dev" && state_save force && echo "dev mode forced on (after reboot: USB = NCM always)" ;;
+            off) rm -f "$P/u2ac-dev" "$P/u2ac-aa-force" && state_save force && echo "auto mode (computer on USB = NCM, car = Android Auto)" ;;
+            aa) rm -f "$P/u2ac-dev"; : > "$P/u2ac-aa-force" && state_save force && echo "Android Auto forced (even with a computer on USB)" ;;
+            *) echo "usage: u2ac-aa dev on|off|aa" >&2; exit 2 ;;
+        esac
+        ;;
+    *) echo "usage: u2ac-aa start|stop|status|persist|aa-now|watch|sleep-now|home-now [all]|dev on|off|aa|flightlog [last|SEQ]" >&2; exit 2 ;;
+esac
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-home b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-home
new file mode 100755
index 0000000..b4fd55f
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-home
@@ -0,0 +1,284 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# u2ac-home prep|push [SECONDS]|cleanup|status   (Carlinkit U2AC, milouk 2026-11-28)
+# Home upload: the health numbers of each car run (the "=== metrics" part of a flight-log slot: u2ac-metrics
+# text taken during the run) go to a Prometheus Pushgateway on the home network, one group per slot:
+# job="u2ac", log_seq="<seq>". In the car the dongle has no network but its own hotspot, and the car cuts its
+# power at switch-off, so the upload runs at the START of a drive from home: u2ac-aa start calls `push` after
+# the radio bring-up and before the hotspot takes wlan0 (the phone joins it only seconds later), boxed to
+# U2AC_HOME_S (4) s, and only when the flight log holds slots newer than the last upload.
+#   prep     the slots newer than the last upload, as request bodies in /run/u2ac-home/q/SEQ.prom (no network)
+#   push     one directed scan (the network absent = done in ~0.1 s), join it as a client, DHCP, POST each body,
+#            leave. SECONDS = the time box (20 by hand). Leaves wlan0 down: the caller starts the hotspot after
+#            (by hand: `u2ac-aa home-now`, which stops and restarts the hotspot around it)
+#   cleanup  the client side off wlan0 (wpa_supplicant, udhcpc, the DHCP address)
+# Each slot sent carries, besides its metrics: u2ac_flightlog_* (seq, why, when), the drive summary from the slot's
+# last drive record (u2ac_drive_*: length, drops, calls, peak temperature, worst signal, hotspot devices, data...),
+# and wall-clock start/end times when that boot's own upload learned the clock (/run/u2ac-clock, from the server's
+# HTTP Date: the dongle has no clock of its own).
+# Learned too: u2ac-home.lease (the last DHCP address and router, asked for again and used as it was when DHCP
+# cannot answer within a boot's box).
+# Settings: /run/persist/u2ac-home.conf, literal KEY=value lines written by the web UI, never sourced:
+#   SSID=<home Wi-Fi name>   PMK=<64 hex: the WPA2 key wpa_passphrase derives from name + password; the
+#   password itself is not kept>   URL=http://<IPv4>:<port>[/prefix]   (no DNS on the dongle)
+# Learned: u2ac-home.freq (where the network was found: the next scan looks there first) and u2ac-home.sent (the
+# last seq uploaded). A drive does not reach /run/persist (no flash writes in a session), so the next flight-log
+# slot's header carries the mark too (home=SEQ, u2ac-aa fl_write): prep takes the newer of the two.
+# WPA2-PSK only (this wpa_supplicant has no SAE): a WPA2/WPA3 transition network works, WPA3-only does not.
+# Test hooks (emulated selftest only): U2AC_HOME_SYS (a fake /sys/class/net), U2AC_HOME_KEEP.
+export PATH=/usr/sbin:/usr/bin:/sbin:/bin
+P=/run/persist
+H=/run/u2ac-home
+LOG=/run/log/u2ac-aa.log
+CONF=$P/u2ac-home.conf
+NET=${U2AC_HOME_SYS:-/sys/class/net}
+KEEP=${U2AC_HOME_KEEP:-30}   # groups kept on the Pushgateway: uploading seq N deletes seq N-KEEP
+cs() { read -r _u _ < /proc/uptime; _c=${_u#*.}; echo $(( ${_u%.*} * 100 + ${_c#0} )); }
+say() { _t=$(cut -d' ' -f1 /proc/uptime); echo "u2ac-home: $*"; echo "u2ac-aa: [$_t] home upload: $*" >> "$LOG"; }
+cget() { K=$1 awk 'index($0, ENVIRON["K"] "=") == 1 { print substr($0, length(ENVIRON["K"]) + 2); exit }' "$CONF" 2> /dev/null; }
+
+# conf: the settings, checked (the web UI validated them; a hand-edited file gets the same checks)
+conf() {
+    [ -s "$CONF" ] || return 1
+    SSID=$(cget SSID); PMK=$(cget PMK); URL=$(cget URL)
+    [ -n "$SSID" ] && [ ${#SSID} -le 32 ] && [ ${#PMK} = 64 ] || return 1
+    case $PMK in *[!0-9a-f]*) return 1 ;; esac
+    case $URL in http://[0-9]*) ;; *) return 1 ;; esac
+    HP=${URL#http://}; HPATH=
+    case $HP in */*) HPATH=/${HP#*/}; HP=${HP%%/*} ;; esac
+    HPATH=${HPATH%/}; HOST=${HP%:*}; PORT=${HP##*:}
+    [ "$HOST" = "$HP" ] && PORT=80
+    case $HOST.$PORT in *[!0-9.]*) return 1 ;; esac
+    BASE=http://$HP$HPATH
+}
+
+prep() {
+    rm -rf "$H/q" "$H/ready"; mkdir -p "$H/q"
+    conf || { : > "$H/ready"; return 0; }
+    _m=0; [ -s "$P/u2ac-home.sent" ] && read -r _m < "$P/u2ac-home.sent"
+    case $_m in '' | *[!0-9]*) _m=0 ;; esac
+    [ -n "${U2AC_HOME_ALL:-}" ] && _m=0
+    u2ac-aa flightlog > "$H/list" 2> /dev/null
+    if [ -z "${U2AC_HOME_ALL:-}" ]; then
+        for _h in $(sed -n 's/.* home=\([0-9][0-9]*\).*/\1/p' "$H/list"); do [ "$_h" -gt "$_m" ] && _m=$_h; done
+    fi
+    echo "$_m" > "$H/base"
+    while read -r _l; do
+        _s=$(echo "$_l" | sed -n 's/.* seq=\([0-9][0-9]*\) .*/\1/p')
+        _w=$(echo "$_l" | sed -n 's/.* why=\([A-Za-z0-9+_-]*\).*/\1/p')
+        _u=$(echo "$_l" | sed -n 's/.* up=\([0-9][0-9]*\) .*/\1/p')
+        [ -n "$_s" ] && [ "$_s" -gt "$_m" ] || continue
+        # Prometheus text as u2ac-metrics wrote it, minus the HELP lines (the Pushgateway wants each name's HELP
+        # equal across groups, and a firmware update may reword one), plus what identifies the slot
+        _t=$(echo "$_l" | sed -n 's/.* t=\([0-9][0-9]*\).*/\1/p')
+        u2ac-aa flightlog "$_s" > "$H/slot.txt" 2> /dev/null
+        sed -n '/^=== metrics$/,/^=== /p' "$H/slot.txt" | grep -v -e '^=== ' -e '^# HELP ' > "$H/q/$_s.tmp"
+        if grep -q '^u2ac_up 1$' "$H/q/$_s.tmp"; then
+            printf '# TYPE u2ac_flightlog_seq gauge\nu2ac_flightlog_seq %s\n# TYPE u2ac_flightlog_info gauge\nu2ac_flightlog_info{why="%s"} 1\n# TYPE u2ac_flightlog_written_seconds gauge\nu2ac_flightlog_written_seconds %s\n' \
+                "$_s" "${_w:-unknown}" "${_u:-0}" >> "$H/q/$_s.tmp"
+            # wall-clock times (only for a boot whose own home upload learned the clock: a drive from home)
+            [ -n "$_t" ] && printf '# TYPE u2ac_flightlog_written_timestamp_seconds gauge\nu2ac_flightlog_written_timestamp_seconds %s\n# TYPE u2ac_drive_start_timestamp_seconds gauge\nu2ac_drive_start_timestamp_seconds %s\n' \
+                "$_t" "$((_t - ${_u:-0}))" >> "$H/q/$_s.tmp"
+            drive "$H/slot.txt" >> "$H/q/$_s.tmp"
+            mv -f "$H/q/$_s.tmp" "$H/q/$_s.prom"
+        else
+            rm -f "$H/q/$_s.tmp"   # a slot from before the exporter (no metrics part): nothing to send
+        fi
+    done < "$H/list"
+    rm -f "$H/slot.txt"
+    : > "$H/ready"
+}
+
+# drive SLOTTEXT: the slot's last drive record (u2ac-aa dr_rec) as u2ac_drive_* (Prometheus text, no HELP)
+drive() {
+    awk '/^D1 up=/ { last = $0; n++ }
+    function g(name, v) { if (v == "" || v == "x") return; printf "# TYPE %s gauge\n%s %s\n", name, name, v }
+    END {
+        if (!n) exit
+        m = split(last, F, " "); for (i = 2; i <= m; i++) { j = index(F[i], "="); if (j) v[substr(F[i], 1, j - 1)] = substr(F[i], j + 1) }
+        g("u2ac_drive_records", n)
+        g("u2ac_drive_seconds", v["up"]); g("u2ac_drive_live_seconds", v["ls"])
+        g("u2ac_drive_sessions", v["ses"]); g("u2ac_drive_drops", (v["ses"] + 0 > 1) ? v["ses"] - 1 : 0)
+        g("u2ac_drive_connection_errors", v["err"]); g("u2ac_drive_rings", v["ring"])
+        g("u2ac_drive_relay_restarts", v["rst"]); g("u2ac_drive_radio_repairs", v["rep"])
+        g("u2ac_drive_temperature_max_celsius", v["tmax"]); g("u2ac_drive_signal_min_dbm", v["smin"])
+        g("u2ac_drive_stations_max", v["sta"]); g("u2ac_drive_hotspot_devices", v["dev"]); g("u2ac_drive_hotspot_joins", v["join"])
+        g("u2ac_drive_tx_failed", v["txf"]); g("u2ac_drive_rx_bytes", v["rx"]); g("u2ac_drive_tx_bytes", v["tx"])
+        if (v["mem"] != "x" && v["mem"] != "") g("u2ac_drive_memory_available_min_bytes", v["mem"] * 1024)
+        if (v["cpu"] != "") g("u2ac_drive_cpu_busy_ratio", v["cpu"] / 100)
+        g("u2ac_drive_end_timestamp_seconds", v["t"])
+    }' "$1"
+}
+
+# clock: the wall clock from the server's HTTP Date header (wget -S) as an offset from power-on, in /run/u2ac-clock.
+# The system clock is never set: the relay's and hostapd's log stamps are read as seconds since power-on
+clock() {
+    awk -v up="$(cut -d' ' -f1 /proc/uptime)" '
+        tolower($1) == "date:" && !found {
+            split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", M, " "); for (i = 1; i <= 12; i++) mo[M[i]] = i
+            d = $3 + 0; m = mo[$4]; y = $5 + 0; split($6, h, ":"); if (!m || y < 2024 || y > 2100) next
+            yy = y - (m <= 2); era = int(yy / 400); yoe = yy - era * 400; mp = (m + 9) % 12   # days from civil
+            doy = int((153 * mp + 2) / 5) + d - 1; doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
+            printf "%d\n", (era * 146097 + doe - 719468) * 86400 + h[1] * 3600 + h[2] * 60 + h[3] - int(up); found = 1 }
+        END { exit !found }' "$1" > "$H/clock.tmp" && mv -f "$H/clock.tmp" /run/u2ac-clock
+    rm -f "$H/clock.tmp"
+}
+
+# result STATE TEXT: this boot's outcome (u2ac-aa status, u2ac-metrics, the log). STATE: pushed absent failed none
+result() {
+    _d=$(( $(cs) - ${T0:-$(cs)} ))
+    printf '%s %s %s %s\n' "$1" "$_d" "${NPUSH:-0}" "$2" > "$H/result"
+    say "$2 ($((_d / 100)).$(printf '%02d' $((_d % 100))) s)"
+}
+
+cleanup() {
+    if [ -s "$H/wpa.pid" ]; then
+        _p=$(cat "$H/wpa.pid"); kill "$_p" 2> /dev/null
+        _n=0; while kill -0 "$_p" 2> /dev/null && [ $_n -lt 20 ]; do sleep 0.05; _n=$((_n + 1)); done
+    fi
+    pkill -x udhcpc 2> /dev/null
+    [ -s "$H/ip" ] && ip addr del "$(cat "$H/ip")" dev wlan0 2> /dev/null
+    rm -f "$H/wpa.pid" "$H/wpa.conf" "$H/ip" "$H/router"; rm -rf "$H/wpa"
+    ip link set wlan0 down 2> /dev/null
+    return 0
+}
+
+# why: what wpa_supplicant last reported, in a few words (wpa.log)
+why() {
+    awk '/WRONG_KEY|4-Way Handshake failed|pre-shared key may be incorrect/ { k++ }
+         /CTRL-EVENT-ASSOC-REJECT/ { r++; s = $0; sub(/.*status_code=/, "", s); sub(/ .*/, "", s) }
+         /Trying to associate/ { t++ }
+         END { if (k) print "wrong password (" k " key handshake failures)"
+               else if (r) print r " association rejects (status " s "), weak signal?"
+               else if (t) print t " association attempts, no answer"
+               else print "never tried to associate" }' "$H/wpa.log" 2> /dev/null
+}
+
+sec() { echo "$(($1 / 100)).$(printf '%02d' $(($1 % 100))) s"; }
+
+left() { _l=$(( (END - $(cs)) / 100 )); [ $_l -ge 1 ] || _l=1; echo $_l; }
+
+# scan FREQS (empty = every channel): the strongest BSS named SSID -> BSSID BFREQ (MHz)
+scan() {
+    _try=0
+    while :; do
+        timeout "$(left)" iw dev wlan0 scan ${1:+freq $1} ssid "$SSID" > "$H/scan" 2> "$H/scan.err" && break
+        # busy right after the interface came up: once more
+        _try=$((_try + 1)); [ $_try -lt 2 ] && [ "$(cs)" -lt "$END" ] || return 1
+        sleep 0.2
+    done
+    S=$SSID awk '
+        /^BSS / { b = substr($2, 1, 17); f = ""; s = -999 }
+        /^[ \t]*freq: / { f = $2 }
+        /^[ \t]*signal: / { s = $2 + 0 }
+        /^[ \t]*SSID: / { n = $0; sub(/^[ \t]*SSID: /, "", n)
+                          if (n == ENVIRON["S"] && b != "" && (best == "" || s > bs)) { best = b; bf = f; bs = s } }
+        END { if (best == "") exit 1; sub(/\..*/, "", bf); printf "%s %s %d\n", best, bf, bs }' "$H/scan" > "$H/found" || return 1
+    read -r BSSID BFREQ BSIG < "$H/found"
+    case $BFREQ in '' | *[!0-9]*) return 1 ;; esac
+}
+
+# del SEQ: drop an old group from the Pushgateway (busybox wget cannot send DELETE; HTTP/1.0, one request)
+del() {
+    printf 'DELETE %s/metrics/job/u2ac/log_seq/%s HTTP/1.0\r\nHost: %s\r\n\r\n' "$HPATH" "$1" "$HP" \
+        | timeout 3 nc "$HOST" "$PORT" > "$H/del.out" 2> /dev/null
+    head -n 1 "$H/del.out" 2> /dev/null | grep -q '^HTTP/1\.[01] 2'
+}
+
+push() {
+    BOX=${1:-20}; case $BOX in '' | *[!0-9]*) BOX=20 ;; esac
+    T0=$(cs); END=$((T0 + BOX * 100)); NPUSH=0
+    mkdir -p "$H"
+    conf || { result failed "not set up"; return 1; }
+    [ -e "$H/ready" ] || prep
+    set -- $(ls "$H/q" 2> /dev/null | sed -n 's/^\([0-9][0-9]*\)\.prom$/\1/p' | sort -n)
+    [ $# -gt 0 ] || { result none "nothing new to send"; return 0; }
+    trap 'cleanup; exit 1' TERM INT
+    ip link set wlan0 down 2> /dev/null; iw dev wlan0 set type managed 2> /dev/null
+    ip link set wlan0 up 2> /dev/null || { cleanup; result failed "wlan0 did not come up"; return 1; }
+    # 1. is it here? Its last channel (0.07 s on the unit), else the usual ones; by hand every channel (2.6 s)
+    F=; [ -s "$P/u2ac-home.freq" ] && read -r F < "$P/u2ac-home.freq"
+    case $F in *[!0-9]*) F= ;; esac
+    COMMON="2412 2437 2462 5180 5200 5220 5240"
+    if [ -n "$F" ]; then scan "$F" || scan "$(echo $COMMON | tr ' ' '\n' | grep -vx "$F" | tr '\n' ' ')"
+    else scan "$COMMON"; fi || { [ "$BOX" -ge 10 ] && scan ""; } || {
+        cleanup; result absent "$SSID not in range"; return 3; }
+    [ "$BFREQ" = "$F" ] || echo "$BFREQ" > "$P/u2ac-home.freq"
+    T1=$(cs)
+    # 2. join: this BSS, this channel, the stored PMK (no passphrase hashing on the A7)
+    _sh=$(printf '%s' "$SSID" | hexdump -v -e '1/1 "%02x"')
+    (umask 077; printf 'ctrl_interface=%s/wpa\nap_scan=1\nnetwork={\n\tssid=%s\n\tbssid=%s\n\tpsk=%s\n\tkey_mgmt=WPA-PSK\n\tproto=RSN\n\tieee80211w=1\n\tscan_freq=%s\n\tfreq_list=%s\n}\n' \
+        "$H" "$_sh" "$BSSID" "$PMK" "$BFREQ" "$BFREQ" > "$H/wpa.conf")
+    # in the background, not -B: its event lines (associating, rejected, connected) go to wpa.log for the result
+    wpa_supplicant -i wlan0 -D nl80211 -c "$H/wpa.conf" > "$H/wpa.log" 2>&1 &
+    echo $! > "$H/wpa.pid"
+    # joined = operstate up: wpa_supplicant keeps the link dormant until the key handshake is done
+    until [ "$(cat "$NET/wlan0/operstate" 2> /dev/null)" = up ]; do
+        if [ "$(cs)" -ge "$END" ] || ! kill -0 "$(cat "$H/wpa.pid")" 2> /dev/null; then
+            _why=$(why); cleanup; result failed "could not join $SSID ($BFREQ MHz, $BSIG dBm): $_why"; return 1
+        fi
+        sleep 0.05
+    done
+    T2=$(cs)
+    # 3. an address (and a route via its router, for a server in another subnet): DHCP asking for the last lease.
+    # dnsmasq (OpenWrt) pings an address ~3 s before it offers it to a client it has no lease for, which a 4 s box
+    # cannot wait for: there the last lease is used as it was once DHCP has had 1 s (u2ac-home.lease, from the
+    # last upload that got one; the address is held for a second or two)
+    LEASE= LROUTER=; [ -s "$P/u2ac-home.lease" ] && read -r LEASE LROUTER < "$P/u2ac-home.lease"
+    case $LEASE in *[!0-9./]*) LEASE= ;; *.*.*.*/*) ;; *) LEASE= ;; esac
+    case $LROUTER in *[!0-9.]*) LROUTER= ;; esac
+    _t=$(left); [ -n "$LEASE" ] && [ "$BOX" -lt 10 ] && _t=1
+    timeout "$_t" udhcpc -i wlan0 -f -q -n -t "$_t" -T 1 -A 1 -x hostname:u2ac ${LEASE:+-r ${LEASE%/*}} \
+        -s /usr/share/u2ac/home-dhcp.sh > /dev/null 2>&1
+    HOW=DHCP
+    if [ ! -s "$H/ip" ] && [ -n "$LEASE" ]; then
+        ip addr add "$LEASE" dev wlan0 2> /dev/null && echo "$LEASE" > "$H/ip" && HOW="the last lease"
+        [ -n "$LROUTER" ] && ip route add default via "$LROUTER" dev wlan0 2> /dev/null
+    fi
+    [ -s "$H/ip" ] || { cleanup; result failed "no address from DHCP on $SSID"; return 1; }
+    if [ "$HOW" = DHCP ]; then
+        _ls="$(cat "$H/ip") $(cat "$H/router" 2> /dev/null)"
+        [ "$(cat "$P/u2ac-home.lease" 2> /dev/null)" = "$_ls" ] || echo "$_ls" > "$P/u2ac-home.lease"
+    fi
+    T3=$(cs)
+    # 4. the bodies, oldest first; the mark moves only as far as the uploads went in order
+    _last=
+    for _s; do
+        [ "$(cs)" -lt "$END" ] || break
+        wget -S -q -T "$(left)" -O /dev/null --header 'Content-Type: text/plain; version=0.0.4' \
+            --post-file "$H/q/$_s.prom" "$BASE/metrics/job/u2ac/log_seq/$_s" 2> "$H/wget.err" || break
+        [ $NPUSH = 0 ] && clock "$H/wget.err"
+        NPUSH=$((NPUSH + 1)); _last=$_s; rm -f "$H/q/$_s.prom"
+        [ "$_s" -gt "$KEEP" ] && del $((_s - KEEP))
+    done
+    # the mark first (before the ~1 s of cleanup, which a boot's time box may cut short)
+    if [ -n "$_last" ]; then
+        echo "$_last" > "$H/sent"
+        [ "$(cat "$P/u2ac-home.sent" 2> /dev/null)" = "$_last" ] || echo "$_last" > "$P/u2ac-home.sent"
+    fi
+    cleanup
+    printf 'scan=%s join=%s address=%s signal=%s lease=%s\n' $((T1 - T0)) $((T2 - T1)) $((T3 - T2)) "$BSIG" \
+        "$([ "$HOW" = DHCP ] && echo 0 || echo 1)" > "$H/stats"
+    if [ "$NPUSH" = $# ]; then
+        result pushed "sent $NPUSH log(s) up to seq $_last to $HP (scan $(sec $((T1 - T0))), join $(sec $((T2 - T1))) at $BSIG dBm, address $(sec $((T3 - T2))) by $HOW)"
+    elif [ "$NPUSH" -gt 0 ]; then result failed "sent $NPUSH of $# log(s), the server stopped answering"
+    else result failed "the server at $HP did not take the upload ($(head -c 80 "$H/wget.err" 2> /dev/null | tr '\n' ' '))"; fi
+    [ "$NPUSH" = $# ]
+}
+
+status() {
+    if conf; then
+        _r=; [ -s "$H/result" ] && read -r _st _d _n _r < "$H/result"
+        echo "home upload: on (to $HP over $SSID)${_r:+, this boot: $_r}"
+    else
+        echo "home upload: off"
+    fi
+}
+
+case ${1:-} in
+    prep) prep ;;
+    push) push "${2:-20}" ;;
+    cleanup) cleanup ;;
+    status) status ;;
+    *) echo "usage: u2ac-home prep|push [SECONDS]|cleanup|status" >&2; exit 2 ;;
+esac
diff --git a/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-metrics b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-metrics
new file mode 100755
index 0000000..0159e45
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/sbin/u2ac-metrics
@@ -0,0 +1,247 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# u2ac-metrics: the dongle's health as Prometheus text (exposition format 0.0.4), for GET /cgi-bin/metrics
+# and a copy in every flight-log slot (u2ac-aa fl_bundle). Nothing runs in the background: each call reads
+# /proc, /sys and the RAM logs once (one awk), plus `iw` twice and `dumpleases`. No MAC addresses, names,
+# SSIDs or keys in the output (it is served on the hotspot without a login): a Wi-Fi station is a number
+# and a role (aa_phone = the one holding the Android Auto session, else other).
+# Times are seconds since power-on (the dongle has no clock). Counters cover this boot's RAM logs, which
+# cap_logs trims to their newest 256 KiB: a long drive's oldest events drop out of them.
+# FAKE_ROOT: a path prefix for the host self-test (unset on the unit).
+R=${FAKE_ROOT:-}
+PATH=/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}
+P=$R/run/persist
+WIF=wlan0
+for _n in "$R"/sys/class/net/*; do [ -e "$_n/phy80211" ] && { WIF=${_n##*/}; break; }; done
+
+# the daemons, from /proc/*/comm with builtins (name:pid pairs)
+PROCS=
+for _p in "$R"/proc/[0-9]*; do
+    { read -r _c < "$_p/comm"; } 2> /dev/null || continue
+    case $_c in hostapd | udhcpd | dbus-daemon | bluetoothd | aa-proxy-rs | httpd | dropbear) PROCS="$PROCS $_c:${_p##*/}" ;; esac
+done
+IWI=$(iw dev "$WIF" info 2> /dev/null)
+STA=$(iw dev "$WIF" station dump 2> /dev/null)
+LEASE=; [ -n "$STA" ] && LEASE=$(dumpleases -f "$R/run/udhcpd-wlan.leases" 2> /dev/null)
+UDC=; for _u in "$R"/sys/class/udc/*; do [ -e "$_u/state" ] && { read -r UDC < "$_u/state"; break; }; done 2> /dev/null
+PID=$(cat "$R"/sys/kernel/config/usb_gadget/*/idProduct 2> /dev/null | tr '\n' ' ')
+MODE=auto; [ -e "$P/u2ac-aa-force" ] && MODE=aa; [ -e "$P/u2ac-dev" ] && MODE=dev
+PAIRED=0; for _x in "$R"/var/lib/bluetooth/*/[0-9A-F][0-9A-F]:??:??:??:??:??; do [ -d "$_x" ] && PAIRED=$((PAIRED + 1)); done
+KNOWN=$(grep -c . "$R/etc/aa-proxy-rs/known_devices" 2> /dev/null)
+HCI=0; [ -e "$R/sys/class/bluetooth/hci0" ] && HCI=1
+AALOG=$R/var/log/aa-proxy-rs.log
+
+{
+    echo "@@iwi"; [ -n "$IWI" ] && printf '%s\n' "$IWI"
+    echo "@@sta"; [ -n "$STA" ] && printf '%s\n' "$STA"
+    echo "@@lease"; [ -n "$LEASE" ] && printf '%s\n' "$LEASE"
+    echo "@@tcp"; cat "$R/proc/net/tcp" 2> /dev/null
+    echo "@@svc"; cat "$R/run/log/u2ac-aa.log" 2> /dev/null
+    echo "@@hap"; cat "$R/run/log/hostapd.log" 2> /dev/null
+    # only the lines the parser looks at (the log reaches ~1 MB in a drive)
+    echo "@@aa"; grep -F -e 'aa-proxy-rs is starting' -e 'Trying to connect to' -e 'Successfully connected to device' \
+        -e 'stage #5 of 5' -e 'new client connected' -e 'AOA GET_PROTOCOL' -e 'AOA start request' \
+        -e 'Starting to proxy data' -e 'Connection error' -e 'hfp-guard:' "$AALOG" 2> /dev/null
+} | awk -v R="$R" -v procs="$PROCS" -v wif="$WIF" -v udc="$UDC" -v pid="$PID" -v mode="$MODE" \
+    -v paired="$PAIRED" -v known="${KNOWN:-0}" -v hci="$HCI" \
+    -v guardoff="$([ -e "$P/u2ac-hfp-guard-off" ] && echo 1 || echo 0)" \
+    -v fltoff="$([ -e "$P/u2ac-flightlog-off" ] && echo 1 || echo 0)" \
+    -v sleeping="$([ -e "$R/run/u2ac-sleeping" ] && echo 1 || echo 0)" -v sleepoff="$([ -e "$P/u2ac-sleep-off" ] && echo 1 || echo 0)" \
+    -v homeon="$([ -s "$P/u2ac-home.conf" ] && echo 1 || echo 0)" -v homeres="$(head -n 1 "$R/run/u2ac-home/result" 2> /dev/null)" \
+    -v homest="$(head -n 1 "$R/run/u2ac-home/stats" 2> /dev/null)" -v reset="$(cat "$R/run/u2ac-reset" 2> /dev/null)" \
+    -v bootfails="$(cat "$R/run/u2ac-bootfails" 2> /dev/null)" -v clock="$(cat "$R/run/u2ac-clock" 2> /dev/null)" \
+    -v probe="$(cat "$R/run/u2ac-usbprobe" 2> /dev/null)" -v host="$(cat "$R/run/u2ac-usbhost" 2> /dev/null)" \
+    -v rel="$(head -n 1 "$R/etc/baseline-release" 2> /dev/null)" -v kver="$(uname -r)" '
+function rd(f,   l) { l = ""; if ((getline l < f) <= 0) l = ""; close(f); return l }
+function lab(s) { gsub(/[ \t]+/, "_", s); gsub(/[^A-Za-z0-9._:+-]/, "", s); return s }
+function num(v) { return sprintf("%.10g", v + 0) }
+function fam(n, t, h) { printf "# HELP %s %s\n# TYPE %s %s\n", n, h, n, t }
+function out(n, l, v) { if (v == "") return; printf "%s%s %s\n", n, (l == "" ? "" : "{" l "}"), num(v) }
+function one(n, t, h, v) { if (v == "") return; fam(n, t, h); out(n, "", v) }
+function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
+function hexv(s,   i, c, v) { v = 0; s = toupper(s); for (i = 1; i <= length(s); i++) { c = index("0123456789ABCDEF", substr(s, i, 1)) - 1; v = v * 16 + c } return v }
+function ip4(h) { return hexv(substr(h, 7, 2)) "." hexv(substr(h, 5, 2)) "." hexv(substr(h, 3, 2)) "." hexv(substr(h, 1, 2)) }
+function bps(s,   a) { split(s, a, " "); return (a[2] == "MBit/s") ? a[1] * 1e6 : "" }
