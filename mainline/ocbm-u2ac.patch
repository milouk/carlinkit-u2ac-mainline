diff --git a/baseline/arm-imx6ul-u2ac/dts/stock-usb-reference.dtsi b/baseline/arm-imx6ul-u2ac/dts/stock-usb-reference.dtsi
new file mode 100644
index 0000000..bc6ecf5
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/dts/stock-usb-reference.dtsi
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * REFERENCE ONLY, NOT INCLUDED BY ANY BUILD, UNTESTED on mainline.
+ *
+ * The two USB controllers as the STOCK vendor DTB describes them, restated in mainline imx6ull.dtsi
+ * labels. Source: the FDT the vendor U-Boot hands the 3.14 kernel, at offset 0x800 of the decrypted
+ * update env (mtd0+0x20000; norboot "cp 0x80800800 0x83000000 0xf800"), 33,027 B, decompiled with
+ * dtc. Extract it from a unit's own mtd0 dump with the read_env() of tools/stage_kernel.py; the stock
+ * DTB itself is not copied into this repo.
+ *
+ * Stock: both "fsl,imx6ul-usb", "fsl,imx27-usb", status okay, dr_mode "otg", disable-over-current,
+ * no vbus-supply, no pinctrl-0; PHYs usbphy@020c9000 / @020ca000 ("fsl,imx6ul-usbphy",
+ * phy-3p0-supply = the anatop 3p0 regulator); usbmisc index 0 / 1. /regulators holds only "can-3v3"
+ * (on the 74hc595 gpio_spi expander) and "wlreg_on" (GPIO1_IO05, enable-active-low, for bcmdhd):
+ * no VBUS regulator, no USB pinctrl group, OTG1_ID not muxed. The QSPI flash node is
+ * "micronix,mx25l12805d" without partitions (those came from the mtdparts= the vendor bootargs pass).
+ *
+ * Mainline differences that matter: mainline imx6ul.dtsi already carries the PHY, usbmisc and anatop
+ * links, so only the board properties remain. "otg" on usbotg1 would make it a SECOND UDC next to
+ * usbotg2 whenever the kernel has CHIPIDEA_UDC (and needs the ID pin, which the stock DT does not mux);
+ * the baseline therefore uses "host" there (imx6ull-ccpa-usbhost.dtsi) and LIVI's "peripheral" on usbotg2.
+ */
+&usbotg1 {
+	dr_mode = "otg";
+	disable-over-current;
+	status = "okay";
+};
+
+&usbotg2 {
+	dr_mode = "otg";
+	disable-over-current;
+	status = "okay";
+};
diff --git a/baseline/arm-imx6ul-u2ac/initramfs/flash-kernel b/baseline/arm-imx6ul-u2ac/initramfs/flash-kernel
new file mode 100755
index 0000000..02c7394
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/initramfs/flash-kernel
@@ -0,0 +1,145 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+# Modified 2026-10-19/20: the changes against LIVI are stated in this header.
+# Flow derived from LIVI install() (native/livi-link/crates/livi-link-provision/src/dongle/arm/imx6ul/
+# boot.rs, GPL-3.0-or-later): write the staged kernel partition, read it back, erase only the env
+# block, check U-Boot itself is unchanged, reboot so U-Boot converts the staged head. Changes: runs on
+# the unit; the image is staged on the HOST (tools/stage_kernel.py) because the fuse-derived key never
+# has to reach this script; refuses without the caller's sha256 and refuses an image whose first
+# 192 KiB differ from this unit's partition (staged from a stale dump or another unit) unless
+# --restore; recognises an image that is already installed; erases the 'env' MTD of our DT instead of
+# a byte range of 'uboot'.
+#
+#   flash-kernel [--restore] [--if-changed] [--dry-run] <partition-image|host:port> <sha256>
+#
+#   --restore     the image is a raw dump of THIS unit's kernel partition (e.g. backup mtd1.bin);
+#                 skips the head check, which a raw backup of another kernel cannot pass
+#   --if-changed  do nothing at all (no env erase, no reboot) if the partition already holds it
+#   --dry-run     every check, then say what would be written; writes and erases nothing
+#   NO_REBOOT=1   stop after the env erase instead of rebooting
+#   exit status   0 written (or would write), 3 nothing to do, 4 refused (nothing written),
+#                 1 failed after the write started; see flash-lib.sh
+#
+# "Already installed" (exit 3, nothing written): everything after the first 192 KiB of the partition
+# equals the image, only the head differs. That is what a successful install leaves: U-Boot's
+# heweiencrypt rewrites exactly the three head blocks from the staged ones and touches nothing else, so
+# a stick or file staged BEFORE the install no longer matches the head but is not stale.
+#
+# Layout constants (board.env): the staged head is looked for at partition offset STAGING_PART_OFFSET
+# = 0x302fd8, the kernel_len of the U-Boot env on the units read so far (2025.10.15.1127 build). Other
+# vendor builds differ (2025.02.25.1521: 0x303080, CPC200-CCPA_resources
+# documentation/05_Security_Analysis/kernel_encryption.md). The check here only asks "is anything
+# staged near there", which a staging at 0x303080 still answers; stage_kernel.py reads the unit's own
+# kernel_len and staging offset from its update env and refuses an image that does not fit them.
+#
+# NOT RECOVERABLE FROM HERE: this recovery lives inside the kernel partition it writes. A power loss
+# between the start of the write and the end of the env erase leaves the old encrypted head in front
+# of the new body: U-Boot has no bootable kernel, there is no USB, and only an SPI programmer
+# (full_16MB_for_programmer.bin of this unit) brings it back. A FAILED write with power still on is
+# recoverable: this recovery keeps running from RAM, so retry, or --restore a backup.
+ME=flash-kernel
+LOG=/run/flash-kernel.log
+. /lib/baseline/mtd.sh
+. /lib/baseline/flash-lib.sh
+. /etc/baseline/board.env
+
+restore=
+if_changed=
+dry=
+while :; do
+    case ${1:-} in
+        --restore) restore=1; shift ;;
+        --if-changed) if_changed=1; shift ;;
+        --dry-run) dry=1; shift ;;
+        *) break ;;
+    esac
+done
+[ $# -eq 2 ] || { echo "usage: $ME [--restore] [--if-changed] [--dry-run] <partition-image|host:port> <sha256>" >&2; exit 2; }
+valid_sha "$2" || die "the second argument must be the image's sha256 (64 lowercase hex)"
+WANT=$2
+
+K=$(mtd_num kernel) || die "no 'kernel' MTD partition"
+E=$(mtd_num env) || die "no 'env' MTD partition (not our DT; the vendor map keeps env inside 'uboot')"
+U=$(mtd_num uboot) || die "no 'uboot' MTD partition"
+[ "$(mtd_attr "$K" size)" = "$KERNEL_PART_SIZE" ] || die "'kernel' is $(mtd_attr "$K" size) B, not $KERNEL_PART_SIZE"
+[ "$(mtd_attr "$E" size)" = "$ERASE_SIZE" ] || die "'env' is $(mtd_attr "$E" size) B, not one $ERASE_SIZE B block"
+for m in "$K" "$E"; do
+    [ "$(mtd_attr "$m" erasesize)" = "$ERASE_SIZE" ] || die "mtd$m erase size is $(mtd_attr "$m" erasesize), not $ERASE_SIZE"
+done
+# The env erase must hit flash 0x30000 and nothing else.
+[ "$(mtd_attr "$E" offset)" = "$ENV_FLASH_OFFSET" ] || die "'env' is not at flash offset $ENV_FLASH_OFFSET (sysfs offset: $(mtd_attr "$E" offset))"
+[ "$(mtd_attr "$K" offset)" = "$KERNEL_FLASH_OFFSET" ] || die "'kernel' is not at flash offset $KERNEL_FLASH_OFFSET"
+KD=$MTD_DEV/mtd$K
+ED=$MTD_DEV/mtd$E
+UD=$MTD_DEV/mtd$U
+
+IMG=$(fetch "$1" /tmp/kernel-part.img) || die "cannot read $1 (a file, or host:port of a one-shot server)"
+SIZE=$(fsize "$IMG")
+[ "$SIZE" = "$KERNEL_PART_SIZE" ] || die "image is $SIZE B; a staged partition image is exactly $KERNEL_PART_SIZE B"
+GOT=$(sha_file "$IMG")
+[ "$GOT" = "$WANT" ] || die "image sha256 is $GOT, not $WANT"
+
+BLOCKS=$((KERNEL_PART_SIZE / ERASE_SIZE))
+NOW=$(sha_file "$KD")
+if [ "$NOW" != "$WANT" ] && [ -z "$restore" ]; then
+    IH=$(dd if="$IMG" bs="$ERASE_SIZE" count=3 2>/dev/null | sha_stdin)
+    CH=$(dd if="$KD" bs="$ERASE_SIZE" count=3 2>/dev/null | sha_stdin)
+    if [ "$IH" != "$CH" ]; then
+        IT=$(dd if="$IMG" bs="$ERASE_SIZE" skip=3 count=$((BLOCKS - 3)) 2>/dev/null | sha_stdin)
+        CT=$(dd if="$KD" bs="$ERASE_SIZE" skip=3 count=$((BLOCKS - 3)) 2>/dev/null | sha_stdin)
+        if [ "$IT" = "$CT" ]; then
+            say "mtd$K already runs this kernel: all but the first 192 KiB match, the head differs only by U-Boot's conversion of the staged head. Nothing written, env untouched."
+            [ "$IMG" = /tmp/kernel-part.img ] && rm -f /tmp/kernel-part.img
+            exit 3
+        fi
+        die "the image's first 192 KiB differ from this unit's kernel partition, and so does the rest: it was staged from another dump or for another unit. Dump this partition again and re-stage it, or use --restore for a raw backup of THIS unit"
+    fi
+fi
+# The staged head U-Boot converts after the env erase. Erased flash there would be "converted" into a
+# garbage head. (Probe offset: see "Layout constants" above.)
+SH=$(dd if="$IMG" bs=8 skip=$((STAGING_PART_OFFSET / 8)) count=$((3 * ERASE_SIZE / 8)) 2>/dev/null | sha_stdin)
+[ "$SH" != "$ERASED_HEAD_SHA256" ] || die "the image has no staged head at partition offset $STAGING_PART_OFFSET; erasing env now would brick the unit"
+
+if [ -n "$dry" ]; then
+    if [ "$NOW" = "$WANT" ]; then
+        say "dry run: mtd$K already holds this image; would $([ -n "$if_changed" ] && echo 'do nothing (exit 3)' || echo 'erase env and reboot')"
+        [ -n "$if_changed" ] && exit 3
+    else
+        say "dry run: would write $SIZE B to mtd$K, verify, erase env (mtd$E), check uboot (mtd$U), $([ -n "$NO_REBOOT" ] && echo 'stop' || echo 'reboot')"
+    fi
+    exit 0
+fi
+
+UB_BEFORE=$(sha_file "$UD")
+if [ "$NOW" = "$WANT" ]; then
+    say "mtd$K already holds this image"
+    [ -n "$if_changed" ] && exit 3
+    started
+else
+    started
+    say "writing mtd$K (log $LOG). From now until the env erase completes, a power loss needs an SPI programmer"
+    flashcp -v "$IMG" "$KD" >> "$LOG" 2>&1 || die "flashcp failed (see $LOG). DO NOT REBOOT OR POWER OFF: retry $ME with the same image, or $ME --restore <backup> <sha256>"
+    sync
+    NOW=$(sha_file "$KD")
+    [ "$NOW" = "$WANT" ] || die "mtd$K does not read back as written ($NOW). DO NOT REBOOT OR POWER OFF: retry $ME"
+    say "wrote and verified mtd$K"
+fi
+
+# Erasing the env block is what makes U-Boot run heweiencrypt on the next boot. Done even when the
+# image was already there: a previous run may have stopped between the write and this step.
+flash_eraseall -q "$ED" >> "$LOG" 2>&1 || die "erasing mtd$E failed. DO NOT REBOOT: retry 'flash_eraseall -q $ED'"
+sync
+[ "$(sha_file "$ED")" = "$ERASED_BLOCK_SHA256" ] || die "mtd$E did not erase. DO NOT REBOOT: retry 'flash_eraseall -q $ED'"
+[ "$(sha_file "$UD")" = "$UB_BEFORE" ] || die "the uboot partition changed although only env was erased. DO NOT REBOOT; compare it with your backup"
+say "env erased, U-Boot unchanged"
+[ "$IMG" = /tmp/kernel-part.img ] && rm -f /tmp/kernel-part.img
+finished
+if [ -n "${NO_REBOOT:-}" ]; then
+    say "NO_REBOOT set: reboot when ready (U-Boot converts the staged head, rewrites env, resets once more)"
+    exit 0
+fi
+say "rebooting: U-Boot converts the staged head, rewrites its env and resets once more"
+sync
+sleep 1
+exec /bin/busybox reboot -f
diff --git a/baseline/arm-imx6ul-u2ac/initramfs/flash-lib.sh b/baseline/arm-imx6ul-u2ac/initramfs/flash-lib.sh
new file mode 100644
index 0000000..80f4b00
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/initramfs/flash-lib.sh
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+# Modified 2026-10-19/20: the readback and erase steps are shell functions shared by the on-unit
+# flash helpers.
+# Shared by flash-rootfs and flash-kernel (installed as /lib/baseline/flash-lib.sh in the recovery
+# initramfs). The verify-by-readback (dd | sha256sum) and erase-only-after-verify steps follow LIVI's
+# provisioner (native/livi-link/crates/livi-link-provision/src/dongle/arm/imx6ul/boot.rs, GPL-3.0-or-later).
+#
+# Exit status of both helpers (usb-update and the self-test rely on it):
+#   0  written and verified (flash-kernel: env erased too)
+#   2  usage
+#   3  nothing to do: the partition already holds the image (with --if-changed), or flash-kernel found
+#      this kernel already installed (U-Boot converted its staged head); nothing was written
+#   4  refused before anything was written (wrong sha256, size, magic, layout, stale or foreign image):
+#      flash is untouched, powering off is safe
+#   1  failed AFTER the write started: read the message (flash-kernel: DO NOT POWER OFF)
+# LED (red): fast blink while a write runs, back to the recovery blink when done, solid on after a
+# failure that happened after the write started.
+
+# Long writes are started from telnet/ssh sessions; a closed session must not SIGHUP flashcp (RUNBOOK
+# 2026-10-19: a flashcp was killed mid-write that way). SIG_IGN is inherited across exec.
+trap '' HUP PIPE
+
+STARTED=
+LEDR=${LED_RED:-/sys/class/leds/red}
+
+led() { # led timer ON OFF | led solid
+    [ -w "$LEDR/trigger" ] || return 0
+    if [ "$1" = solid ]; then
+        echo none > "$LEDR/trigger"
+        echo 1 > "$LEDR/brightness"
+    else
+        echo timer > "$LEDR/trigger"
+        echo "$2" > "$LEDR/delay_on"
+        echo "$3" > "$LEDR/delay_off"
+    fi
+} 2>/dev/null
+
+say() { echo "$ME: $*"; echo "$ME: $*" >> "$LOG"; }
+die() {
+    if [ -n "$STARTED" ]; then
+        echo "$ME: $*" >&2
+        echo "$ME: FAILED: $*" >> "$LOG"
+        led solid
+        exit 1
+    fi
+    echo "$ME: $* (nothing written)" >&2
+    echo "$ME: REFUSED: $* (nothing written)" >> "$LOG"
+    exit 4
+}
+# started: from here on a failure is a failed write, not a refusal.
+started() { STARTED=1; led timer 100 100; }
+finished() { led timer 500 500; }
+
+valid_sha() {
+    [ "${#1}" -eq 64 ] || return 1
+    case $1 in *[!0-9a-f]*) return 1 ;; esac
+    return 0
+}
+
+sha_file() {
+    # shellcheck disable=SC2046
+    set -- $(sha256sum "$1" 2>/dev/null)
+    echo "$1"
+}
+
+sha_stdin() {
+    # shellcheck disable=SC2046
+    set -- $(sha256sum)
+    echo "$1"
+}
+
+fsize() { echo $(($(wc -c < "$1"))); }
+
+mounted() {
+    while read -r _dev _mnt _rest; do
+        [ "$_dev" = "$1" ] && return 0
+    done < /proc/mounts
+    return 1
+}
+
+# fetch SRC DEST: SRC is a local file (used in place, e.g. /mnt/usb/rootfs.img) or host:port, which is
+# PULLED with nc into DEST. Pull, not push: on 2026-10-19 four macOS nc pushes into busybox nc over NCM
+# failed (the first left 146,432 B), while a pull from a host-side Python server did not (RUNBOOK).
+fetch() {
+    if [ -f "$1" ]; then
+        echo "$1"
+        return 0
+    fi
+    case $1 in
+        *:*)
+            _h=${1%:*}
+            _p=${1##*:}
+            case $_p in "" | *[!0-9]*) return 1 ;; esac
+            say "pulling $_h:$_p into $2" >&2
+            rm -f "$2"
+            nc "$_h" "$_p" > "$2" || { rm -f "$2"; return 1; }
+            echo "$2"
+            return 0
+            ;;
+    esac
+    return 1
+}
diff --git a/baseline/arm-imx6ul-u2ac/initramfs/flash-rootfs b/baseline/arm-imx6ul-u2ac/initramfs/flash-rootfs
new file mode 100755
index 0000000..7f1218a
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/initramfs/flash-rootfs
@@ -0,0 +1,61 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+# Modified 2026-10-19/20: the changes against LIVI are stated in this header.
+# Flow derived from LIVI write_rootfs() (native/livi-link/crates/livi-link-provision/src/dongle/arm/
+# imx6ul/boot.rs, GPL-3.0-or-later): size and 4 KiB checks, flashcp, read back with dd | sha256sum,
+# clear bootstate. Changes: runs on the unit (recovery) instead of from the host, refuses without the
+# caller's sha256, sets the bootstate mark for the duration of the write, --if-changed for usb-update.
+#
+#   flash-rootfs [--if-changed] <image|host:port> <sha256>
+#   (--if-changed: exit 3, touching nothing, if the partition already holds the image)
+#   image: a file (e.g. /mnt/usb/rootfs.img from a stick, or one copied in with scp/sftp) or host:port
+#   exit: 0 written, 3 nothing to do, 4 refused (nothing written), 1 the write failed (repairable:
+#   retry); see flash-lib.sh
+#
+# Writes a baseline rootfs squashfs to the 'rootfs' MTD. Never reboots. An interrupted write is
+# repairable: the kernel and this recovery are on another partition, and the bootstate mark set
+# before the write keeps the next boot in recovery until a verified write clears it.
+ME=flash-rootfs
+LOG=/run/flash-rootfs.log
+. /lib/baseline/mtd.sh
+. /lib/baseline/flash-lib.sh
+
+if_changed=
+[ "$1" = --if-changed ] && { if_changed=1; shift; }
+[ $# -eq 2 ] || { echo "usage: $ME [--if-changed] <image|host:port> <sha256>" >&2; exit 2; }
+valid_sha "$2" || die "the second argument must be the image's sha256 (64 lowercase hex)"
+WANT=$2
+
+N=$(mtd_num rootfs) || die "no 'rootfs' MTD partition"
+mounted "/dev/mtdblock$N" && die "/dev/mtdblock$N is mounted; flash it from recovery"
+M=$MTD_DEV/mtd$N
+PART=$(mtd_attr "$N" size)
+
+IMG=$(fetch "$1" /tmp/rootfs.img) || die "cannot read $1 (a file, or host:port of a one-shot server)"
+SIZE=$(fsize "$IMG")
+[ "$SIZE" -gt 0 ] && [ "$SIZE" -le "$PART" ] || die "image is $SIZE B, the partition $PART B"
+[ $((SIZE % 4096)) -eq 0 ] || die "image is $SIZE B, not a whole number of 4 KiB blocks"
+[ "$(hexdump -n 4 -e '4/1 "%02x"' "$IMG")" = 68737173 ] || die "image does not start with the squashfs magic hsqs"
+GOT=$(sha_file "$IMG")
+[ "$GOT" = "$WANT" ] || die "image sha256 is $GOT, not $WANT; nothing written"
+
+NOW=$(dd if="$M" bs=4096 count=$((SIZE / 4096)) 2>/dev/null | sha_stdin)
+if [ "$NOW" = "$WANT" ]; then
+    say "mtd$N already holds this image"
+    [ -n "$if_changed" ] && exit 3
+else
+    started
+    S=$(mtd_num bootstate) && { bootstate_set "$S" || say "could not set the bootstate mark"; }
+    say "writing $SIZE B to mtd$N (log $LOG); an interruption here is repairable from recovery"
+    flashcp -v "$IMG" "$M" >> "$LOG" 2>&1 || die "flashcp failed (see $LOG); retry flash-rootfs"
+    sync
+    NOW=$(dd if="$M" bs=4096 count=$((SIZE / 4096)) 2>/dev/null | sha_stdin)
+    [ "$NOW" = "$WANT" ] || die "mtd$N does not read back as written ($NOW); retry flash-rootfs"
+    say "wrote and verified mtd$N"
+fi
+S=$(mtd_num bootstate) && bootstate_clear "$S" && say "bootstate cleared"
+[ "$IMG" = /tmp/rootfs.img ] && rm -f /tmp/rootfs.img
+finished
+say "done; 'reboot' boots the new rootfs"
+exit 0
diff --git a/baseline/arm-imx6ul-u2ac/initramfs/init b/baseline/arm-imx6ul-u2ac/initramfs/init
new file mode 100755
index 0000000..fe5ad00
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/initramfs/init
@@ -0,0 +1,138 @@
+#!/bin/busybox sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
+# Modified 2026-10-19/20: the changes against LIVI are stated in this header.
+# Derived from LIVI scripts/livi-link/common/initramfs/init (https://github.com/f-io/LIVI,
+# GPL-3.0-or-later). Changes against LIVI: no bridge, no Wi-Fi AP, no second telnetd; telnetd and
+# dropbear are bound to the NCM address only; the rootfs is taken over only if it carries
+# /etc/baseline-release; the rootfs sets its own gadget up (no LINK_ONLY hand-over); /run is a tmpfs
+# moved into the rootfs; PID 1 never execs the UART shell (an `exit` there would kill init and panic the
+# kernel), it respawns it; a last, quiet, one-shot USB step (RECOVERY_USB=1 builds, the default).
+#
+# PID 1 of the recovery initramfs built into the kernel image. Order:
+#   1. pseudo filesystems, chip identity (/run/ocbm)
+#   2. take over the squashfs on the 'rootfs' MTD if it is a baseline rootfs, the 'bootstate' marker
+#      is clear and nobody presses Enter on the UART within 1 s; else stay here:
+#   3. UART shell (respawned) + NCM: 192.168.50.2, DHCP for the host, telnetd on 192.168.50.2:23
+#      (unauthenticated, rescue only) and [RECOVERY_SSH=1] dropbear on 192.168.50.2:22 (root, public
+#      key or password; host key and keys READ from the rootfs's persist archive on 'customer', else an
+#      ephemeral host key; recovery never writes 'customer'), then [RECOVERY_USB=1] in the background
+#      usb-update: one scan for a USB stick (at most 20 s), mounted read-write at /mnt/usb, and the
+#      ccpa-baseline/ bundle on it flashed if it differs from flash. A stick plugged in later: usb-mount.
+/bin/busybox --install -s
+mount -t proc proc /proc
+mount -t sysfs sysfs /sys
+mount -t devtmpfs devtmpfs /dev
+mkdir -p /dev/pts /run /tmp /mnt/root /var
+mount -t devpts devpts /dev/pts
+mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
+mount -t configfs configfs /sys/kernel/config
+[ -e /var/run ] || ln -s /run /var/run
+# No modules in here: the kernel must not exec a modprobe helper that does not exist. This sysctl is
+# global and survives switch_root; the rootfs /init writes /sbin/modprobe back.
+[ -w /proc/sys/kernel/modprobe ] && echo > /proc/sys/kernel/modprobe
+
+. /etc/baseline/board.env
+. /etc/baseline/ncm.conf
+. /lib/baseline/mtd.sh
+con() { echo "$*" > /dev/console; }
+REL=$(cat /etc/baseline-release 2>/dev/null)
+con "$BOARD_NAME recovery initramfs $REL"
+ocbm-identity 2> /dev/console || con "recovery: no chip identity, the USB serial falls back to a placeholder"
+
+ROOT_N=$(mtd_num rootfs)
+STATE_N=$(mtd_num bootstate)
+# boot slots: "<used> <fails> <request>", parsed with the shell (the recovery busybox has no cut)
+BS_FAIL=0 BS_REQ=0
+if [ -n "$STATE_N" ]; then
+    _bs=$(bootslot_scan "$STATE_N")
+    BS_REQ=${_bs##* }; _bs=${_bs#* }; BS_FAIL=${_bs%% *}
+    case $BS_FAIL in '' | *[!0-9]*) BS_FAIL=0 ;; esac
+fi
+why=
+if [ -z "$ROOT_N" ]; then
+    why="no 'rootfs' MTD partition"
+elif ! mount -t squashfs -o ro "/dev/mtdblock$ROOT_N" /mnt/root 2>/dev/null; then
+    why="'rootfs' (mtd$ROOT_N) holds no squashfs"
+elif [ ! -f /mnt/root/etc/baseline-release ] || [ ! -x /mnt/root/init ] || [ ! -x /mnt/root/sbin/init ]; then
+    # A stock or LIVI rootfs also has an /init; its userspace must not run on this kernel.
+    umount /mnt/root
+    why="the squashfs on mtd$ROOT_N is not a baseline rootfs"
+elif [ -n "$STATE_N" ] && [ "$(bootstate_read "$STATE_N")" = "$BOOT_MARK_HEX" ]; then
+    umount /mnt/root
+    why="a rootfs write did not finish (flash-rootfs mark set; rewrite the rootfs, or flash_eraseall -q /dev/mtd$STATE_N)"
+elif [ "$BS_REQ" = 1 ]; then
+    umount /mnt/root
+    # reboot-recovery (web UI / ssh): served once, the next boot tries the rootfs again
+    bootslot_visit "$STATE_N" || con "recovery: could not record the recovery visit in mtd$STATE_N"
+    why="recovery was requested (reboot-recovery); the next boot tries the rootfs again"
+elif [ "$BS_FAIL" -ge "$BOOTSLOT_MAXFAIL" ]; then
+    umount /mnt/root
+    # one recovery visit, recorded, then the next boot tries the rootfs again
+    bootslot_visit "$STATE_N" || con "recovery: could not record the recovery visit in mtd$STATE_N"
+    why="$BOOTSLOT_MAXFAIL rootfs boots in a row did not come up (the next boot tries the rootfs again)"
+else
+    # Whatever reached the UART before the question is no answer to it (LIVI: a UART that hears its
+    # own output has the boot loader's lines waiting there).
+    stty -F /dev/console -icanon min 0 time 0 && cat /dev/console > /dev/null
+    stty -F /dev/console icanon
+    con "rootfs $(cat /mnt/root/etc/baseline-release) on mtd$ROOT_N, switching in 0.2 s, Enter on the UART for recovery"
+    # 0.2 s (needs busybox FEATURE_SH_READ_FRAC): a Pi on the UART sends Enter repeatedly during boot instead
+    if read -t 0.2 _ < /dev/console; then
+        umount /mnt/root
+        why="Enter on the UART"
+    else
+        if [ -n "$STATE_N" ]; then
+            # rcS marks THIS slot as came-up (by index: a reboot-recovery request appended later is not touched)
+            bootslot_attempt "$STATE_N" && echo "$BOOTSLOT_IDX" > /run/bootslot \
+                || con "recovery: could not record the boot attempt, no boot-loop guard for this boot"
+        else
+            con "recovery: no 'bootstate' MTD, no boot-loop guard for this boot"
+        fi
+        mount -o move /dev /mnt/root/dev
+        mount -o move /run /mnt/root/run
+        # If this exec fails PID 1 dies, the kernel panics (panic=10 in bootargs) and reboots, and the
+        # attempt just recorded counts as a failed boot.
+        exec switch_root /mnt/root /init
+    fi
+fi
+
+con "recovery: $why"
+[ -e /sys/class/leds/red/trigger ] && echo timer > /sys/class/leds/red/trigger
+ifconfig lo 127.0.0.1 up
+umask 077
+# /run/ocbm may be missing when ocbm-identity failed early; the banner (and telnetd -f) need it.
+mkdir -p /run/ocbm /run/log
+# Read-only: SSH host key, keys and a changed root password from the rootfs's archive on 'customer'.
+[ -x /usr/sbin/dropbear ] && persist load > /run/log/persist.log 2>&1
+ocbm-banner "recovery: $why" > /run/ocbm/banner 2>/dev/null
+umask 022
+
+# NCM: link, address, DHCP, then telnetd and dropbear bound to the NCM address only. Background, so a
+# slow or missing UDC never delays the UART shell.
+(
+    if IF=$(net-up ncm 2> /dev/console); then
+        if telnetd -b "$NCM_DEV_IP:23" -l /bin/sh -f /run/ocbm/banner; then
+            con "recovery: NCM shell on $IF: telnet $NCM_DEV_IP (unauthenticated, rescue only)"
+        else
+            con "recovery: telnetd failed"
+        fi
+        if [ -x /usr/sbin/dropbear ]; then
+            if ssh-up "$NCM_DEV_IP" 2> /run/log/ssh-up.log; then
+                con "recovery: ssh/scp/sftp root@$NCM_DEV_IP (key or password)"
+            else
+                con "recovery: ssh did not start (/run/log/ssh-up.log, /run/log/dropbear.log); telnet is up"
+            fi
+        fi
+    fi
+) &
+
+# Last, quiet, bounded; logs to /run/usb-update.log only.
+[ -e /etc/baseline/recovery-usb ] && ( usb-update > /dev/null 2>&1 & )
+
+cat /run/ocbm/banner > /dev/console 2>/dev/null
+# PID 1 stays this script: the UART shell is respawned, never exec'd.
+while :; do
+    setsid cttyhack sh
+    sleep 1
+done
diff --git a/baseline/arm-imx6ul-u2ac/initramfs/reboot b/baseline/arm-imx6ul-u2ac/initramfs/reboot
new file mode 100755
index 0000000..5128838
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/initramfs/reboot
@@ -0,0 +1,7 @@
+#!/bin/busybox sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# reboot for the recovery initramfs. busybox `reboot` without -f signals PID 1, and PID 1 here is the
+# init script, which ignores it, so a plain `reboot` would silently do nothing. Shipped as a file in
+# the cpio so `busybox --install -s` (which never replaces an existing file) leaves it in place.
+sync
+exec /bin/busybox reboot -f
diff --git a/baseline/arm-imx6ul-u2ac/initramfs/usb-update b/baseline/arm-imx6ul-u2ac/initramfs/usb-update
new file mode 100755
index 0000000..c504290
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/initramfs/usb-update
@@ -0,0 +1,64 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# usb-update: the last step of the recovery init in RECOVERY_USB=1 builds (the default). One-shot,
+# bounded and quiet: it logs to /run/usb-update.log, writes to the console only when it is about to
+# write flash or a started write failed, and never touches the UART, telnet or SSH shells.
+#
+#   1. usb-mount --wait 20: the first FAT32/exFAT data partition of a USB stick (the EFI System
+#      Partition is skipped), mounted READ-WRITE at /mnt/usb and left mounted for the shells
+#      (`flash-rootfs /mnt/usb/rootfs.img <sha256>`; `usb-mount -u` before pulling the stick).
+#      A stick plugged in later is not seen: run `usb-mount` (no resident poller in recovery).
+#   2. If the stick carries a bundle
+#        ccpa-baseline/rootfs.img        + ccpa-baseline/rootfs.img.sha256       (sha256sum format)
+#        ccpa-baseline/kernel-part.img   + ccpa-baseline/kernel-part.img.sha256  (stage_kernel.py output,
+#                                                                                 staged for THIS unit)
+#      the same helpers a shell would use run with --if-changed: rootfs first, the kernel only if the
+#      rootfs step did not fail. An image already on flash (exit 3: the same bytes, or for the kernel
+#      "already installed", i.e. U-Boot converted its staged head) and an image the helper refuses
+#      (exit 4: nothing written) are logged only, so a stick left plugged in neither loops nor alarms.
+#      It reboots only if it wrote something (after unmounting the stick).
+LOG=/run/usb-update.log
+exec >> "$LOG" 2>&1 < /dev/null
+trap '' HUP PIPE
+con() { echo "usb-update: $*" > /dev/console; echo "usb-update: $*"; }
+echo "usb-update: start $(cat /proc/uptime)"
+
+usb-mount --wait "${USB_UPDATE_WAIT:-20}" || { echo "usb-update: no USB stick mounted"; exit 0; }
+B=/mnt/usb/ccpa-baseline
+[ -d "$B" ] || { echo "usb-update: no ccpa-baseline/ bundle on the stick; /mnt/usb stays mounted"; exit 0; }
+echo "usb-update: bundle at $B"
+
+hash_of() { [ -r "$1" ] && read -r _h _rest < "$1" && echo "$_h"; }
+wrote=
+
+if [ -f "$B/rootfs.img" ]; then
+    h=$(hash_of "$B/rootfs.img.sha256") || { echo "usb-update: rootfs.img without rootfs.img.sha256, skipped"; exit 0; }
+    flash-rootfs --if-changed "$B/rootfs.img" "$h"
+    case $? in
+        0) wrote=1; con "rootfs written from USB" ;;
+        3) echo "usb-update: rootfs already on flash" ;;
+        4) echo "usb-update: rootfs.img refused (nothing written; /run/flash-rootfs.log); kernel step skipped"; exit 0 ;;
+        *) con "rootfs write from USB failed (/run/flash-rootfs.log); repairable: retry flash-rootfs. Kernel step skipped"; exit 0 ;;
+    esac
+fi
+
+if [ -f "$B/kernel-part.img" ]; then
+    h=$(hash_of "$B/kernel-part.img.sha256") || { echo "usb-update: kernel-part.img without .sha256, skipped"; exit 0; }
+    NO_REBOOT=1 flash-kernel --if-changed "$B/kernel-part.img" "$h"
+    case $? in
+        0) wrote=1; con "kernel written from USB" ;;
+        3) echo "usb-update: kernel already on flash or already installed" ;;
+        4) echo "usb-update: kernel-part.img refused (nothing written; /run/flash-kernel.log): stale, or staged for another unit" ;;
+        *) con "kernel write from USB FAILED after it started (/run/flash-kernel.log). DO NOT POWER OFF until it is fixed"; exit 0 ;;
+    esac
+fi
+
+if [ -n "$wrote" ]; then
+    usb-mount -u
+    con "rebooting in 5 s"
+    sync
+    sleep 5
+    exec /bin/busybox reboot -f
+fi
+echo "usb-update: nothing written; /mnt/usb stays mounted"
+exit 0
