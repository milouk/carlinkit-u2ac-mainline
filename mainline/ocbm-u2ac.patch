diff --git a/baseline/arm-imx6ul-u2ac/modules/u2ac-qspi-boost/u2ac-qspi-boost.c b/baseline/arm-imx6ul-u2ac/modules/u2ac-qspi-boost/u2ac-qspi-boost.c
new file mode 100644
index 0000000..9ddbc40
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/modules/u2ac-qspi-boost/u2ac-qspi-boost.c
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * u2ac-qspi-boost: the NOR's bus clock at 49.5 MHz while it is loaded (u2ac-aa loads it at the start of the
+ * boot and removes it when the boot's reads are done). The device tree asks fsl-qspi for 29 MHz, which the
+ * imx6ul clock tree gives as 24.75 MHz (99 MHz / 4): the boot reads the rootfs at ~2.3 MB/s.
+ *
+ * On imx6ul fsl-qspi runs the controller at 4x the bus rate and re-applies spi->max_speed_hz only when the
+ * chip select changes (one NOR here), so a rate set on its "qspi" clock holds for every following transfer.
+ * Unloading restores the old rate.
+ *
+ * Measured on the unit (2026-11-28): the NOR has SFDP rev 1.06 (MX25L12835F/45G class, not the SFDP-less
+ * MX25L12805D its ID also matches), so READ (0x03, what spi-nor uses without m25p,fast-read) is rated to
+ * 50 MHz and page program higher. At 49.5 MHz: 3 full reads of rootfs + kernel, all checksums equal to the
+ * flashed images, no errors; rootfs read 4.73 s -> 2.87 s.
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/clk.h>
+#include <linux/device.h>
+
+static unsigned long bus_hz = 49500000;
+module_param(bus_hz, ulong, 0444);
+MODULE_PARM_DESC(bus_hz, "QSPI bus clock while loaded (the controller runs at 4x)");
+
+static struct clk *qclk;
+static unsigned long old_rate;
+
+static int __init boost_init(void)
+{
+	struct device *dev = bus_find_device_by_name(&platform_bus_type, NULL, "21e0000.spi");
+	int ret;
+
+	if (bus_hz > 50000000)
+		return -EINVAL;   /* the NOR's READ limit */
+	if (!dev)
+		return -ENODEV;
+	qclk = clk_get(dev, "qspi");
+	put_device(dev);
+	if (IS_ERR(qclk))
+		return PTR_ERR(qclk);
+	old_rate = clk_get_rate(qclk);
+	ret = clk_set_rate(qclk, bus_hz * 4);
+	if (ret) {
+		clk_put(qclk);
+		return ret;
+	}
+	pr_info("u2ac-qspi-boost: NOR bus %lu -> %lu Hz\n", old_rate / 4, clk_get_rate(qclk) / 4);
+	return 0;
+}
+
+static void __exit boost_exit(void)
+{
+	clk_set_rate(qclk, old_rate);
+	pr_info("u2ac-qspi-boost: NOR bus back to %lu Hz\n", clk_get_rate(qclk) / 4);
+	clk_put(qclk);
+}
+
+module_init(boost_init);
+module_exit(boost_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("U2AC: faster NOR reads during the boot");
diff --git a/baseline/arm-imx6ul-u2ac/modules/u2ac-ws2812/Kbuild b/baseline/arm-imx6ul-u2ac/modules/u2ac-ws2812/Kbuild
new file mode 100644
index 0000000..22d8e05
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/modules/u2ac-ws2812/Kbuild
@@ -0,0 +1 @@
