diff --git a/baseline/arm-imx6ul-u2ac/patches/0007-hci-bcm-force-early-baud-option.patch b/baseline/arm-imx6ul-u2ac/patches/0007-hci-bcm-force-early-baud-option.patch
new file mode 100644
index 0000000..1ebc6b0
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/patches/0007-hci-bcm-force-early-baud-option.patch
@@ -0,0 +1,35 @@
+From: milouk
+Subject: [PATCH] Bluetooth: hci_bcm: module option to override no_early_set_baudrate
+
+The U2AC BCM4358A3 is driven through the brcm,bcm43540-bt match, whose no_early_set_baudrate quirk keeps
+the patch download at 115200 (~4.8 s). hci_uart.bcm_force_early_baud=1 lets the operational speed be set
+before setup() so the download runs at max-speed (3 Mbaud); default off, behaviour unchanged.
+
+---
+diff -ruN a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
+--- a/drivers/bluetooth/hci_bcm.c	2026-11-26 09:32:25.558940840 +0000
++++ b/drivers/bluetooth/hci_bcm.c	2026-11-26 09:32:25.564583132 +0000
+@@ -49,6 +49,14 @@
+ 
+ #define BCM_NUM_SUPPLIES 2
+ 
++/* U2AC: the BCM4358A3 (4354 family) is matched as brcm,bcm43540-bt, whose quirk keeps the firmware
++ * download at the 115200 init speed (~4.8 s for a 55 KB patch). Let it be tried at the operational speed
++ * (set before setup(), as for chips without the quirk) without a DT change: hci_uart.bcm_force_early_baud=1.
++ */
++static bool bcm_force_early_baud;
++module_param(bcm_force_early_baud, bool, 0444);
++MODULE_PARM_DESC(bcm_force_early_baud, "Ignore no_early_set_baudrate (download the patch at max-speed)");
++
+ /**
+  * struct bcm_device_data - device specific data
+  * @no_early_set_baudrate: Disallow set baudrate before driver setup()
+@@ -1547,7 +1555,7 @@
+ 	data = device_get_match_data(bcmdev->dev);
+ 	if (data) {
+ 		bcmdev->max_autobaud_speed = data->max_autobaud_speed;
+-		bcmdev->no_early_set_baudrate = data->no_early_set_baudrate;
++		bcmdev->no_early_set_baudrate = data->no_early_set_baudrate && !bcm_force_early_baud;
+ 		bcmdev->drive_rts_on_open = data->drive_rts_on_open;
+ 		bcmdev->no_uart_clock_set = data->no_uart_clock_set;
+ 		if (data->max_speed && bcmdev->oper_speed > data->max_speed)
diff --git a/baseline/arm-imx6ul-u2ac/patches/0008-usb-f_fs-highpri-completion-wq.patch b/baseline/arm-imx6ul-u2ac/patches/0008-usb-f_fs-highpri-completion-wq.patch
new file mode 100644
index 0000000..f57051c
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/patches/0008-usb-f_fs-highpri-completion-wq.patch
@@ -0,0 +1,19 @@
+From: milouk
+Subject: [PATCH] usb: gadget: f_fs: high-priority AIO completion workqueue
+
+The AIO completion worker of FunctionFS runs on an ordered workqueue at nice 0. On the U2AC (one
+Cortex-A7) the Android Auto relay runs at nice -10 and can delay the USB completion that gates its next
+frame. WQ_HIGHPRI runs the completions at nice -20 like brcmfmac and other bus completion paths.
+
+---
+--- a/drivers/usb/gadget/function/f_fs.c	2026-11-26 12:44:36.694478001 +0000
++++ b/drivers/usb/gadget/function/f_fs.c	2026-11-26 12:44:36.697536376 +0000
+@@ -2242,7 +2242,7 @@
+ 	if (!ffs)
+ 		return NULL;
+ 
+-	ffs->io_completion_wq = alloc_ordered_workqueue("%s", 0, dev_name);
++	ffs->io_completion_wq = alloc_ordered_workqueue("%s", WQ_HIGHPRI, dev_name);
+ 	if (!ffs->io_completion_wq) {
+ 		kfree(ffs);
+ 		return NULL;
