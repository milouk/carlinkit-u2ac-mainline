diff --git a/baseline/arm-imx6ul-u2ac/tools-zstd/u2ac-unzstd.c b/baseline/arm-imx6ul-u2ac/tools-zstd/u2ac-unzstd.c
new file mode 100644
index 0000000..466e01e
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/tools-zstd/u2ac-unzstd.c
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * u2ac-unzstd < IN.zst > OUT: zstd decompression only (libzstd's decoder, linked statically by the baseline
+ * build's build_unzstd). The image keeps the executables listed in board.env ZSTD_PACK zstd-packed: the xz
+ * squashfs cost aa-proxy-rs 2.75 s of decoding on the single A7 core at every boot, zstd ~10x less.
+ * u2ac-aa unpacks them into /run/zbin first thing at boot. Exit 0 only for a complete frame.
+ */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "zstd.h"
+
+static int write_all(int fd, const char *p, size_t n)
+{
+    while (n) {
+        ssize_t w = write(fd, p, n);
+        if (w < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        p += w;
+        n -= (size_t)w;
+    }
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    (void)argv;
+    if (argc > 1) {
+        fputs("usage: u2ac-unzstd < IN.zst > OUT\n", stderr);
+        return 2;
+    }
+    size_t isz = ZSTD_DStreamInSize(), osz = ZSTD_DStreamOutSize();
+    char *ib = malloc(isz), *ob = malloc(osz);
+    ZSTD_DCtx *d = ZSTD_createDCtx();
+    if (!ib || !ob || !d) {
+        fputs("u2ac-unzstd: out of memory\n", stderr);
+        return 1;
+    }
+    size_t left = 1; /* ZSTD_decompressStream's return: 0 = a frame ended exactly here */
+    int any = 0;
+    for (;;) {
+        ssize_t r = read(0, ib, isz);
+        if (r < 0) {
+            if (errno == EINTR)
+                continue;
+            perror("u2ac-unzstd: read");
+            return 1;
+        }
+        if (r == 0)
+            break;
+        any = 1;
+        ZSTD_inBuffer in = { ib, (size_t)r, 0 };
+        while (in.pos < in.size) {
+            ZSTD_outBuffer out = { ob, osz, 0 };
+            left = ZSTD_decompressStream(d, &out, &in);
+            if (ZSTD_isError(left)) {
+                fprintf(stderr, "u2ac-unzstd: %s\n", ZSTD_getErrorName(left));
+                return 1;
+            }
+            if (write_all(1, ob, out.pos)) {
+                perror("u2ac-unzstd: write");
+                return 1;
+            }
+        }
+    }
+    /* input consumed: flush what the decoder still holds */
+    while (any && left != 0) {
+        ZSTD_inBuffer in = { ib, 0, 0 };
+        ZSTD_outBuffer out = { ob, osz, 0 };
+        left = ZSTD_decompressStream(d, &out, &in);
+        if (ZSTD_isError(left)) {
+            fprintf(stderr, "u2ac-unzstd: %s\n", ZSTD_getErrorName(left));
+            return 1;
+        }
+        if (out.pos == 0)
+            break;
+        if (write_all(1, ob, out.pos)) {
+            perror("u2ac-unzstd: write");
+            return 1;
+        }
+    }
+    if (!any || left != 0) {
+        fputs("u2ac-unzstd: truncated or empty input\n", stderr);
+        return 1;
+    }
+    ZSTD_freeDCtx(d);
+    return 0;
+}
