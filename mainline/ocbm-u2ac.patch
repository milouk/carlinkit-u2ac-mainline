+            else
+                echo "persist: $WHERE holds no complete persist archive (erased, cut short by a power loss, or another system's data): nothing loaded"
+            fi
+            rm -rf "$P.load"
         fi
         seed_shadow
         exit $rc
@@ -74,6 +88,10 @@ case ${1:-} in
     save)
         [ -n "$REC" ] && { echo "persist: recovery never writes the customer MTD" >&2; exit 1; }
