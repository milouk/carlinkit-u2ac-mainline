index 0000000..1b8581f
--- /dev/null
+++ b/baseline/arm-imx6ul-u2ac/rootfs/usr/share/u2ac/www/cgi-bin/logs
@@ -0,0 +1,34 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# GET /cgi-bin/logs?src=aa|svc|hostapd|bt|web|dmesg&n=200 -> {"ok","src","file","lines":[...]}
+# The last n lines (20..500, default 200), ANSI colour codes and control characters stripped.
+_d=${0%/*}; [ "$_d" = "$0" ] && _d=.
+. "$_d/_lib.sh"
+
+qfield src; SRC=$FV
+qfield n; N=$FV
+case $N in '' | *[!0-9]*) N=200 ;; esac
+[ "$N" -lt 20 ] && N=20
+[ "$N" -gt 500 ] && N=500
+
+case $SRC in
+    svc) F=$SVCLOG ;;
+    hostapd) F=$HAPLOG ;;
+    bt) F=$BTLOG ;;
+    web) F=$WEBLOG ;;
+    dmesg) F=dmesg ;;
+    flight) F=flight ;;
+    *) SRC=aa F=$AALOG ;;
+esac
+
+hdr
+{
+    if [ "$SRC" = dmesg ]; then dmesg 2> /dev/null | tail -n "$N"
+    elif [ "$SRC" = flight ]; then
+        # the list, then the newest car run from its top (status, service log, then aa-proxy-rs's)
+        { u2ac-aa flightlog; echo; u2ac-aa flightlog last; } 2> /dev/null | head -n "$N"
+    else tail -n "$N" "$F" 2> /dev/null; fi
+} | awk -v src="$SRC" -v f="${F#"$R"}" "$AWKLIB"'
+BEGIN { printf "{\"ok\":true,\"src\":\"%s\",\"file\":%s,\"lines\":[", src, js(f) }
+{ l = noansi($0); sub(/\r$/, "", l); sub(/^ +/, "", l); if (length(l) > 600) l = substr(l, 1, 600) "..."; printf "%s%s", (NR > 1 ? "," : ""), js(l) }
+END { print "]}" }'
