+$("#aap").textContent = "ssh -L 8080:127.0.0.1:8080 root@" + location.hostname;
+
+/* ---------- tabs ---------- */
+function showTab(t){
+  tab = t;
+  $$("nav button").forEach(b => b.dataset.tab === t ? b.setAttribute("aria-current", "page") : b.removeAttribute("aria-current"));
+  $$("main, section").forEach(s => s.hidden = s.id !== "t-" + t);
+  if (location.hash.slice(1) !== t) history.replaceState(null, "", t === "status" ? location.pathname : "#" + t);
+  if (t === "status") poll(); else clearTimeout(timer);
+  if (t === "logs") loadLog();
+  if (t === "set") loadSettings();
+  if (t === "about") loadAbout();
+  window.scrollTo(0, 0);
+}
+$$("nav button").forEach(b => b.onclick = () => showTab(b.dataset.tab));
+$$("#srcs button").forEach(b => b.onclick = () => { src = b.dataset.src; $$("#srcs button").forEach(x => x.setAttribute("aria-pressed", x === b)); loadLog(); });
+$("#lref").onclick = loadLog;
+$("#flt").oninput = drawLog;
+document.addEventListener("visibilitychange", () => { if (!document.hidden && (tab === "status" || rebooting)) poll(); });
+loadToken();
+showTab({logs: 1, set: 1, about: 1}[location.hash.slice(1)] ? location.hash.slice(1) : "status");
+if (tab !== "status") get("status").then(render).catch(() => {});
+</script>
+</body>
+</html>
