+  $$("main, section").forEach(s => s.hidden = s.id !== "t-" + t);
+  if (location.hash.slice(1) !== t) history.replaceState(null, "", t === "status" ? location.pathname : "#" + t);
+  if (t === "status") poll(); else clearTimeout(timer);
