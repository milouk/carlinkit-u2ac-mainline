+.lamp{width:78px;height:78px;border-radius:50%;display:grid;place-items:center;color:var(--c);border:2px solid color-mix(in srgb,var(--c) 55%,transparent);background:radial-gradient(circle,color-mix(in srgb,var(--c) 26%,transparent) 0,transparent 70%);box-shadow:0 0 34px -4px color-mix(in srgb,var(--c) 45%,transparent)}
+.lamp svg{width:44px;height:44px}
+#hero[data-s=waiting] .lamp{animation:breathe 2.4s ease-in-out infinite}
