{
 "uid": "u2ac-drives",
 "title": "Car dongle",
 "tags": [
  "carlinkit",
  "u2ac",
  "android-auto"
 ],
 "description": "Carlinkit U2AC mainline firmware: per-drive health from the flight log, sent by the home upload (Pushgateway job u2ac).",
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 0,
 "schemaVersion": 39,
 "refresh": "",
 "time": {
  "from": "now-90d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "refresh": 1,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Android Auto on screen",
   "description": "Seconds from power-on to the car showing Android Auto, latest drive uploaded.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(u2ac_aa_event_seconds{event=\"proxying\"} and on(log_seq) (u2ac_flightlog_seq == scalar(max(u2ac_flightlog_seq and on(log_seq) u2ac_aa_event_seconds{event=\"proxying\"}))))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 26
       },
       {
        "color": "red",
        "value": 35
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "Phone on the hotspot",
   "description": "Seconds from power-on until the phone reported it joined the dongle's Wi-Fi.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(u2ac_aa_event_seconds{event=\"wifi_joined\"} and on(log_seq) (u2ac_flightlog_seq == scalar(max(u2ac_flightlog_seq and on(log_seq) u2ac_aa_event_seconds{event=\"wifi_joined\"}))))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 18
       },
       {
        "color": "red",
        "value": 25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "Phone called",
   "description": "Seconds from power-on to the dongle's first Bluetooth call to the phone.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(u2ac_aa_event_seconds{event=\"bt_try\"} and on(log_seq) (u2ac_flightlog_seq == scalar(max(u2ac_flightlog_seq and on(log_seq) u2ac_aa_event_seconds{event=\"bt_try\"}))))",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 12
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "Drives",
   "description": "Drives with Android Auto in the selected time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "count(count by (log_seq) (max_over_time(u2ac_flightlog_info{why=\"session+60s\"}[$__range]))) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "Starts without Android Auto",
   "description": "Power-ons where no Android Auto session started within 90 s (for example a phone VPN).",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "count(count by (log_seq) (max_over_time(u2ac_flightlog_info{why=\"start+90s\"}[$__range]))) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "Last upload",
   "description": "When the dongle last sent its drive logs (at the start of a drive near home).",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(push_time_seconds{job=\"u2ac\"}) * 1000",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dateTimeFromNow",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto"
   }
  },
  {
   "type": "barchart",
   "title": "Start-up per drive",
   "description": "Seconds from power-on, per drive (flight-log sequence number).",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "instant": true,
     "range": false,
     "format": "table",
     "expr": "max by (log_seq, event) (max_over_time(u2ac_aa_event_seconds{event=~\"bt_try|wifi_joined|proxying\"}[$__range]))"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "event",
      "rowField": "log_seq",
      "valueField": "Value"
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "log_seq\\event": "Drive",
       "bt_try": "Phone called",
       "wifi_joined": "Phone on hotspot",
       "proxying": "Android Auto on screen"
      },
      "indexByName": {
       "log_seq\\event": 0,
       "bt_try": 1,
       "wifi_joined": 2,
       "proxying": 3
      }
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "Drive",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Drive",
        "desc": false
       }
      ]
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "Drive",
        "destinationType": "string"
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0,
      "axisLabel": "seconds"
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "Drive",
    "orientation": "vertical",
    "groupWidth": 0.75,
    "barWidth": 0.9,
    "showValue": "auto",
    "stacking": "none",
    "xTickLabelRotation": 0,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
  {
   "type": "table",
   "title": "Drives",
   "description": "One row per flight-log slot: session+60s = a drive, start+90s = no Android Auto within 90 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq, why) (max_over_time(u2ac_flightlog_info[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_aa_event_seconds{event=\"proxying\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_aa_event_seconds{event=\"wifi_joined\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_aa_event_seconds{event=\"bt_try\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_wifi_station_connects_total[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_wifi_station_tx_bitrate_bps{role=\"aa_phone\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_soc_temperature_celsius[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "H",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_hfp_guard_connected[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "I",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (log_seq) (max_over_time(u2ac_radio_repairs_total[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "J",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_aa_proxy_restarts_total[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "K",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max by (log_seq) (max_over_time(u2ac_home_upload_seconds[$__range]))",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value #A": true
      },
      "renameByName": {
       "log_seq": "Drive",
       "why": "Log",
       "Value #B": "Android Auto (s)",
       "Value #C": "Phone on hotspot (s)",
       "Value #D": "Phone called (s)",
       "Value #E": "Hotspot joins",
       "Value #F": "Link to phone",
       "Value #G": "Chip",
       "Value #H": "Mic guard up",
       "Value #I": "Radio repairs",
       "Value #J": "Relay restarts",
       "Value #K": "Upload (s)"
      },
      "indexByName": {
       "log_seq": 0,
       "why": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "Value #E": 5,
       "Value #F": 6,
       "Value #G": 7,
       "Value #H": 8,
       "Value #I": 9,
       "Value #J": 10,
       "Value #K": 11
      }
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "Drive",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Drive",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Android Auto (s)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Phone on hotspot (s)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Phone called (s)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Hotspot joins"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Link to phone"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bps"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
