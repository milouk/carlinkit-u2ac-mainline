       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Mic guard up"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Radio repairs"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Relay restarts"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upload (s)"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  }
 ]
