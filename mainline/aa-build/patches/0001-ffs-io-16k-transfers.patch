+/// U2AC: USB transfer size for the FunctionFS bulk pipes. Splitting every write into
+/// max-packet (512 B) transfers costs one AIO submit + one UDC interrupt per 512 B of video;
+/// the usb-gadget crate recommends ~16 KiB transfers. Rounded to a multiple of the endpoint
+/// max packet size; `AA_FFS_CHUNK=512` restores the old behaviour without a rebuild.
+fn transfer_size(max_packet_size: usize) -> usize {
+    let want = std::env::var("AA_FFS_CHUNK")
+        .ok()
+        .and_then(|v| v.parse::<usize>().ok())
+        .unwrap_or(16384);
+    let mps = max_packet_size.max(1);
+    (want.max(mps) / mps) * mps
+}
